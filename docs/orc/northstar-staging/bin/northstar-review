#!/usr/bin/env bash
# /opt/northstar/bin/northstar-review —— 对齐评审的唯一入口
# 提交前的 hook（hooks/align.sh）和 orc 的 commit broker 都调用它，输入相同：
#   NORTHSTAR（方向 + 少数关键设计约束 N#）、签名的设计文件、本节点条目（声明文件、验收标准、条款）、diff，可选检查结果
# 用法：<diff> | northstar-review --entry <节点条目或 mission 文件> [--design <签名的设计文件>]... \
#         [--checks <检查结果文件>] [--prev <上次偏离原因>] \
#         ( --role review|review_light|auto  |  --reviewer claude|codex [--model <模型>] )
# --role 从 /opt/northstar/models.toml（install.sh 从 orc/config/models.toml 复制）取 cli 和模型；
#   auto：上一次被判 DRIFT（有 --prev）或改动超过 [review] deep_review_over_lines 行时用 review，否则用 review_light
# 退出码：0 ALIGNED；1 DRIFT（stdout 是评审原文：DRIFT / 违反项 / 证据）；2 不能评审（stderr 写明原因和该怎么做）
MAXC=60000                                # 评审输入里 diff 的上限（字节）；超过就拒绝，不截断
NSF=.northstar/NORTHSTAR.md
MODELS=/opt/northstar/models.toml
entry=; designs=(); checks=; prev=; reviewer=; model=; role=
while [ $# -gt 0 ]; do
  case "$1" in
    --entry) entry="$2" ;; --design) designs+=("$2") ;; --checks) checks="$2" ;;
    --prev) prev="$2" ;; --reviewer) reviewer="$2" ;; --model) model="$2" ;; --role) role="$2" ;;
    *) echo "northstar-review：未知参数 $1" >&2; exit 2 ;;
  esac
  shift 2
done
case "$role" in ""|review|review_light|auto) ;; *) echo "northstar-review：--role 只能是 review、review_light 或 auto" >&2; exit 2 ;; esac
if [ -n "$role" ] && [ ! -f "$MODELS" ]; then
  echo "NORTHSTAR：缺少模型配置 $MODELS → 让用户重新运行 install.sh（sudo bash docs/orc/northstar-staging/install.sh）。" >&2; exit 2
fi
# 从 models.toml 读一个角色：输出「cli 模型 deep_review_over_lines」（Python 3.11+ 用 tomllib，更老的用最小解析器）
read_role() { python3 - "$MODELS" "$1" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
try:
    import tomllib
    data = tomllib.loads(text)
except ModuleNotFoundError:
    data, sec = {}, None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.fullmatch(r"\[([A-Za-z0-9_-]+)\]\s*(#.*)?", line)
        if m:
            sec = m.group(1); data.setdefault(sec, {}); continue
        m = re.fullmatch(r'([A-Za-z0-9_-]+)\s*=\s*"([^"]*)"\s*(#.*)?', line)
        if m and sec:
            data[sec][m.group(1)] = m.group(2)
r = data.get(sys.argv[2], {})
print(r.get("cli", "-"), r.get("model", "-"), data.get("review", {}).get("deep_review_over_lines", "-"))
PY
}
[ -f "$NSF" ] || { echo "northstar-review：缺少 $NSF" >&2; exit 2; }
[ -f "$entry" ] || { echo "northstar-review：缺少节点条目 --entry $entry" >&2; exit 2; }
for f in ${designs[@]+"${designs[@]}"} ${checks:+"$checks"}; do
  [ -f "$f" ] || { echo "northstar-review：缺少 $f" >&2; exit 2; }
done

diff=$(cat)
n=$(printf '%s' "$diff" | wc -c | tr -d ' ')
[ "$n" -le "$MAXC" ] || {
  echo "NORTHSTAR：这次的改动有 $n 字节，超过评审上限 $MAXC。评审不截断：按验收标准拆成更小的提交。" >&2; exit 2; }

if [ -n "$role" ]; then
  if [ "$role" = auto ]; then
    read -r _ _ deep < <(read_role review)
    lines=$(grep -E '^[+-]' <<<"$diff" | grep -cvE '^(\+\+\+|---) ')
    if [ -n "$prev" ] || { [[ "$deep" =~ ^[0-9]+$ ]] && [ "$lines" -gt "$deep" ]; }; then role=review; else role=review_light; fi
  fi
  read -r reviewer model _ < <(read_role "$role")
  [ "$reviewer" != - ] && [ "$model" != - ] || {
    echo "NORTHSTAR：$MODELS 里没有完整的 [$role]（cli、model）→ 修正 orc/config/models.toml 后让用户重新运行 install.sh。" >&2; exit 2; }
fi
case "$reviewer" in
  # 评审只读材料、下结论：关掉全部工具（--tools ""）。实测（2026-11-07）：不关的话，评审会话结束时被 Stop hook
  # 以「还有未提交的改动」拦下（评审时改动本来就还没提交），它就开始跑命令，循环了两百多次
  claude) cmd=(claude -p --tools ""); [ -n "$model" ] && cmd+=(--model "$model") ;;
  codex)  cmd=(codex exec --sandbox read-only); [ -n "$model" ] && cmd+=(-m "$model") ;;
  *) echo "northstar-review：--reviewer 只能是 claude 或 codex" >&2; exit 2 ;;
esac

prompt="=== NORTHSTAR（方向，以及少数关键设计约束 N#）===
$(cat "$NSF")"
for f in ${designs[@]+"${designs[@]}"}; do
  prompt="$prompt

=== 签名的设计：$(basename "$f") ===
$(cat "$f")"
done
prompt="$prompt

=== 本节点条目（声明的文件、验收标准、对应条款）===
$(cat "$entry")"
[ -n "$checks" ] && prompt="$prompt

=== 已运行的检查结果 ===
$(cat "$checks")"
prompt="$prompt

=== 待提交的改动 ===
$diff

你是独立评审，只依据上面的材料判断，回答两个问题：
1. 方向：这些改动是否在推进本节点的验收标准，且没有违反 NORTHSTAR 的任何条款、非目标或停止条件？
2. 做法：实现方式是否照签名的设计？（没有设计文件时只回答第 1 问）
任一项不符就判 DRIFT。${prev:+上一次被判定偏离的原因是：$prev。请特别确认它已经消除。}
第一行只输出 ALIGNED 或 DRIFT。若 DRIFT，第二行写违反的是哪条 N# 或设计的哪一节，以及原因；第三行写涉及的文件和行号。"

# claude 评审在一个空的临时目录里运行，不在仓库里（proposals/2026-11-07-reviewer-stop-hook.md）：
# 它需要的材料都在提示词里；在仓库里运行时，评审时改动还没提交，Stop hook 会一直不让它结束。
# 不在有 .northstar/ 的仓库里，Stop hook 第一行就放行，hook 本身不用改。codex exec 要求在 git 仓库里运行，保持原样
rundir=.
if [ "$reviewer" = claude ]; then
  rundir=$(mktemp -d "${TMPDIR:-/tmp}/northstar-review.XXXXXX") || { echo "northstar-review：建不了临时目录" >&2; exit 2; }
fi
out=$(cd "$rundir" && "${cmd[@]}" "$prompt" 2>/dev/null)
[ "$rundir" = . ] || rmdir "$rundir" 2>/dev/null || true
v=$(grep -m1 -oE '^(ALIGNED|DRIFT)' <<<"$out")
[ -n "$v" ] || { echo "NORTHSTAR：对齐评审没有返回结果。稍后重试提交；持续失败就停止并告诉用户。" >&2; exit 2; }
printf '%s\n' "$out"
[ "$v" = ALIGNED ]
