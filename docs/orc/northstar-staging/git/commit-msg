#!/usr/bin/env bash
# /opt/northstar/git/commit-msg
# 项目自己的 commit-msg 在公共 git 目录里；worktree 里 .git 是文件，不能写死 .git/hooks
PH="$(git rev-parse --git-common-dir)/hooks/commit-msg"
[ -d .northstar ] || { [ -x "$PH" ] && exec "$PH" "$1"; exit 0; }
if ! head -1 "$1" | grep -qE '^\[(N[0-9]+(,N[0-9]+)*|NS)\]'; then
  echo "commit 首行必须以 [N#] 开头（如 [N2] ...）；North Star 自身变更用 [NS]" >&2; exit 1
fi
[ -x "$PH" ] && exec "$PH" "$1"   # 保留项目自己的 hook
exit 0
