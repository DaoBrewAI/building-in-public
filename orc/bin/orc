#!/usr/bin/env python3
"""orc —— 新 workflow 的机械流程。判断留给 coordinator，流程全部在这里。

  orc step --new "<请求>" [--repo <产品仓库>] [--name <mission 名>]
  orc step --mission <mission>
  orc answer [--mission <mission>] [--file <问题文件>] "<回答>"
  orc status [--mission <mission>]
  orc doctor [--live]

状态模型见 docs/orc/STATE.md。每次 step 最后一行打印 `next: …`。
"""
from __future__ import annotations

import argparse
import datetime as _dt
import hashlib
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Callable, Dict, List, Optional, Tuple

ORC_ROOT = Path(__file__).resolve().parents[1]
SCRIPTS = ORC_ROOT / "scripts"
MODELS_TOML = Path(os.environ.get("ORC_MODELS_TOML", ORC_ROOT / "config" / "models.toml"))
NAME_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,63}\Z")

MISSION_STATES = ["new", "planning", "verifying", "plan-review", "approved", "executing",
                  "reviewing", "accepted", "cleaned", "blocked", "failed"]
TERMINAL = {"cleaned", "failed"}
FORWARD = {  # 合法的状态转换（STATE.md「mission 状态」）
    "new": {"planning"},
    "planning": {"verifying"},
    "verifying": {"plan-review"},
    "plan-review": {"approved", "planning"},
    "approved": {"executing"},
    "executing": {"reviewing"},
    "reviewing": {"accepted", "executing"},
    "accepted": {"cleaned"},
}
INTEGRATED_SCRIPT_STATES = {"integrated", "cleanup_pending", "collected"}
ROLES = ("implement", "plan", "review", "review_light")   # 见 orc/config/models.toml


class OrcError(Exception):
    """可以直接告诉 coordinator 的错误：消息里写明错在哪、该怎么做。"""


APPROVED_STATES = {"approved", "executing", "reviewing", "accepted"}   # 每次 step 都重新校验签名和哈希


def illegal_transition(ctx: dict, to: str, event: dict) -> Optional[str]:
    """回放日志和写新事件共用的合法性判断。合法返回 None，否则返回原因。"""
    current = ctx["state"]
    if current in TERMINAL:
        return f"{current} 是终态"
    if to in FORWARD.get(current, set()) or to == "failed":
        return None
    if to == "blocked":
        if current == "blocked":
            return "已经在 blocked"
        if not event.get("question"):
            return "进入 blocked 必须带一个问题"
        return None
    if current == "blocked":
        if to != ctx["blocked_from"]:
            return f"blocked 只能回到进入前的 {ctx['blocked_from']}"
        if ctx["question"] not in ctx["answered"]:
            return f"问题 {ctx['question']} 还没有回答"
        return None
    return "状态表里没有这条转换"


# ---------------------------------------------------------------- 小工具

def now() -> str:
    return _dt.datetime.now().astimezone().isoformat(timespec="seconds")


def orc_home() -> Path:
    return Path(os.environ.get("ORC_HOME", Path.home() / ".orc")).expanduser()


def worktrees_root() -> Path:
    """节点 worktree 的根目录（默认 ~/.orc-worktrees）。不能在 $ORC_HOME 下：
    guard 拦截 agent 对 $ORC_HOME 的一切写入，worktree 放在那里节点就写不了代码；guard 也不给任何路径开例外。"""
    root = Path(os.environ.get("ORC_WORKTREES", Path.home() / ".orc-worktrees")).expanduser()
    r, h = os.path.realpath(root), os.path.realpath(orc_home())
    if r == h or r.startswith(h + os.sep):
        raise OrcError(f"节点 worktree 目录 {root} 不能放在 $ORC_HOME（{orc_home()}）下：guard 会拦住节点里的所有写入。"
                       "把 ORC_WORKTREES 改到 $ORC_HOME 之外（默认 ~/.orc-worktrees）。")
    return root


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def load_lock_module():
    spec = importlib.util.spec_from_file_location(
        "coordinator_lifecycle_lock", SCRIPTS / "coordinator_lifecycle_lock.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)  # type: ignore[union-attr]
    return module


# ---------------------------------------------------------------- models.toml

def parse_toml(text: str) -> Dict[str, Dict[str, str]]:
    """Python 3.11+ 用 tomllib；更老的 Python 用这个只认「[段] + key = "字符串"」的最小解析器。"""
    try:
        import tomllib  # type: ignore[import-not-found]
    except ModuleNotFoundError:
        return parse_toml_minimal(text)
    return tomllib.loads(text)


def parse_toml_minimal(text: str) -> Dict[str, Dict[str, str]]:
    data: Dict[str, Dict[str, str]] = {}
    section: Optional[str] = None
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = re.fullmatch(r"\[([A-Za-z0-9_-]+)\]\s*(#.*)?", line)
        if m:
            section = m.group(1)
            data.setdefault(section, {})
            continue
        m = re.fullmatch(r'([A-Za-z0-9_-]+)\s*=\s*"([^"]*)"\s*(#.*)?', line)
        if m and section is not None:
            data[section][m.group(1)] = m.group(2)
            continue
        raise OrcError(f"models.toml 第 {n} 行看不懂：{raw.strip()}。只支持 [角色] 段和 key = \"字符串\"。")
    return data


def resolve_models(path: Path = MODELS_TOML) -> dict:
    if not path.is_file():
        raise OrcError(f"找不到模型配置 {path}。把 orc/config/models.toml 放回原位再运行。")
    raw = path.read_bytes()
    try:
        data = parse_toml(raw.decode("utf-8"))
    except OrcError:
        raise
    except Exception as error:  # tomllib 的解析错误
        raise OrcError(f"models.toml 解析失败：{error}。按文件里的注释修正格式。") from error
    roles = {}
    for role in ROLES:
        section = data.get(role)
        if not isinstance(section, dict):
            raise OrcError(f"models.toml 缺少 [{role}] 段。照模板补上这个角色。")
        missing = [k for k in ("cli", "model", "effort") if not section.get(k)]
        if missing:
            raise OrcError(f"models.toml 的 [{role}] 缺少 {', '.join(missing)}。")
        if section["cli"] not in ("claude", "codex"):
            raise OrcError(f"models.toml 的 [{role}] 写的 cli 是「{section['cli']}」：cli 只能是 claude 或 codex。")
        roles[role] = {k: str(v) for k, v in section.items()}
    implement, review = roles["implement"]["model"], roles["review"]
    # 重要的评审要独立：不能由写代码的同一个模型来审，也不能在不可用时降级成它
    if review["model"] == implement:
        raise OrcError(f"models.toml 里 [review] 和 [implement] 都是 {implement}：重要的评审不能用 implement 的模型（等于自己审自己）。给 review 换一个更强的模型。")
    if review.get("fallback") == implement:
        raise OrcError(f"models.toml 的 [review] fallback 是 {implement}：重要的评审不能降级成 implement 的模型。删掉 fallback，不可用时 orc 会停下来问你。")
    threshold = review.get("deep_review_over_lines", "")
    if not threshold.isdigit() or int(threshold) <= 0:
        raise OrcError(f"models.toml 的 [review] deep_review_over_lines 必须是正整数（写成带引号的字符串，例如 \"300\"），现在是「{threshold}」。")
    return {"source": str(path), "sha256": hashlib.sha256(raw).hexdigest(),
            "resolved_at": now(), "roles": roles}


def review_role(stage: str, diff_lines: int, prior_drift: bool, threshold: int) -> str:
    """评审分级（流程交给代码）：重要、复杂的用 review，其余用 review_light。
    node = 节点进入 submitted 时的整体评审；final = 最终审查；commit = 每次提交前的对齐评审。"""
    if stage in ("node", "final"):
        return "review"
    if stage != "commit":
        raise OrcError(f"不认识的评审阶段 {stage}。这是 orc 的 bug。")
    if prior_drift or diff_lines > threshold:
        return "review"
    return "review_light"


# ---------------------------------------------------------------- mission

class Mission:
    def __init__(self, name: str):
        if not NAME_RE.match(name):
            raise OrcError(f"mission 名「{name}」不合法：只能用小写字母、数字和 -，以字母或数字开头，最长 64 个字符。")
        self.name = name
        self.dir = orc_home() / "missions" / name
        self.control = self.dir / "control"
        self.events_path = self.dir / "events.jsonl"
        self.state_path = self.dir / "state"
        self._lock_fd: Optional[int] = None
        self._lock_module = None

    def exists(self) -> bool:
        return self.events_path.is_file()

    def worktree(self, node: str) -> Path:
        return worktrees_root() / self.name / node

    # 规划会话和发布站点的工作目录也在 $ORC_HOME 之外：agent（规划会话、codex）要写它们，guard 不让写 $ORC_HOME
    def plan_work(self) -> Path:
        return worktrees_root() / self.name / "plan-work"

    def verify_work(self) -> Path:
        return worktrees_root() / self.name / "verify-work"

    def site_dir(self) -> Path:
        return worktrees_root() / self.name / "site"

    def repo(self) -> Path:
        return Path((self.dir / "repo").read_text().strip())

    def roles(self) -> dict:
        return json.loads((self.dir / "models.json").read_text())["roles"]

    def frozen(self) -> bool:
        return (self.control / "approved-task-dag.json").is_file()

    # -- 锁：和 commit broker、integrate-task 共用 control/ 下的生命周期锁
    def __enter__(self) -> "Mission":
        if not self.exists():
            raise OrcError(f"没有名为「{self.name}」的 mission。用 orc status 看现有的 mission，或用 orc step --new \"<请求>\" 新建。")
        self._lock_module = load_lock_module()
        control = Path(os.path.realpath(self.control))
        try:
            self._lock_fd = self._lock_module.acquire_lifecycle_lock(control)
        except self._lock_module.LifecycleLockError as error:
            raise OrcError(f"拿不到 mission 的生命周期锁（{error}）。检查 {self.control} 是否被改成了符号链接或权限过宽。") from error
        self.reconcile()
        return self

    def __exit__(self, *exc) -> None:
        if self._lock_fd is not None:
            self._lock_module.release_lifecycle_lock(self._lock_fd)
            self._lock_fd = None

    # -- 事件日志：状态的唯一来源
    def numbered_events(self) -> List[Tuple[int, dict]]:
        out = []
        if self.events_path.is_file():
            for n, line in enumerate(self.events_path.read_text(encoding="utf-8").splitlines(), 1):
                if not line.strip():
                    continue
                try:
                    out.append((n, json.loads(line)))
                except json.JSONDecodeError as error:
                    raise OrcError(f"{self.events_path} 第 {n} 行不是合法 JSON（{error}）。这个文件只能追加，不要手改；把那一行恢复原样。") from error
        return out

    def events(self) -> List[dict]:
        return [e for _, e in self.numbered_events()]

    def replay(self) -> dict:
        """逐条回放状态事件：from 必须等于上一状态，转换必须合法（STATE.md）。
        不合法就报错停下，不按它走——日志在 agent 可写的目录里，被追加伪造的事件时要能发现。"""
        ctx = {"state": "new", "blocked_from": None, "question": None, "qtype": None, "answered": set()}
        for n, e in self.numbered_events():
            kind = e.get("kind")
            if kind == "answer":
                ctx["answered"].add(e.get("id"))
            if kind != "state":
                continue
            frm, to = e.get("from"), e.get("to")
            where = f"{self.events_path} 第 {n} 行"
            if frm != ctx["state"]:
                raise OrcError(f"{where}：状态事件写的是从 {frm} 转到 {to}，但当时的状态是 {ctx['state']}。"
                               "日志被改过或写坏了，orc 不按它走；停下来告诉用户。")
            problem = illegal_transition(ctx, to, e)
            if problem:
                raise OrcError(f"{where}：{frm} → {to} 不是合法的状态转换（{problem}）。"
                               "日志被改过或写坏了，orc 不按它走；停下来告诉用户。")
            if to == "blocked":
                ctx.update(blocked_from=frm, question=e["question"], qtype=e.get("type", "ask-user"))
            elif frm == "blocked":
                ctx.update(blocked_from=None, question=None, qtype=None)
            ctx["state"] = to
        return ctx

    def append(self, kind: str, by: str, **fields) -> dict:
        event = {"ts": now(), "mission": self.name, "kind": kind, "by": by, **fields}
        with open(self.events_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
            f.flush()
            os.fsync(f.fileno())
        return event

    def state_from_events(self) -> str:
        return self.replay()["state"]

    def reconcile(self) -> str:
        """state 文件只是缓存：和日志不一致时（比如中断在写日志和写 state 之间）按日志补齐。"""
        state = self.state_from_events()
        cached = self.state_path.read_text().strip() if self.state_path.is_file() else None
        if cached != state:
            write_atomic(self.state_path, state + "\n")
        return state

    @property
    def state(self) -> str:
        return self.state_from_events()

    def transition(self, to: str, by: str, reason: Optional[str] = None, **extra) -> None:
        if to == "blocked" and "question" not in extra:
            raise OrcError("进入 blocked 必须同时给用户一个问题：用 block()，不要直接 transition 到 blocked。这是 orc 的 bug。")
        ctx = self.replay()
        current = ctx["state"]
        fields = {"from": current, "to": to, **extra}
        if reason:
            fields["reason"] = reason
        problem = illegal_transition(ctx, to, fields)
        if problem:
            raise OrcError(f"不允许从 {current} 转到 {to}（{problem}；见 docs/orc/STATE.md 的状态表）。这是 orc 的 bug，不要手改状态；把这条消息告诉用户。")
        self.append("state", by, **fields)       # 先写日志
        write_atomic(self.state_path, to + "\n")  # 再更新缓存；中断在中间时下次 reconcile 补齐

    def block(self, reason: str, question: str, qtype: str, by: str) -> Path:
        """进入 blocked 的唯一入口：问题和状态一起写。离开 blocked 需要这个问题的 answer 事件。"""
        if qtype not in ("ask-user", "mediate"):
            raise OrcError(f"问题类型只能是 ask-user 或 mediate，不是 {qtype}。这是 orc 的 bug。")
        path = self.ask(question, qtype, by)
        self.transition("blocked", by, reason=reason, question=path.stem, type=qtype)
        return path

    def blocked_from(self) -> Optional[str]:
        return self.replay()["blocked_from"]

    # -- 问答
    def open_questions(self) -> List[Path]:
        qdir, adir = self.dir / "questions", self.dir / "answers"
        if not qdir.is_dir():
            return []
        return sorted(q for q in qdir.glob("*.md") if not (adir / q.name).exists())

    def ask(self, text: str, kind: str, by: str) -> Path:
        qdir = self.dir / "questions"
        qdir.mkdir(exist_ok=True)
        n = len(list(qdir.glob("*.md"))) + 1
        path = qdir / f"{n:03d}.md"
        write_atomic(path, text.rstrip() + "\n")
        self.append("ask", by, id=path.stem, type=kind, file=str(path))
        return path

    # -- 节点状态：从复用脚本的协议文件推出来，不单独存（STATE.md「节点状态」）
    def node_states(self) -> Dict[str, str]:
        dag = self.control / "approved-task-dag.json"
        if not dag.is_file():
            return {}
        try:
            ids = [t["id"] for t in json.loads(dag.read_text())["tasks"]]
        except (ValueError, KeyError, TypeError) as error:
            raise OrcError(f"{dag} 读不出节点列表（{error}）。冻结文件被改坏了，停下来告诉用户。") from error
        return {node: self.node_state(node) for node in ids}

    def node_state(self, node: str) -> str:
        ctl, work = self.control / "tasks" / node, self.dir / "nodes" / node
        if not ctl.is_dir():
            return "pending"
        read = lambda p: p.read_text().strip() if p.is_file() else ""
        if (ctl / "blocked").exists():
            return "blocked"
        if (ctl / "unresolved-rework").exists():
            return "rework"
        if read(ctl / "state") in INTEGRATED_SCRIPT_STATES:
            return "integrated"
        if read(work / "state") == "completed":
            return "submitted"
        return "running"


def create_mission(request: str, repo: Optional[str], name: Optional[str]) -> Mission:
    if not request.strip():
        raise OrcError("请求是空的。用 orc step --new \"<用户的原话>\" 新建 mission。")
    repo_path = Path(repo or os.getcwd()).expanduser()
    top = subprocess.run(["git", "-C", str(repo_path), "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    if top.returncode != 0:
        raise OrcError(f"{repo_path} 不是 git 仓库。在产品仓库里运行，或用 --repo <产品仓库路径> 指定。")
    repo_real = os.path.realpath(top.stdout.strip())
    models = resolve_models()
    if name is None:
        words = re.findall(r"[a-z0-9]+", request.lower())
        slug = "-".join(words[:4])[:40].strip("-") or "mission"
        name = f"{_dt.datetime.now():%Y%m%d-%H%M%S}-{slug}"
    mission = Mission(name)
    if mission.exists():
        raise OrcError(f"mission「{name}」已经存在。继续它用 orc step --mission {name}；新建就换一个 --name。")
    if mission.dir.exists():
        # 上一次新建在写 events.jsonl 之前中断：这是 orc 自己留下的半成品，没有任何事件，直接接管
        shutil.rmtree(mission.dir)
        print(f"接管上次没建完的 mission 目录 {mission.dir}（里面还没有 events.jsonl）")
    try:
        for sub in ("", "control", "control/tasks", "nodes", "questions", "answers", "plan"):
            (mission.dir / sub).mkdir(parents=True, exist_ok=sub != "")
        write_atomic(mission.dir / "request.md", request.rstrip() + "\n")
        write_atomic(mission.dir / "repo", repo_real + "\n")
        models_text = json.dumps(models, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
        write_atomic(mission.dir / "models.json", models_text)
        mission.append("created", "orc step", request=request, repo=repo_real,
                       models=hashlib.sha256(models_text.encode()).hexdigest())
    except BaseException:
        if not mission.exists():          # 还没写进 events.jsonl：清掉，免得留下不能 step 也不能重建的目录
            shutil.rmtree(mission.dir, ignore_errors=True)
        raise
    write_atomic(mission.state_path, "new\n")
    return mission


# ---------------------------------------------------------------- step：每个状态的一段机械流程

Next = str
Handler = Callable[[Mission], Tuple[Optional[Next], bool]]   # (next 行, 是否继续执行下一个状态)


def h_new(m: Mission):
    m.transition("planning", "orc step")
    print(f"mission {m.name}：new → planning")
    return None, True


# ---------------------------------------------------------------- 规划会话（阶段 3，STATE.md「规划与 go」）

PLAN_FILES = ("design.md", "plan.md", "task-dag.json")
MAX_REPAIRS = 2                     # 产出校验不通过时，发回同一个会话自动修的次数
CLAUSE_RE = re.compile(r"N[0-9]+\Z")
CHECK_ID_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,63}\Z")
CHECK_TIMEOUT = 300             # 每个检查最多运行的秒数


# 两种后台会话共用一套机制（启动、等待、提问、自动修、交给 coordinator 裁决）：
#   规划会话 planner：plan 角色，产出设计、计划、DAG
#   验证会话 verifier：review 角色（和执行用的模型不同），在实现之前写测试和 checks.json，看不到规划过程
AGENTS = {
    "planner": {"role": "plan", "env": "plan", "label": "规划会话",
                "outputs": "全部产出文件（design.md、plan.md、task-dag.json）"},
    "verifier": {"role": "review", "env": "verify", "label": "验证会话",
                 "outputs": "全部测试文件和 checks.json"},
}


def agent_work(m: Mission, kind: str) -> Path:
    return m.plan_work() if kind == "planner" else m.verify_work()


def verify_cycle(m: Mission) -> int:
    """第几轮验证：每次规划产出通过校验（planning → verifying）就开新的一轮，验证会话从头写。"""
    return sum(1 for e in m.events()
               if e.get("kind") == "state" and e.get("from") == "planning" and e.get("to") == "verifying")


def agent_starts(m: Mission, kind: str, current: bool = True) -> List[dict]:
    starts = [e for e in m.events() if e.get("kind") == f"{kind}-start"]
    if kind == "verifier" and current:
        cycle = verify_cycle(m)
        starts = [s for s in starts if s.get("cycle") == cycle]
    return starts


def agent_exits(m: Mission, kind: str) -> Dict[int, dict]:
    return {e["run"]: e for e in m.events() if e.get("kind") == f"{kind}-exit"}


def planner_starts(m: Mission) -> List[dict]:
    return agent_starts(m, "planner")


def planner_exits(m: Mission) -> Dict[int, dict]:
    return agent_exits(m, "planner")


def process_alive(pid: int, marker: str) -> bool:
    """拿不准就当它还活着（REUSE.md：任何不确定的进程状态都当作还活着，绝不重复启动）。"""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    ps = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True)
    if ps.returncode != 0 and not ps.stdout.strip():
        return False
    return marker in ps.stdout or not ps.stdout.strip()


def planner_prompt(m: Mission, work: Path) -> str:
    text = (ORC_ROOT / "templates" / "planner-brief.md").read_text(encoding="utf-8")
    ns = m.repo() / ".northstar" / "NORTHSTAR.md"
    if ns.is_file():
        block = f"- 产品的 NORTHSTAR（已签名；节点的 `clauses` 引用这里的 N#）：\n\n```\n{ns.read_text(encoding='utf-8').strip()}\n```\n"
        rule = "，不能为空"
    else:
        block = "- 产品仓库还没有 NORTHSTAR。\n"
        rule = "；产品仓库没有 NORTHSTAR，可以是空数组"
    for key, value in (("{{REQUEST}}", (m.dir / "request.md").read_text(encoding="utf-8").strip()),
                       ("{{REPO}}", str(m.repo())), ("{{WORK}}", str(work)), ("{{MISSION}}", m.name),
                       ("{{NORTHSTAR_BLOCK}}", block), ("{{CLAUSES_RULE}}", rule)):
        text = text.replace(key, value)
    return text


def verifier_prompt(m: Mission, work: Path) -> str:
    text = (ORC_ROOT / "templates" / "verifier-brief.md").read_text(encoding="utf-8")
    feedback = [e["text"] for e in m.events() if e.get("kind") == "feedback"]
    block = ("- 用户审阅计划时提过的意见（写测试时也要照顾到）：\n" + "".join(f"  - {t}\n" for t in feedback)) if feedback else ""
    for key, value in (("{{REQUEST}}", (m.dir / "request.md").read_text(encoding="utf-8").strip()),
                       ("{{REPO}}", str(m.repo())), ("{{WORK}}", str(work)), ("{{MISSION}}", m.name),
                       ("{{FEEDBACK_BLOCK}}", block)):
        text = text.replace(key, value)
    return text


def snapshot_repo(m: Mission, dest: Path) -> str:
    """把产品仓库当前提交（HEAD）导出成一份没有 .git 的副本，返回提交号。"""
    repo = str(m.repo())
    head = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"], capture_output=True, text=True)
    if head.returncode != 0:
        raise OrcError(f"产品仓库 {repo} 读不到当前提交（{head.stderr.strip()}）。先在产品仓库里至少提交一次，再运行 orc step。")
    base = head.stdout.strip()
    dest.mkdir(parents=True, exist_ok=True)
    archive = subprocess.Popen(["git", "-C", repo, "archive", "--format=tar", base], stdout=subprocess.PIPE)
    untar = subprocess.run(["tar", "-x", "-C", str(dest)], stdin=archive.stdout, capture_output=True, text=True)
    archive.stdout.close()
    if archive.wait() != 0 or untar.returncode != 0:
        raise OrcError(f"导出产品仓库 {repo} 的提交 {base[:12]} 失败（{untar.stderr.strip()}）。")
    return base


def prepare_verify_work(m: Mission) -> None:
    """新一轮验证：清空验证工作目录（保留运行记录），放入设计、DAG 和当前代码的副本。不给计划和规划过程。"""
    work = m.verify_work()
    work.mkdir(parents=True, exist_ok=True)
    for child in work.iterdir():
        if child.name == ".runs":
            continue
        shutil.rmtree(child) if child.is_dir() and not child.is_symlink() else child.unlink()
    (work / "spec").mkdir()
    for name in ("design.md", "task-dag.json"):
        shutil.copyfile(m.dir / "plan" / name, work / "spec" / name)
    base = snapshot_repo(m, work / "repo")
    m.append("verify-snapshot", "orc step", cycle=verify_cycle(m), base=base)


def verify_base(m: Mission) -> str:
    snaps = [e for e in m.events() if e.get("kind") == "verify-snapshot" and e.get("cycle") == verify_cycle(m)]
    if not snaps:
        raise OrcError(f"mission {m.name} 这一轮验证没有记录代码快照。这是 orc 的 bug；把 events.jsonl 给用户看。")
    return snaps[-1]["base"]


def launch_agent(m: Mission, kind: str, message: Optional[str], delivers: List[str]) -> None:
    """后台启动规划会话或验证会话。message 为 None 时新开会话，否则 --resume 同一个会话并把 message 发过去。"""
    spec = AGENTS[kind]
    if shutil.which("claude") is None:
        raise OrcError(f"PATH 里找不到 claude，启动不了{spec['label']} → 安装 Claude Code 后再运行 orc step。")
    cfg = m.roles()[spec["role"]]
    work = agent_work(m, kind)
    runs = work / ".runs"
    runs.mkdir(parents=True, exist_ok=True)
    work_real = os.path.realpath(work)
    starts = agent_starts(m, kind)
    n = len(agent_starts(m, kind, current=False)) + 1
    if message is None:
        prompt = planner_prompt(m, Path(work_real)) if kind == "planner" else verifier_prompt(m, Path(work_real))
        session, mode = str(__import__("uuid").uuid4()), "new"
    else:
        session, mode, prompt = starts[0]["session"], "resume", message
    write_atomic(runs / f"{n}.prompt", prompt)
    # 产品仓库只读。实测（2026-11-07）：--add-dir 会把目录加进沙箱的可写白名单，Bash 就能写产品仓库，
    # 所以不用 --add-dir，并在沙箱里对产品仓库 denyWrite；Read / Grep / git log 照样能读代码（实测）
    settings = {"sandbox": {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
                            "filesystem": {"denyWrite": [os.path.realpath(m.repo())]}}}
    # 只放行这些工具；Write / Edit 只能写自己的工作目录（权限规则里 // 开头是绝对路径）。-p 模式下没放行的写入一律被拒
    tools = ["Read", "Glob", "Grep", "Bash"] + [f"{t}(/{work_real}/**)" for t in ("Write", "Edit", "MultiEdit")]
    argv = ["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
            "--permission-mode", "default", f"--settings={json.dumps(settings)}",
            f"--allowedTools={','.join(tools)}"]
    argv += ["--session-id", session] if mode == "new" else ["--resume", session]
    # 包装：会话结束时原子地写出退出码文件，orc 据此判断“结束了”
    wrapper = ('"$@" < "$ORC_RUN_IN" > "$ORC_RUN_OUT" 2> "$ORC_RUN_ERR"; '
               'echo $? > "$ORC_RUN_RC.tmp" && mv "$ORC_RUN_RC.tmp" "$ORC_RUN_RC"')
    env = dict(os.environ, ORC_ROLE=spec["env"], ORC_MISSION=m.name,
               ORC_RUN_IN=str(runs / f"{n}.prompt"), ORC_RUN_OUT=str(runs / f"{n}.json"),
               ORC_RUN_ERR=str(runs / f"{n}.err"), ORC_RUN_RC=str(runs / f"{n}.rc"))
    proc = subprocess.Popen(["sh", "-c", wrapper, f"orc-{kind}", *argv], cwd=work_real, env=env,
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)
    extra = {"cycle": verify_cycle(m)} if kind == "verifier" else {}
    m.append(f"{kind}-start", "orc step", run=n, session=session, pid=proc.pid, mode=mode, delivers=delivers, **extra)
    print(f"已启动{spec['label']}（第 {n} 次运行，{mode}，模型 {cfg['model']}）")


def launch_planner(m: Mission, message: Optional[str], delivers: List[str]) -> None:
    launch_agent(m, "planner", message, delivers)


def validate_plan_outputs(m: Mission, work: Path) -> List[str]:
    problems = []
    for name in ("design.md", "plan.md"):
        p = work / name
        if not p.is_file() or not p.read_text(encoding="utf-8").strip():
            problems.append(f"缺少 {name}，或者它是空的")
    dag = work / "task-dag.json"
    if not dag.is_file():
        return problems + ["缺少 task-dag.json"]
    check = subprocess.run(["bash", str(SCRIPTS / "validate-task-dag.sh"), str(dag)], capture_output=True, text=True)
    if check.returncode != 0:
        problems.append("task-dag.json 没通过 validate-task-dag.sh：" + (check.stderr.strip() or "无输出"))
    try:
        data = json.loads(dag.read_text(encoding="utf-8"))
    except ValueError as error:
        return problems + [f"task-dag.json 不是合法 JSON：{error}"]
    if not isinstance(data, dict):
        return problems + ["task-dag.json 的根必须是对象"]
    if data.get("mission") != m.name:
        problems.append(f"task-dag.json 的 mission 必须是 {m.name}")
    has_northstar = (m.repo() / ".northstar" / "NORTHSTAR.md").is_file()
    for task in data.get("tasks") if isinstance(data.get("tasks"), list) else []:
        if not isinstance(task, dict):
            continue
        tid = task.get("id", "?")
        acceptance = task.get("acceptance")
        if not isinstance(acceptance, list) or not acceptance or not all(isinstance(a, str) and a.strip() for a in acceptance):
            problems.append(f"节点 {tid} 缺少 acceptance（验收标准列表，不能为空）")
        clauses = task.get("clauses")
        if not isinstance(clauses, list) or not all(isinstance(c, str) and CLAUSE_RE.match(c) for c in clauses):
            problems.append(f"节点 {tid} 的 clauses 必须是 N# 列表")
        elif has_northstar and not clauses:
            problems.append(f"节点 {tid} 的 clauses 不能为空：产品仓库有 NORTHSTAR，写清它服务哪条 N#")
        if not isinstance(task.get("component"), str) or not task["component"].strip():
            problems.append(f"节点 {tid} 缺少 component（所属组件）")
        if task.get("state") != "ready":
            problems.append(f"节点 {tid} 的 state 必须是 ready")
    return problems


def copy_plan_outputs(m: Mission, work: Path) -> Dict[str, str]:
    dest = m.dir / "plan"
    dest.mkdir(exist_ok=True)
    files = {}
    for name in PLAN_FILES + ("northstar-constraints.md",):
        src, dst = work / name, dest / name
        if src.is_file():
            data = src.read_bytes()
            tmp = dst.with_name(f".{name}.tmp-{os.getpid()}")
            tmp.write_bytes(data)
            os.replace(tmp, dst)
            files[name] = hashlib.sha256(data).hexdigest()
        elif dst.exists():
            dst.unlink()            # 上一版有、这一版没有的可选产出
    return files


# ---------------------------------------------------------------- 验证：实现之前写好的测试和检查

PROTECTED_PREFIXES = (".northstar/", ".github/", ".git/")


def check_sandbox_argv(root: Path, command: str) -> List[str]:
    """检查命令是 agent 写的，orc 在 macOS 沙箱里跑：只能写快照目录（临时文件也放在里面，TMPDIR 指向它），不能联网。
    不放行 /tmp 和 /private/var/folders：那是所有进程共用的临时目录，放行了检查就能写别处的文件（测试实测过）。"""
    if shutil.which("sandbox-exec") is None:
        raise OrcError("这台机器没有 sandbox-exec（macOS 自带），orc 不在沙箱外运行 agent 写的检查命令。")
    real = os.path.realpath(root)
    profile = ('(version 1)(allow default)(deny network*)(deny file-write*)'
               f'(allow file-write* (subpath "{real}")'
               ' (literal "/dev/null") (literal "/dev/tty") (literal "/dev/dtracehelper"))')
    return ["sandbox-exec", "-p", profile, "sh", "-c", command]


def run_checks(m: Mission, base: str, test_src: Path, test_files: List[str], checks: List[dict], where: Path) -> List[dict]:
    """在一份干净的 base 提交上，只放入测试文件，逐条运行检查。返回每条的结果。"""
    if where.exists():
        shutil.rmtree(where)
    snapshot_repo(m, where)     # 用的是当前 HEAD；调用方先确认 HEAD 仍是 base
    for rel in test_files:
        dst = where / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(test_src / rel, dst)
    tmp = where / ".orc-tmp"
    tmp.mkdir()
    env = dict(os.environ, ORC_ROLE="check", TMPDIR=os.path.realpath(tmp) + "/")
    results = []
    for check in checks:
        try:
            run = subprocess.run(check_sandbox_argv(where, check["command"]), cwd=str(where), capture_output=True,
                                 text=True, timeout=CHECK_TIMEOUT, env=env)
            rc, tail = run.returncode, (run.stdout + run.stderr).strip().splitlines()[-8:]
        except subprocess.TimeoutExpired:
            rc, tail = None, [f"超过 {CHECK_TIMEOUT} 秒没有结束"]
        ok = (rc == 0) if check["expect_before"] == "pass" else (rc not in (0, None))
        results.append({"id": check["id"], "expect_before": check["expect_before"], "rc": rc, "ok": ok, "tail": tail})
    return results


def safe_rel(path: str) -> bool:
    p = Path(path)
    return bool(path) and not p.is_absolute() and ".." not in p.parts and "\\" not in path and p.as_posix() == path


def validate_verify_outputs(m: Mission, work: Path) -> Tuple[List[str], dict]:
    """校验验证会话的产出，并在当前代码上实际运行全部检查：fail 的必须失败，pass 的必须通过。"""
    path = work / "checks.json"
    if not path.is_file():
        return ["缺少 checks.json（写在工作目录根上，不是 repo/ 里）"], {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except ValueError as error:
        return [f"checks.json 不是合法 JSON：{error}"], {}
    if not isinstance(data, dict) or data.get("version") != 1:
        return ["checks.json 的根必须是对象，并且 version 是 1"], {}
    problems = []
    if data.get("mission") != m.name:
        problems.append(f"checks.json 的 mission 必须是 {m.name}")
    dag = json.loads((m.dir / "plan" / "task-dag.json").read_text(encoding="utf-8"))   # orc 自己的副本，不用 spec/ 里的
    tasks = {t["id"]: t for t in dag["tasks"]}
    owned = {f for t in tasks.values() for f in t.get("files", [])}
    base = verify_base(m)
    test_files = data.get("test_files")
    if not isinstance(test_files, list) or not test_files or not all(isinstance(p, str) for p in test_files):
        problems.append("test_files 必须是非空的路径列表")
        test_files = []
    if len(set(test_files)) != len(test_files):
        problems.append("test_files 里有重复的路径")
    for rel in test_files:
        if not safe_rel(rel):
            problems.append(f"测试文件路径 {rel} 不合法：用 repo 相对路径，不能是绝对路径、不能含 ..")
            continue
        if rel.startswith(PROTECTED_PREFIXES):
            problems.append(f"测试文件 {rel} 在受保护的目录里")
        if rel in owned:
            problems.append(f"测试文件 {rel} 和节点声明的文件重叠：执行会话会改它。换一个新文件")
        src = work / "repo" / rel
        if src.is_symlink() or not src.is_file():
            problems.append(f"测试文件 {rel} 不在 repo/ 里，或者不是普通文件")
        exists = subprocess.run(["git", "-C", str(m.repo()), "cat-file", "-e", f"{base}:{rel}"], capture_output=True)
        if exists.returncode == 0:
            problems.append(f"{rel} 是仓库里已有的文件：测试只能新建文件，不能改已有文件")
    checks = data.get("checks")
    if not isinstance(checks, list) or not checks:
        return problems + ["checks 必须是非空列表"], {}
    seen, covered, has_fail = set(), set(), set()
    for i, c in enumerate(checks, 1):
        if not isinstance(c, dict):
            problems.append(f"第 {i} 个检查不是对象")
            continue
        cid = c.get("id")
        if not isinstance(cid, str) or not CHECK_ID_RE.match(cid) or cid in seen:
            problems.append(f"第 {i} 个检查的 id 不合法或重复（小写字母、数字和 -）")
            continue
        seen.add(cid)
        node = c.get("node")
        if node not in tasks:
            problems.append(f"检查 {cid} 的 node「{node}」不是 DAG 里的节点")
            continue
        n_acc = len(tasks[node].get("acceptance", []))
        acc = c.get("acceptance")
        if not isinstance(acc, list) or not acc or not all(isinstance(a, int) and not isinstance(a, bool) and 1 <= a <= n_acc for a in acc):
            problems.append(f"检查 {cid} 的 acceptance 必须是 1 到 {n_acc} 之间的序号列表")
        else:
            covered.update((node, a) for a in acc)
        if not isinstance(c.get("command"), str) or not c["command"].strip():
            problems.append(f"检查 {cid} 缺少 command")
        if c.get("expect_before") not in ("fail", "pass"):
            problems.append(f"检查 {cid} 的 expect_before 只能是 fail 或 pass")
        elif c["expect_before"] == "fail":
            has_fail.add(node)
    for tid, t in tasks.items():
        for a in range(1, len(t.get("acceptance", [])) + 1):
            if (tid, a) not in covered:
                problems.append(f"节点 {tid} 的第 {a} 条验收标准没有检查：「{t['acceptance'][a - 1]}」")
        if tid not in has_fail:
            problems.append(f"节点 {tid} 没有 expect_before 为 fail 的检查：至少要有一个检查测它的新行为")
    if problems:
        return problems, {}
    head = subprocess.run(["git", "-C", str(m.repo()), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    if head != base:
        raise OrcError(f"产品仓库的当前提交从 {base[:12]} 变成了 {head[:12]}：验证是按旧代码写的。"
                       "规划和验证期间不要往产品仓库提交；回到原提交，或者用 orc revise 重新规划。")
    results = run_checks(m, base, work / "repo", test_files, checks, work / ".check-run")
    for r in results:
        if r["ok"]:
            continue
        tail = "\n    ".join(r["tail"]) or "无输出"
        if r["rc"] is None:
            problems.append(f"检查 {r['id']} 超时（{CHECK_TIMEOUT} 秒）")
        elif r["expect_before"] == "fail":
            problems.append(f"检查 {r['id']} 在还没实现的代码上就通过了：它没有测到新行为。改测试，让它在实现之前失败")
        else:
            problems.append(f"检查 {r['id']} 标成 pass（已有行为），但在现在的代码上失败了（退出码 {r['rc']}）：\n    {tail}")
    return problems, {"base": base, "results": results, "test_files": test_files}


def copy_verify_outputs(m: Mission, work: Path, info: dict) -> dict:
    dest = m.dir / "verify"
    if dest.exists():
        shutil.rmtree(dest)
    (dest / "files").mkdir(parents=True)
    shutil.copyfile(work / "checks.json", dest / "checks.json")
    tests = {}
    for rel in info["test_files"]:
        target = dest / "files" / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(work / "repo" / rel, target)
        tests[rel] = hashlib.sha256(target.read_bytes()).hexdigest()
    write_atomic(dest / "results.json", json.dumps({"base": info["base"], "results": info["results"]},
                                                     ensure_ascii=False, indent=2) + "\n")
    return {"base": info["base"], "checks": hashlib.sha256((dest / "checks.json").read_bytes()).hexdigest(), "tests": tests}


# ---------------------------------------------------------------- 两种会话共用的结束处理

def consecutive_failures(m: Mission, kind: str = "planner") -> int:
    exits = agent_exits(m, kind)
    count = 0
    for run in sorted((s["run"] for s in agent_starts(m, kind)), reverse=True):
        if exits.get(run, {}).get("outcome") in ("invalid", "failed"):
            count += 1
        elif run in exits:
            break
    return count


def finish_agent_run(m: Mission, kind: str, n: int, rc: Optional[int]):
    """一次会话运行结束：提问 / 校验不通过（发回去修或交给 coordinator）/ 通过进入下一个状态。"""
    spec = AGENTS[kind]
    work = agent_work(m, kind)
    question = work / "QUESTION.md"
    if question.is_file() and question.read_text(encoding="utf-8").strip():
        text = question.read_text(encoding="utf-8").strip()
        q = m.ask(text, "ask-user", "orc step")
        m.append(f"{kind}-exit", "orc step", run=n, rc=rc, outcome="question", question=q.stem)
        m.transition("blocked", "orc step", reason=f"{spec['label']}提问", question=q.stem, type="ask-user")
        question.rename(work / ".runs" / f"{n}.question.md")
        return None, True
    info: dict = {}
    if rc == 0:
        if kind == "planner":
            problems = validate_plan_outputs(m, work)
        else:
            problems, info = validate_verify_outputs(m, work)
        outcome = "invalid"
    else:
        problems = [f"{spec['label']}异常退出（退出码 {rc}）" if rc is not None else f"{spec['label']}的进程不见了，没有留下退出码"]
        outcome = "failed"
    if not problems:
        m.append(f"{kind}-exit", "orc step", run=n, rc=rc, outcome="ready")
        if kind == "planner":
            m.append("plan-ready", "orc step", files=copy_plan_outputs(m, work))
            m.transition("verifying", "orc step", reason="规划产出通过校验")
            print(f"mission {m.name}：规划产出通过校验，planning → verifying")
        else:
            summary = copy_verify_outputs(m, work, info)
            m.append("verify-ready", "orc step", **summary,
                     results={r["id"]: r["rc"] for r in info["results"]})
            m.transition("plan-review", "orc step", reason="验证产出通过校验，检查在实现前的结果都符合预期")
            print(f"mission {m.name}：验证产出通过校验，verifying → plan-review")
        return None, True
    previous = consecutive_failures(m, kind)
    if previous < MAX_REPAIRS:
        m.append(f"{kind}-exit", "orc step", run=n, rc=rc, outcome=outcome, problems=problems)
        launch_agent(m, kind, "orc 校验你的产出没有通过：\n" + "\n".join(f"- {p}" for p in problems)
                     + f"\n\n修正后把{spec['outputs']}重新写出。", [])
        return "wait", False
    text = (f"{spec['label']}的产出连续 {previous + 1} 次没有通过校验，需要裁决：\n" + "\n".join(f"- {p}" for p in problems)
            + f"\n\n产出在 {work}。回答会原样发给{spec['label']}。")
    q = m.ask(text, "mediate", "orc step")
    m.append(f"{kind}-exit", "orc step", run=n, rc=rc, outcome=outcome, problems=problems, question=q.stem)
    m.transition("blocked", "orc step", reason=f"{spec['label']}产出校验没有通过", question=q.stem, type="mediate")
    return None, True


def finish_planner_run(m: Mission, n: int, rc: Optional[int]):
    return finish_agent_run(m, "planner", n, rc)


def pending_agent_messages(m: Mission, kind: str) -> Tuple[List[str], List[str]]:
    """还没发给会话的：它提问的回答、coordinator 的裁决；规划会话还有用户审阅后的修改意见。"""
    spec = AGENTS[kind]
    starts = agent_starts(m, kind)
    delivered = {d for s in starts for d in s.get("delivers", [])}
    runs = {s["run"] for s in starts}
    questions = {e["question"]: e for e in agent_exits(m, kind).values() if e.get("question") and e["run"] in runs}
    ids, parts = [], []
    for e in m.events():
        if e.get("kind") == "answer" and e.get("id") in questions and f"answer:{e['id']}" not in delivered:
            text = Path(e["file"]).read_text(encoding="utf-8").strip()
            if questions[e["id"]].get("outcome") == "question":
                parts.append(f"用户对你的问题的回答：\n\n{text}\n\n据此继续：写出{spec['outputs']}，或者再写一个 QUESTION.md。")
            else:
                parts.append(f"你的产出没有通过校验，coordinator 的裁决：\n\n{text}\n\n据此修正后把{spec['outputs']}重新写出。")
            ids.append(f"answer:{e['id']}")
        if kind == "planner" and e.get("kind") == "feedback" and f"feedback:{e['id']}" not in delivered:
            parts.append(f"用户审阅后的修改意见：\n\n{e['text']}\n\n按意见修改工作目录里的产出，把全部产出文件重新写出。")
            ids.append(f"feedback:{e['id']}")
    return ids, parts


def pending_planner_messages(m: Mission) -> Tuple[List[str], List[str]]:
    return pending_agent_messages(m, "planner")


def agent_running(m: Mission, kind: str) -> bool:
    starts = agent_starts(m, kind)
    if not starts:
        return False
    last = starts[-1]
    if last["run"] in agent_exits(m, kind) or (agent_work(m, kind) / ".runs" / f"{last['run']}.rc").is_file():
        return False
    return process_alive(last["pid"], last["session"])


def h_agent(kind: str) -> Handler:
    spec = AGENTS[kind]

    def handler(m: Mission):
        starts = agent_starts(m, kind)
        if not starts:
            if kind == "verifier":
                prepare_verify_work(m)
            launch_agent(m, kind, None, [])
            return "wait", False
        last = starts[-1]
        n = last["run"]
        if n not in agent_exits(m, kind):
            rc_file = agent_work(m, kind) / ".runs" / f"{n}.rc"
            if rc_file.is_file():
                rc_text = rc_file.read_text().strip()
                rc: Optional[int] = int(rc_text) if rc_text.lstrip("-").isdigit() else None
            elif process_alive(last["pid"], last["session"]):
                return "wait", False
            else:
                rc = None
            return finish_agent_run(m, kind, n, rc)
        ids, parts = pending_agent_messages(m, kind)
        if parts:
            launch_agent(m, kind, "\n\n---\n\n".join(parts), ids)
            return "wait", False
        return (f"error mission {m.name} 在 {m.state}，但{spec['label']}已经结束、也没有待处理的回答或意见。"
                "这是 orc 的 bug；把 events.jsonl 给用户看。", False)
    return handler


h_planning = h_agent("planner")
h_verifying = h_agent("verifier")


# ---------------------------------------------------------------- 审阅页与发布（Claude Artifacts）

def md_to_html(text: str) -> str:
    """够用的 Markdown：标题、列表、代码块、段落、行内代码和粗体。全部先转义。"""
    import html as _h
    out, para, in_code, in_list = [], [], False, None

    def inline(s: str) -> str:
        s = _h.escape(s)
        s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
        return re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)

    def flush():
        nonlocal para, in_list
        if para:
            out.append("<p>" + inline(" ".join(para)) + "</p>")
            para = []
        if in_list:
            out.append(f"</{in_list}>")
            in_list = None
    for line in text.splitlines():
        if line.strip().startswith("```"):
            if in_code:
                out.append("</code></pre>")
            else:
                flush()
                out.append("<pre><code>")
            in_code = not in_code
            continue
        if in_code:
            out.append(_h.escape(line))
            continue
        heading = re.match(r"(#{1,6})\s+(.*)", line)
        item = re.match(r"\s*(?:[-*]|(\d+)\.)\s+(.*)", line)
        if heading:
            flush()
            level = min(len(heading.group(1)) + 1, 6)
            out.append(f"<h{level}>{inline(heading.group(2))}</h{level}>")
        elif item:
            if para:
                out.append("<p>" + inline(" ".join(para)) + "</p>")
                para = []
            kind = "ol" if item.group(1) else "ul"
            if in_list != kind:
                if in_list:
                    out.append(f"</{in_list}>")
                out.append(f"<{kind}>")
                in_list = kind
            out.append(f"<li>{inline(item.group(2))}</li>")
        elif not line.strip():
            flush()
        else:
            para.append(line.strip())
    if in_code:
        out.append("</code></pre>")
    flush()
    return "\n".join(out)


def render_review(m: Mission) -> str:
    import html as _h
    plan = m.dir / "plan"
    read = lambda name: (plan / name).read_text(encoding="utf-8") if (plan / name).is_file() else ""
    sha = lambda name: hashlib.sha256((plan / name).read_bytes()).hexdigest() if (plan / name).is_file() else "—"
    dag = json.loads(read("task-dag.json") or "{}")
    rows = []
    for t in dag.get("tasks", []):
        cell = lambda items: "<br>".join(_h.escape(str(x)) for x in items)
        rows.append(f"<tr><td><code>{_h.escape(t['id'])}</code></td><td>{cell(t.get('depends_on', [])) or '—'}</td>"
                    f"<td>{cell(t.get('files', []))}</td><td>{cell(t.get('acceptance', []))}</td>"
                    f"<td>{cell(t.get('clauses', [])) or '—'}</td><td>{_h.escape(str(t.get('component', '')))}</td>"
                    f"<td>{cell(t.get('verification', []))}</td></tr>")
    constraints = read("northstar-constraints.md")
    verification = render_verification(m)
    request = (m.dir / "request.md").read_text(encoding="utf-8").strip()
    return f"""<title>{_h.escape(m.name)} 计划审阅</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
/* 单列文档：顶部是要签名的哈希和 DAG，往下是设计和计划全文 */
:root{{--bg:#fbfbfa;--fg:#1d1f22;--muted:#5f646b;--line:#dcdfe3;--code:#eef0f2;--accent:#2b5fab}}
@media (prefers-color-scheme:dark){{:root:not([data-theme="light"]){{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;color-scheme:dark}}}}
:root[data-theme="dark"]{{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;color-scheme:dark}}
body{{background:var(--bg);color:var(--fg);font:16px/1.6 -apple-system,"PingFang SC",system-ui,sans-serif}}
main{{max-width:960px;margin:0 auto;padding-block:16px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}}
h1{{font-size:1.5em;text-wrap:balance}} h2{{border-top:1px solid var(--line);padding-top:1em;text-wrap:balance}}
a{{color:var(--accent)}} code,pre{{background:var(--code);border-radius:4px;font-family:ui-monospace,Menlo,monospace;font-size:.9em}}
code{{overflow-wrap:anywhere}} pre{{padding:8px;overflow-x:auto}} pre code{{overflow-wrap:normal}}
blockquote{{margin:0;padding-left:12px;border-left:3px solid var(--line);color:var(--muted)}}
table{{border-collapse:collapse;width:100%;font-size:14px}} td,th{{border:1px solid var(--line);padding:6px;vertical-align:top;text-align:left}}
.wrap{{overflow-x:auto}} .muted{{color:var(--muted)}}
</style>
<main>
<h1>计划审阅：{_h.escape(m.name)}</h1>
<p class="muted">由 orc 根据规划会话和验证会话的产出生成。说 go 之后，设计、计划、DAG 和下面的验收测试会原样冻结，你用 Touch ID 签名的就是它们的哈希。</p>
<h2>请求（原话）</h2><blockquote>{_h.escape(request)}</blockquote>
<h2>核对用的哈希</h2>
<table><tr><th>文件</th><th>sha256</th></tr>
<tr><td>设计 design.md</td><td><code>{sha('design.md')}</code></td></tr>
<tr><td>计划 plan.md</td><td><code>{sha('plan.md')}</code></td></tr>
<tr><td>DAG task-dag.json</td><td><code>{sha('task-dag.json')}</code></td></tr></table>
<h2>任务 DAG</h2><div class="wrap"><table><tr><th>节点</th><th>依赖</th><th>文件</th><th>验收标准</th><th>条款</th><th>组件</th><th>验证</th></tr>
{''.join(rows)}</table></div>
{verification}
{('<h2>建议加入 NORTHSTAR 的关键约束</h2>' + md_to_html(constraints)) if constraints.strip() else ''}
<h2>设计</h2>{md_to_html(read('design.md'))}
<h2>计划</h2>{md_to_html(read('plan.md'))}
</main>
"""


def render_verification(m: Mission) -> str:
    import html as _h
    vdir = m.dir / "verify"
    if not (vdir / "checks.json").is_file():
        return ""
    data = json.loads((vdir / "checks.json").read_text(encoding="utf-8"))
    results = {r["id"]: r for r in json.loads((vdir / "results.json").read_text(encoding="utf-8"))["results"]}
    base = json.loads((vdir / "results.json").read_text(encoding="utf-8"))["base"]
    dag = json.loads((m.dir / "plan" / "task-dag.json").read_text(encoding="utf-8"))
    acceptance = {t["id"]: t.get("acceptance", []) for t in dag["tasks"]}
    model = m.roles()["review"]["model"]
    rows = []
    for c in data["checks"]:
        r = results.get(c["id"], {})
        before = ("实现前应失败，实际失败" if c["expect_before"] == "fail" else "已有行为，实际通过") \
            + f"（退出码 {r.get('rc')}）"
        acc = "<br>".join(f"{a}. {_h.escape(acceptance[c['node']][a - 1])}" for a in c["acceptance"])
        rows.append(f"<tr><td><code>{_h.escape(c['id'])}</code></td><td><code>{_h.escape(c['node'])}</code></td>"
                    f"<td>{acc}</td><td><code>{_h.escape(c['command'])}</code></td><td>{before}</td></tr>")
    files = []
    for rel in data["test_files"]:
        body = (vdir / "files" / rel).read_bytes()
        files.append(f"<h3><code>{_h.escape(rel)}</code></h3><p class=\"muted\">sha256 <code>{hashlib.sha256(body).hexdigest()}</code></p>"
                     f"<pre><code>{_h.escape(body.decode('utf-8', 'replace'))}</code></pre>")
    return (f"<h2>验收测试</h2><p class=\"muted\">由独立的验证会话（模型 {_h.escape(model)}）在实现之前写好，它看不到规划过程。"
            f"每个检查都已在当前代码（提交 <code>{base[:12]}</code>）上实际运行过。go 之后这些测试冻结，执行会话只能读、不能改。</p>"
            "<div class=\"wrap\"><table><tr><th>检查</th><th>节点</th><th>验收标准</th><th>命令</th><th>实现前</th></tr>"
            + "".join(rows) + "</table></div>" + "".join(files))


def run_publisher(m: Mission, site: Path, page: str, url: Optional[str]) -> dict:
    """发布适配层：用 claude -p 的 Artifact 工具把 orc 生成的网页发布成仅本人可见的 Claude Artifact。

    发布会话只放行 Read 和 Artifact：它只读这一个文件、发布，不写任何东西。已经发布过的页面带上原链接更新，链接不变。
    """
    if shutil.which("claude") is None:
        raise OrcError("PATH 里找不到 claude，发布不了审阅页 → 安装并登录 Claude Code 后再运行 orc step。")
    if url:
        target = (f"这个页面已经发布过，链接是 {url}。先用 Artifact 的 `action: \"read\"` 读这个链接，"
                  "再带上同一个 `url` 发布，更新同一个链接，不要新建；不传 `icon`。")
    else:
        target = "这是第一次发布：不传 `url`，`icon` 用 `checklist`。"
    prompt = (ORC_ROOT / "templates" / "publish-artifact.md").read_text(encoding="utf-8")
    for key, value in (("{{PAGE}}", page), ("{{TARGET}}", target),
                       ("{{DESCRIPTION}}", f"orc mission {m.name} 的计划审阅页：设计、计划、任务 DAG 和要签名的哈希。")):
        prompt = prompt.replace(key, value)
    cfg = m.roles()["plan"]
    argv = ["claude", "-p", "--model", cfg["model"], "--effort", "low", "--output-format", "json",
            "--permission-mode", "default", "--allowedTools=Read,Artifact"]
    env = dict(os.environ, ORC_ROLE="publish", ORC_MISSION=m.name)
    try:
        run = subprocess.run(argv, cwd=str(site), input=prompt, capture_output=True, text=True,
                             timeout=600, env=env)
    except subprocess.TimeoutExpired as error:
        raise OrcError("审阅页发布超时（10 分钟）。不要拿本地文件代替链接；稍后再运行 orc step 重试。") from error
    text = run.stdout
    try:
        envelope = json.loads(text)
        if isinstance(envelope, dict) and "result" in envelope:
            text = str(envelope.get("result") or "")
    except ValueError:
        pass
    result = {}
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith("{") and line.endswith("}"):
            try:
                result = json.loads(line)
                break
            except ValueError:
                continue
    if not str(result.get("url", "")).startswith("https://claude.ai/"):
        detail = result.get("error") or (run.stderr.strip().splitlines() or ["没有输出发布结果"])[-1]
        raise OrcError(f"审阅页发布失败（{str(detail)[:200]}）。不要拿本地文件代替链接去要 go；"
                       "检查 Claude Code 登录后再运行 orc step。")
    return result


def ensure_published(m: Mission, route: str, html_text: str) -> str:
    digest = hashlib.sha256(html_text.encode()).hexdigest()
    receipts_path = m.dir / "publish.json"
    receipts = json.loads(receipts_path.read_text()) if receipts_path.is_file() else {}
    current = receipts.get(route, {})
    if current.get("sha256") == digest:
        return current["url"]
    site = m.site_dir()
    site.mkdir(parents=True, exist_ok=True)
    page = f"{route}.html"
    write_atomic(site / page, html_text)
    result = run_publisher(m, site, page, current.get("url"))
    receipts[route] = {"url": result["url"], "sha256": digest, "at": now()}
    write_atomic(receipts_path, json.dumps(receipts, ensure_ascii=False, indent=2) + "\n")
    m.append("published", "orc step", route=route, url=result["url"], sha256=digest)
    return result["url"]


def published_is_current(m: Mission, route: str) -> bool:
    receipts_path = m.dir / "publish.json"
    if not receipts_path.is_file():
        return False
    digest = hashlib.sha256(render_review(m).encode()).hexdigest()
    return json.loads(receipts_path.read_text()).get(route, {}).get("sha256") == digest


def h_plan_review(m: Mission):
    if m.frozen():
        control = os.path.realpath(m.control)
        if not (m.control / "approved.sha256.sig").is_file():
            return f"sign {control}", False
        problem = verify_approval(m)
        if problem:
            return problem, False
        m.transition("approved", "orc step", reason="签名和哈希校验通过")
        print(f"mission {m.name}：plan-review → approved")
        return None, True
    try:
        url = ensure_published(m, "plan", render_review(m))
    except OrcError as error:
        return f"error {error}", False
    return f"go-gate {url}", False


def not_yet(phase: str) -> Handler:
    def handler(m: Mission):
        return (f"error {m.state} 阶段的流程还没有实现（PLAN {phase}）。mission {m.name} 停在 {m.state}，"
                f"实现后运行 orc step --mission {m.name} 即可接上。", False)
    return handler


def h_blocked(m: Mission):
    ctx = m.replay()
    qid, back = ctx["question"], ctx["blocked_from"]
    qfile = m.dir / "questions" / f"{qid}.md"
    if not qfile.is_file():
        return (f"error mission {m.name} 停在 blocked，但它的问题文件 {qfile} 不见了。"
                "不要手动解除 blocked；把这条消息告诉用户。"), False
    if qid not in ctx["answered"]:
        if ctx["qtype"] == "mediate":
            return f"mediate {qfile}", False
        return f"ask-user {qfile.read_text().strip()}", False
    m.transition(back, "orc step", reason=f"问题 {qid} 已回答")
    print(f"mission {m.name}：blocked → {back}")
    return None, True


def verify_approval(m: Mission) -> Optional[str]:
    """go 之后冻结的文件：每次都重新校验签名（northstar verify-mission）和哈希（verify-approved-authority.py）。"""
    control = os.path.realpath(m.control)
    northstar = Path(os.environ.get("ORC_NORTHSTAR_ROOT", "/opt/northstar")) / "bin" / "northstar"
    sig = subprocess.run([str(northstar), "verify-mission", control], capture_output=True, text=True)
    if sig.returncode != 0:
        return (f"error mission {m.name} 冻结设计的签名校验失败（{northstar} verify-mission {control}）。"
                "冻结文件或签名被改过，或签名不是你的；不要继续执行，把这条消息告诉用户。")
    hashes = subprocess.run([sys.executable, str(SCRIPTS / "verify-approved-authority.py"), "--control-dir", control],
                            capture_output=True, text=True)
    if hashes.returncode != 0:
        detail = (hashes.stderr.strip().splitlines() or ["无输出"])[-1]
        return (f"error mission {m.name} 的冻结文件和签名时的哈希不一致（{detail}）。"
                "go 之后的设计、计划、DAG 不能改；不要继续执行，把这条消息告诉用户。")
    problem = verify_frozen_checks(m)
    if problem:
        return (f"error mission {m.name} 的冻结验收测试校验失败（{problem}）。"
                "go 之后验收测试不能改；不要继续执行，把这条消息告诉用户。")
    return None


def h_terminal(m: Mission):
    if m.state == "failed":
        last = [e for e in m.events() if e.get("kind") == "state"][-1]
        return f"error mission {m.name} 已失败：{last.get('reason', '原因见 events.jsonl')}。不要手动续跑，把原因告诉用户。", False
    return f"error mission {m.name} 已完成清理，没有可做的步骤。新任务用 orc step --new。", False


HANDLERS: Dict[str, Handler] = {
    "new": h_new,
    "planning": h_planning,
    "verifying": h_verifying,
    "plan-review": h_plan_review,
    "approved": not_yet("阶段 4"),
    "executing": not_yet("阶段 4"),
    "reviewing": not_yet("阶段 5"),
    "accepted": not_yet("阶段 5"),
    "blocked": h_blocked,
    "cleaned": h_terminal,
    "failed": h_terminal,
}


def step(mission: Mission) -> Next:
    with mission:
        for _ in range(len(MISSION_STATES) + 1):   # 一次 step 可以连过几个不需要等待的状态
            ctx = mission.replay()
            effective = ctx["blocked_from"] if ctx["state"] == "blocked" else ctx["state"]
            if effective in APPROVED_STATES:
                problem = verify_approval(mission)
                if problem:
                    return problem
            nxt, cont = HANDLERS[ctx["state"]](mission)
            if not cont:
                return nxt or "wait"
        return "error orc step 在一次运行里转了太多次状态。这是 orc 的 bug，把 events.jsonl 给用户看。"


# ---------------------------------------------------------------- 命令

def cmd_step(args) -> int:
    if bool(args.new) == bool(args.mission):
        raise OrcError("orc step 需要 --new \"<请求>\" 或 --mission <mission> 其中之一。")
    mission = create_mission(args.new, args.repo, args.name) if args.new else Mission(args.mission)
    if args.new:
        print(f"已新建 mission {mission.name}（{mission.dir}）")
    nxt = step(mission)
    print(f"next: {nxt}")
    return 1 if nxt.startswith("error ") else 0


def all_missions() -> List[Mission]:
    root = orc_home() / "missions"
    if not root.is_dir():
        return []
    return [Mission(p.name) for p in sorted(root.iterdir()) if NAME_RE.match(p.name) and (p / "events.jsonl").is_file()]


def cmd_answer(args) -> int:
    if args.mission:
        mission = Mission(args.mission)
    else:
        waiting = [m for m in all_missions() if m.open_questions()]
        if not waiting:
            raise OrcError("没有等待回答的问题。用 orc status 看各 mission 的状态。")
        if len(waiting) > 1:
            raise OrcError("有多个 mission 在等回答：" + "、".join(m.name for m in waiting) + "。用 --mission 指定。")
        mission = waiting[0]
    with mission:
        pending = mission.open_questions()
        if args.file:
            target = Path(args.file).resolve()
            matched = [q for q in pending if q.resolve() == target]
            if not matched:
                raise OrcError(f"{args.file} 不是 mission {mission.name} 里等待回答的问题。待回答的有：" + ("、".join(str(q) for q in pending) or "无"))
            question = matched[0]
        elif len(pending) == 1:
            question = pending[0]
        elif not pending:
            raise OrcError(f"mission {mission.name} 没有等待回答的问题。")
        else:
            raise OrcError("有多个待回答的问题，用 --file 指定是哪一个：" + "、".join(str(q) for q in pending))
        if not args.text.strip():
            raise OrcError("回答是空的。把用户的原话写进引号里。")
        answer = mission.dir / "answers" / question.name
        write_atomic(answer, args.text.rstrip() + "\n")
        mission.append("answer", "orc answer", id=question.stem, file=str(answer))
    print(f"已写回 {answer}")
    print(f"next: 运行 orc step --mission {mission.name}")
    return 0


def cmd_revise(args) -> int:
    """go 之前，把用户审阅后的修改意见发回规划会话。"""
    if not args.text.strip():
        raise OrcError("修改意见是空的。把用户的原话写进引号里。")
    with Mission(args.mission) as m:
        if m.frozen():
            raise OrcError(f"mission {m.name} 已经冻结（用户说过 go），不能再改计划。要改就让用户决定放弃这个 mission、重新开一个。")
        if m.state != "plan-review":
            raise OrcError(f"mission {m.name} 现在是 {m.state}：只有在 plan-review（审阅页已发布、还没 go）时才能提修改意见。")
        n = sum(1 for e in m.events() if e.get("kind") == "feedback") + 1
        m.append("feedback", "orc revise", id=n, text=args.text.strip())
        m.transition("planning", "orc revise", reason="用户修改意见")
    print(f"已记录修改意见，mission {m.name}：plan-review → planning")
    print(f"next: 运行 orc step --mission {m.name}")
    return 0


FROZEN_CHECKS_RE = re.compile(r"^checks 清单的 sha256：`([0-9a-f]{64})`", re.M)


def freeze_verification(m: Mission) -> str:
    """把验收测试写进 control/，返回追加到 brief-exec.md 的一节。

    签名的哈希清单只有四个文件（复用脚本的约定，不改）。验收测试的哈希写进 brief-exec.md，
    brief-exec.md 的哈希在清单里，签名就连带覆盖了验收测试：改任何一个测试文件，都对不上 brief-exec.md 里的哈希。
    """
    vdir, c = m.dir / "verify", m.control
    if not (vdir / "checks.json").is_file():
        raise OrcError(f"mission {m.name} 还没有验收测试（verify/checks.json）。验证没完成不能 go；运行 orc step。")
    data = json.loads((vdir / "checks.json").read_text(encoding="utf-8"))
    base = json.loads((vdir / "results.json").read_text(encoding="utf-8"))["base"]
    tests_dir = c / "approved-tests"
    shutil.rmtree(tests_dir, ignore_errors=True)
    tests = {}
    for rel in data["test_files"]:
        dst = tests_dir / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(vdir / "files" / rel, dst)
        tests[rel] = hashlib.sha256(dst.read_bytes()).hexdigest()
    approved = {"version": 1, "mission": m.name, "base": base, "test_files": tests, "checks": data["checks"]}
    text = json.dumps(approved, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    write_atomic(c / "approved-checks.json", text)
    digest = hashlib.sha256(text.encode()).hexdigest()
    rows = "".join(f"| `{rel}` | `{h}` |\n" for rel, h in sorted(tests.items()))
    return (f"\n## 冻结的验收测试\n\n"
            "下面的测试由独立的验证会话在实现之前写好，和这份文件一起签名。你可以读、可以运行，**不能改、不能删、不能移动**；"
            "改动它们的提交会被拒绝。你的节点只有在属于它的检查全部通过时才算完成。你可以另外写自己的单元测试"
            "（放在你的 `files` 里），但它们不算数。\n\n"
            f"基线提交：`{base}`\n\nchecks 清单的 sha256：`{digest}`（`approved-checks.json`）\n\n"
            f"| 测试文件 | sha256 |\n| --- | --- |\n{rows}")


def verify_frozen_checks(m: Mission) -> Optional[str]:
    """签名覆盖 brief-exec.md；这里再从 brief-exec.md 里的哈希核对验收测试和检查清单。"""
    c = m.control
    try:
        brief = (c / "brief-exec.md").read_text(encoding="utf-8")
        match = FROZEN_CHECKS_RE.search(brief)
        raw = (c / "approved-checks.json").read_bytes()
        if not match or hashlib.sha256(raw).hexdigest() != match.group(1):
            return "approved-checks.json 和签名的 brief-exec.md 里记的哈希不一致"
        tests = json.loads(raw)["test_files"]
        present = {p.relative_to(c / "approved-tests").as_posix()
                   for p in (c / "approved-tests").rglob("*") if p.is_file() or p.is_symlink()}
        if present != set(tests):
            return "approved-tests/ 里的文件和签名时的清单不一致"
        for rel, digest in tests.items():
            path = c / "approved-tests" / rel
            if path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
                return f"验收测试 {rel} 被改过"
    except (OSError, ValueError, KeyError) as error:
        return f"读不出冻结的验收测试（{error}）"
    return None


def cmd_go(args) -> int:
    """用户说 go 之后：冻结设计、计划、执行规则和 DAG，等用户签名。"""
    with Mission(args.mission) as m:
        if m.frozen():
            raise OrcError(f"mission {m.name} 已经冻结，等用户签名：northstar approve-mission {os.path.realpath(m.control)}")
        if m.state != "plan-review":
            raise OrcError(f"mission {m.name} 现在是 {m.state}：只有在 plan-review、用户看过审阅页并说 go 之后才能运行 orc go。")
        if not published_is_current(m, "plan"):
            raise OrcError("审阅页还没有发布（或者计划改过、还没重新发布）。先运行 orc step 发布，让用户看过最新的审阅页再说 go。")
        c, plan = m.control, m.dir / "plan"
        brief = (ORC_ROOT / "templates" / "brief-exec.md").read_text(encoding="utf-8")
        brief = brief.replace("{{MISSION}}", m.name).replace("{{IMPLEMENT_MODEL}}", m.roles()["implement"]["model"])
        brief += freeze_verification(m)
        written = {"approved-design.md": (plan / "design.md").read_bytes(),
                   "approved-plan.md": (plan / "plan.md").read_bytes(),
                   "brief-exec.md": brief.encode()}
        for name, data in written.items():
            (c / name).write_bytes(data)
        write_atomic(c / "approved.sha256", "".join(f"{hashlib.sha256(d).hexdigest()}  {n}\n" for n, d in written.items()))
        freeze = subprocess.run(["bash", str(SCRIPTS / "validate-task-dag.sh"), "--freeze", str(plan / "task-dag.json"),
                                 os.path.realpath(c)], capture_output=True, text=True)
        if freeze.returncode != 0:
            for name in (*written, "approved.sha256", "approved-checks.json"):   # 撤掉没冻结成的半成品，重新 go 时从头来
                (c / name).unlink(missing_ok=True)
            shutil.rmtree(c / "approved-tests", ignore_errors=True)
            raise OrcError("冻结 DAG 失败：" + (freeze.stderr.strip() or "无输出") + "。冻结没有完成，可以修正后重新运行 orc go。")
        frozen = {n: hashlib.sha256((c / n).read_bytes()).hexdigest()
                  for n in ("approved-design.md", "approved-plan.md", "brief-exec.md", "approved-task-dag.json")}
        frozen["approved-checks.json"] = hashlib.sha256((c / "approved-checks.json").read_bytes()).hexdigest()
        m.append("frozen", "orc go", files=frozen)
        constraints = plan / "northstar-constraints.md"
        drafted = None
        if constraints.is_file() and constraints.read_text(encoding="utf-8").strip():
            ns_dir = m.repo() / ".northstar"
            if ns_dir.is_dir():
                drafts = m.repo() / "drafts"
                drafts.mkdir(exist_ok=True)
                target = drafts / "NORTHSTAR.md"
                base = target if target.is_file() else ns_dir / "NORTHSTAR.md"
                text = base.read_text(encoding="utf-8").rstrip() + f"\n\n## mission {m.name} 的关键设计约束\n\n" \
                    + constraints.read_text(encoding="utf-8").strip() + "\n"
                write_atomic(target, text)
                drafted = target
        control = os.path.realpath(c)
    print(f"已冻结 mission {m.name} 的设计、计划、执行规则、DAG 和验收测试（{control}）。")
    print(f"请用户在自己的终端运行：northstar approve-mission {control}，核对哈希后输入 SEAL 并按 Touch ID。")
    if drafted:
        print(f"规划提出的关键约束已追加到 {drafted}：请用户在产品仓库运行 northstar seal 把它们签进 NORTHSTAR。")
    print(f"next: sign {control}")
    return 0


def cmd_wait(args) -> int:
    """阻塞到后台的规划会话或验证会话结束（或 mission 不再处于 planning / verifying），然后返回；coordinator 在后台运行它。"""
    import time
    m = Mission(args.mission)
    if not m.exists():
        raise OrcError(f"没有名为「{args.mission}」的 mission。")
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        kind = {"planning": "planner", "verifying": "verifier"}.get(m.replay()["state"])
        if kind is None or not agent_running(m, kind):
            break
        time.sleep(1)
    else:
        print(f"等了 {args.timeout} 秒，{AGENTS[kind]['label']}还在运行。")
        return 1
    print(f"next: 运行 orc step --mission {m.name}")
    return 0


def cmd_status(args) -> int:
    missions = [Mission(args.mission)] if args.mission else all_missions()
    if args.mission and not missions[0].exists():
        raise OrcError(f"没有名为「{args.mission}」的 mission。")
    if not missions:
        print(f"还没有 mission（{orc_home() / 'missions'}）。")
        return 0
    for m in missions:
        events = m.events()
        created = next((e for e in events if e.get("kind") == "created"), {})
        try:
            state = m.state
        except OrcError as error:
            print(f"{m.name}  日志无法回放  {error}")
            continue
        print(f"{m.name}  {state}  创建于 {created.get('ts', '?')}  仓库 {created.get('repo', '?')}")
        if args.mission:
            models = json.loads((m.dir / "models.json").read_text())["roles"]
            print("  模型：" + "，".join(f"{r}={v['model']}" for r, v in models.items()))
            nodes = m.node_states()
            print("  节点：" + ("，".join(f"{k}={v}" for k, v in nodes.items()) if nodes else "（还没有冻结的 DAG）"))
            for q in m.open_questions():
                print(f"  待回答：{q}")
            print("  最近事件：")
            for e in events[-5:]:
                detail = {k: v for k, v in e.items() if k not in ("ts", "mission", "kind", "by")}
                print(f"    {e['ts']}  {e['kind']}  {json.dumps(detail, ensure_ascii=False)}")
    return 0


# ---------------------------------------------------------------- doctor

def cmd_doctor(args) -> int:
    ns_root = Path(os.environ.get("ORC_NORTHSTAR_ROOT", "/opt/northstar"))
    managed = Path(os.environ.get("ORC_CLAUDE_MANAGED_SETTINGS",
                                  "/Library/Application Support/ClaudeCode/managed-settings.json"))
    codex_hooks = Path(os.environ.get("ORC_CODEX_HOOKS", Path.home() / ".codex" / "hooks.json"))
    results: List[Tuple[str, str, str]] = []   # (级别, 检查项, 说明)

    def check(name: str, ok: bool, fix: str, level_if_bad: str = "FAIL") -> None:
        results.append(("ok" if ok else level_if_bad, name, "" if ok else fix))

    # 1. 信任层
    check("信任层：northstar 命令", os.access(ns_root / "bin" / "northstar", os.X_OK),
          f"{ns_root}/bin/northstar 不存在或不可执行 → 让用户运行 sudo bash docs/orc/northstar-staging/install.sh")
    hooks_ok = all((ns_root / "hooks" / h).is_file() for h in ("guard.sh", "align.sh", "inject.sh", "stop-gate.sh"))
    check("信任层：四个 hook 脚本", hooks_ok, f"{ns_root}/hooks 下缺少 hook → 重新运行 install.sh")
    text = lambda p: p.read_text(errors="replace") if p.is_file() else ""
    check("信任层：Claude Code 已注册 hook", "guard.sh" in text(managed),
          f"{managed} 里没有 guard.sh → 重新运行 install.sh")
    check("信任层：Codex 已注册 hook", "guard.sh" in text(codex_hooks),
          f"{codex_hooks} 里没有 guard.sh → 重新运行 install.sh，再在 Codex 里用 /hooks 信任")
    hooks_path = subprocess.run(["git", "config", "--global", "--get", "core.hooksPath"],
                                capture_output=True, text=True).stdout.strip()
    check("信任层：git 全局 hook 目录", hooks_path == str(ns_root / "git"),
          f"core.hooksPath 是「{hooks_path or '未设置'}」，应为 {ns_root / 'git'} → 重新运行 install.sh")

    try:
        worktrees_root()
        check("节点 worktree 位置", True, "")
    except OrcError as error:
        check("节点 worktree 位置", False, str(error))

    # 2. 模型配置
    try:
        models = resolve_models()
        check("模型配置：models.toml", True, "")
    except OrcError as error:
        models = None
        check("模型配置：models.toml", False, str(error))

    # 3. 命令：codex / claude 只在有角色用它时才要求
    used = {cfg["cli"] for cfg in models["roles"].values()} if models else {"claude", "codex"}
    for cmd in ("git", "jq", "claude", "codex"):
        if cmd in ("claude", "codex") and cmd not in used:
            results.append(("skip", f"命令：{cmd}", "models.toml 里没有角色用它"))
            continue
        check(f"命令：{cmd}", shutil.which(cmd) is not None, f"PATH 里找不到 {cmd} → 安装后再运行 orc doctor")

    # 4. 模型可用（会消耗额度，只在 --live 时实测；同一个模型只调用一次）
    if models and args.live:
        by_model: Dict[Tuple[str, str], List[str]] = {}
        for role, cfg in models["roles"].items():
            by_model.setdefault((cfg["cli"], cfg["model"]), []).append(role)
        for (cli, model), role_names in by_model.items():
            if cli == "codex":
                argv = ["codex", "exec", "--skip-git-repo-check", "-m", model, "只回复 ok"]
            else:
                argv = ["claude", "-p", "--model", model, "只回复 ok"]
            try:
                run = subprocess.run(argv, capture_output=True, text=True, timeout=180)
                # 必须有一整行就是 ok（忽略大小写和首尾空白）；"token limit" 这类含 ok 子串的输出不算
                ok = run.returncode == 0 and any(l.strip().lower() == "ok" for l in run.stdout.splitlines())
                detail = (run.stderr or run.stdout).strip().splitlines()[-1:] or ["无输出"]
            except (OSError, subprocess.TimeoutExpired) as error:
                ok, detail = False, [str(error)]
            check(f"模型可用：{model}（{'、'.join(role_names)}）", ok,
                  f"{' '.join(argv[:-1])} 没有返回 ok（{detail[0][:160]}）→ 检查登录、代理和额度")
    elif models:
        results.append(("skip", "模型可用", "没有实测（会消耗额度）→ 需要时运行 orc doctor --live"))

    # 5. 审阅页发布：用 claude -p 的 Artifact 工具，靠上面的 claude 检查；实测会新建一个 Artifact，这里不做
    results.append(("skip", "审阅页发布", "Claude Artifacts（claude -p 的 Artifact 工具）；没有实测，实测会新建一个 Artifact"))

    width = max(len(r[1]) for r in results)
    for level, name, note in results:
        print(f"{level:>4}  {name.ljust(width)}  {note}".rstrip())
    failed = sum(1 for r in results if r[0] == "FAIL")
    print(f"\n{'有 ' + str(failed) + ' 项未通过' if failed else '全部通过'}（warn、skip 不算失败）")
    return 1 if failed else 0


# ---------------------------------------------------------------- 入口

def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(prog="orc", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("step", help="执行当前状态的一段机械流程，打印 next:")
    p.add_argument("--new", metavar="请求")
    p.add_argument("--mission")
    p.add_argument("--repo", help="产品仓库（默认当前目录所在的 git 仓库）")
    p.add_argument("--name", help="mission 名（默认按时间和请求生成）")
    p.set_defaults(func=cmd_step)
    p = sub.add_parser("answer", help="把用户或 coordinator 的回答写回")
    p.add_argument("text")
    p.add_argument("--mission")
    p.add_argument("--file")
    p.set_defaults(func=cmd_answer)
    p = sub.add_parser("revise", help="go 之前把用户的修改意见发回规划会话")
    p.add_argument("text")
    p.add_argument("--mission", required=True)
    p.set_defaults(func=cmd_revise)
    p = sub.add_parser("go", help="用户说 go 之后冻结设计、计划和 DAG，等用户签名")
    p.add_argument("--mission", required=True)
    p.set_defaults(func=cmd_go)
    p = sub.add_parser("wait", help="等后台的规划会话结束")
    p.add_argument("--mission", required=True)
    p.add_argument("--timeout", type=int, default=3600)
    p.set_defaults(func=cmd_wait)
    p = sub.add_parser("status", help="查看 mission 状态")
    p.add_argument("--mission")
    p.set_defaults(func=cmd_status)
    p = sub.add_parser("doctor", help="检查信任层、模型配置和依赖")
    p.add_argument("--live", action="store_true", help="实际调用一次每个模型（消耗额度）")
    p.set_defaults(func=cmd_doctor)
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except OrcError as error:
        if args.command == "step":
            print(f"next: error {error}")
        else:
            print(f"orc {args.command}：{error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
