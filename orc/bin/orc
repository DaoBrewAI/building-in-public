{''.join(rows)}</table></div>
{verification}
{('<h2>建议加入 NORTHSTAR 的关键约束</h2>' + md_to_html(constraints)) if constraints.strip() else ''}
<h2>设计</h2>{md_to_html(read('design.md'))}
<h2>计划</h2>{md_to_html(read('plan.md'))}
</main>
"""


def render_overview(m: Mission) -> str:
    """「一图看懂」：按依赖分层画出节点卡片，每张卡片是声明文件、验收标准和对应的检查（图为主，字为辅）。"""
    import html as _h
    plan, vdir = m.dir / "plan", m.dir / "verify"
    if not (plan / "task-dag.json").is_file():
        return ""
    tasks = json.loads((plan / "task-dag.json").read_text(encoding="utf-8")).get("tasks", [])
    checks = json.loads((vdir / "checks.json").read_text(encoding="utf-8"))["checks"] if (vdir / "checks.json").is_file() else []
    results = ({r["id"]: r for r in json.loads((vdir / "results.json").read_text(encoding="utf-8"))["results"]}
               if (vdir / "results.json").is_file() else {})
    depth: Dict[str, int] = {}

    def level(t: dict, seen=()) -> int:
        if t["id"] not in depth:
            deps = [d for d in t.get("depends_on", []) if d not in seen]
            by_id = {x["id"]: x for x in tasks}
            depth[t["id"]] = 1 + max((level(by_id[d], seen + (t["id"],)) for d in deps if d in by_id), default=-1)
        return depth[t["id"]]
    for t in tasks:
        level(t)
    short = lambda text, n=46: text if len(text) <= n else text[:n - 1] + "…"
    cards: Dict[int, List[str]] = {}
    for t in tasks:
        acc = []
        for i, text in enumerate(t.get("acceptance", []), 1):
            pills = []
            for c in checks:
                if c["node"] != t["id"] or i not in c["acceptance"]:
                    continue
                r = results.get(c["id"], {})
                kind = "new" if c["expect_before"] == "fail" else "keep"
                ok = "✓" if r.get("ok") else ("✗" if r else "")
                tip = f"{c['id']}：{c['command']}（实现前{'应失败' if kind == 'new' else '应通过'}，退出码 {r.get('rc')}）"
                pills.append(f'<span class="pill {kind}" title="{_h.escape(tip)}">{ok}</span>')
            acc.append(f'<li><span class="num">{i}</span><span class="at" title="{_h.escape(text)}">{_h.escape(short(text))}</span>'
                       f'<span class="pills">{"".join(pills)}</span></li>')
        files = "".join(f'<span class="file">{_h.escape(f)}</span>' for f in t.get("files", []))
        clauses = "".join(f'<span class="clause">{_h.escape(c)}</span>' for c in t.get("clauses", []))
        deps = "、".join(t.get("depends_on", []))
        cards.setdefault(depth[t["id"]], []).append(
            f'<div class="card"><div class="ch"><b>{_h.escape(t["id"])}</b>{clauses}</div>'
            f'<div class="files">{files}</div><ol class="acc">{"".join(acc)}</ol>'
            + (f'<div class="dep">等 {_h.escape(deps)} 集成后开始</div>' if deps else '<div class="dep">一开始就能做</div>')
            + '</div>')
    layers = '<div class="arrow" aria-hidden="true">→</div>'.join(
        f'<div class="layer">{"".join(cards[d])}</div>' for d in sorted(cards))
    n_new = sum(1 for c in checks if c["expect_before"] == "fail")
    n_ok = sum(1 for c in checks if results.get(c["id"], {}).get("ok"))
    flow = "".join(f'<span class="step {cls}">{_h.escape(label)}</span>' for label, cls in (
        ("规划", "done"), ("验收测试", "done" if results else ""), ("你看这页、说 go", "you"), ("你签名", "you"),
        ("执行：每条验收标准一次提交", ""), ("集成", "")))
    return (f'<h2>一图看懂</h2><div class="flow">{flow}</div>'
            f'<div class="stats"><span><b>{len(tasks)}</b> 个节点</span>'
            f'<span><b>{sum(len(t.get("acceptance", [])) for t in tasks)}</b> 条验收标准</span>'
            f'<span><b>{len(checks)}</b> 个检查（{n_new} 个测新行为）</span>'
            f'<span><b>{n_ok}/{len(checks)}</b> 实现前结果符合预期</span></div>'
            f'<div class="board">{layers}</div>'
            '<p class="legend"><span class="pill new">✓</span> 测新行为：实现前已确认会失败　'
            '<span class="pill keep">✓</span> 守住已有行为：实现前已确认通过　'
            '<span class="file">文件</span> 节点只能改这些文件　<span class="clause">N1</span> 服务的 NORTHSTAR 条款。'
            '把手指或鼠标放在验收标准、圆点上能看到全文和检查命令；完整文字在下面各节。</p>')


def render_verification(m: Mission) -> str:
    import html as _h
    vdir = m.dir / "verify"
    if not (vdir / "checks.json").is_file():
        return ""
    data = json.loads((vdir / "checks.json").read_text(encoding="utf-8"))
    results = {r["id"]: r for r in json.loads((vdir / "results.json").read_text(encoding="utf-8"))["results"]}
    base = json.loads((vdir / "results.json").read_text(encoding="utf-8"))["base"]
    dag = json.loads((m.dir / "plan" / "task-dag.json").read_text(encoding="utf-8"))
    acceptance = {t["id"]: t.get("acceptance", []) for t in dag["tasks"]}
    model = m.roles()["review"]["model"]
    rows = []
    for c in data["checks"]:
        r = results.get(c["id"], {})
        before = ("实现前应失败，实际失败" if c["expect_before"] == "fail" else "已有行为，实际通过") \
            + f"（退出码 {r.get('rc')}）"
        if r.get("tail"):
            before += f"<details><summary>输出</summary><pre><code>{_h.escape(chr(10).join(r['tail']))}</code></pre></details>"
        acc = "<br>".join(f"{a}. {_h.escape(acceptance[c['node']][a - 1])}" for a in c["acceptance"])
        rows.append(f"<tr><td><code>{_h.escape(c['id'])}</code></td><td><code>{_h.escape(c['node'])}</code></td>"
                    f"<td>{acc}</td><td><code>{_h.escape(c['command'])}</code></td><td>{before}</td></tr>")
    files = []
    for rel in data["test_files"]:
        body = (vdir / "files" / rel).read_bytes()
        files.append(f"<h3><code>{_h.escape(rel)}</code></h3><p class=\"muted\">sha256 <code>{hashlib.sha256(body).hexdigest()}</code></p>"
                     f"<pre><code>{_h.escape(body.decode('utf-8', 'replace'))}</code></pre>")
    return (f"<h2>验收测试</h2><p class=\"muted\">由独立的验证会话（模型 {_h.escape(model)}）在实现之前写好，它看不到规划过程。"
            f"每个检查都已在当前代码（提交 <code>{base[:12]}</code>）上实际运行过。go 之后这些测试冻结，执行会话只能读、不能改。</p>"
            "<div class=\"wrap\"><table><tr><th>检查</th><th>节点</th><th>验收标准</th><th>命令</th><th>实现前</th></tr>"
            + "".join(rows) + "</table></div>" + "".join(files))


def run_publisher(label: str, site: Path, page: str, url: Optional[str], description: str, model: str) -> dict:
    """发布适配层：用 claude -p 的 Artifact 工具把 orc 生成的网页发布成仅本人可见的 Claude Artifact。

    发布会话只放行 Read 和 Artifact：它只读这一个文件、发布，不写任何东西。已经发布过的页面带上原链接更新，链接不变。
    """
    if shutil.which("claude") is None:
        raise OrcError("PATH 里找不到 claude，发布不了审阅页 → 安装并登录 Claude Code 后再运行 orc step。")
    if url:
        target = (f"这个页面已经发布过，链接是 {url}。先用 Artifact 的 `action: \"read\"` 读这个链接，"
                  "再带上同一个 `url` 发布，更新同一个链接，不要新建；不传 `icon`。")
    else:
        target = "这是第一次发布：不传 `url`，`icon` 用 `checklist`。"
    prompt = (ORC_ROOT / "templates" / "publish-artifact.md").read_text(encoding="utf-8")
    for key, value in (("{{PAGE}}", page), ("{{TARGET}}", target),
                       ("{{DESCRIPTION}}", description)):
        prompt = prompt.replace(key, value)
    argv = ["claude", "-p", "--model", model, "--effort", "low", "--output-format", "json",
            "--permission-mode", "default", "--allowedTools=Read,Artifact"]
    env = dict(os.environ, ORC_ROLE="publish", ORC_MISSION=label)
    try:
        run = subprocess.run(argv, cwd=str(site), input=prompt, capture_output=True, text=True,
                             timeout=600, env=env)
    except subprocess.TimeoutExpired as error:
        raise OrcError("审阅页发布超时（10 分钟）。不要拿本地文件代替链接；稍后再运行 orc step 重试。") from error
    text = run.stdout
    try:
        envelope = json.loads(text)
        if isinstance(envelope, dict) and "result" in envelope:
            text = str(envelope.get("result") or "")
    except ValueError:
        pass
    result = {}
    for line in reversed(text.splitlines()):
        line = line.strip()
        if line.startswith("{") and line.endswith("}"):
            try:
                result = json.loads(line)
                break
            except ValueError:
                continue
    if not str(result.get("url", "")).startswith("https://claude.ai/"):
        detail = result.get("error") or (run.stderr.strip().splitlines() or ["没有输出发布结果"])[-1]
        raise OrcError(f"审阅页发布失败（{str(detail)[:200]}）。不要拿本地文件代替链接去要 go；"
                       "检查 Claude Code 登录后再运行 orc step。")
    return result


def publish_page(label: str, site: Path, receipts_path: Path, route: str, html_text: str, description: str,
                 model: str) -> Tuple[str, Optional[str]]:
    """把 orc 生成的页面发布成 Artifact（之后更新同一个链接）。返回 (链接, 这次新发布时的 sha256；没变就是 None)。"""
    digest = hashlib.sha256(html_text.encode()).hexdigest()
    receipts = json.loads(receipts_path.read_text()) if receipts_path.is_file() else {}
    current = receipts.get(route, {})
    if current.get("sha256") == digest:
        return current["url"], None
    site.mkdir(parents=True, exist_ok=True)
    page = f"{route}.html"
    write_atomic(site / page, html_text)
    result = run_publisher(label, site, page, current.get("url"), description, model)
    receipts[route] = {"url": result["url"], "sha256": digest, "at": now()}
    write_atomic(receipts_path, json.dumps(receipts, ensure_ascii=False, indent=2) + "\n")
    return result["url"], digest


def ensure_published(m: Mission, route: str, html_text: str, description: str) -> str:
    url, digest = publish_page(m.name, m.site_dir(), m.dir / "publish.json", route, html_text, description,
                               m.roles()["plan"]["model"])
    if digest:
        m.append("published", "orc step", route=route, url=url, sha256=digest)
    return url


def published_is_current(m: Mission, route: str) -> bool:
    receipts_path = m.dir / "publish.json"
    if not receipts_path.is_file():
        return False
    digest = hashlib.sha256(render_review(m).encode()).hexdigest()
    return json.loads(receipts_path.read_text()).get(route, {}).get("sha256") == digest


def h_plan_review(m: Mission):
    if m.frozen():
        control = os.path.realpath(m.control)
        if not (m.control / "approved.sha256.sig").is_file():
            return f"sign {control}", False
        problem = verify_approval(m)
        if problem:
            return problem, False
        m.transition("approved", "orc step", reason="签名和哈希校验通过")
        print(f"mission {m.name}：plan-review → approved")
        return None, True
    try:
        url = ensure_published(m, "plan", render_review(m),
                               f"orc mission {m.name} 的计划审阅页：设计、计划、任务 DAG 和要签名的哈希。")
    except OrcError as error:
        return f"error {error}", False
    return f"go-gate {url}", False


def not_yet(phase: str) -> Handler:
    def handler(m: Mission):
        return (f"error {m.state} 阶段的流程还没有实现（PLAN {phase}）。mission {m.name} 停在 {m.state}，"
                f"实现后运行 orc step --mission {m.name} 即可接上。", False)
    return handler


def h_blocked(m: Mission):
    ctx = m.replay()
    qid, back = ctx["question"], ctx["blocked_from"]
    qfile = m.dir / "questions" / f"{qid}.md"
    if not qfile.is_file():
        return (f"error mission {m.name} 停在 blocked，但它的问题文件 {qfile} 不见了。"
                "不要手动解除 blocked；把这条消息告诉用户。"), False
    if qid not in ctx["answered"]:
        if ctx["qtype"] == "mediate":
            return f"mediate {qfile}", False
        return f"ask-user {qfile.read_text().strip()}", False
    m.transition(back, "orc step", reason=f"问题 {qid} 已回答")
    print(f"mission {m.name}：blocked → {back}")
    return None, True


def verify_approval(m: Mission) -> Optional[str]:
    """go 之后冻结的文件：每次都重新校验签名（northstar verify-mission）和哈希（verify-approved-authority.py）。"""
    control = os.path.realpath(m.control)
    northstar = Path(os.environ.get("ORC_NORTHSTAR_ROOT", "/opt/northstar")) / "bin" / "northstar"
    sig = subprocess.run([str(northstar), "verify-mission", control], capture_output=True, text=True)
    if sig.returncode != 0:
        return (f"error mission {m.name} 冻结设计的签名校验失败（{northstar} verify-mission {control}）。"
                "冻结文件或签名被改过，或签名不是你的；不要继续执行，把这条消息告诉用户。")
    hashes = subprocess.run([sys.executable, str(SCRIPTS / "verify-approved-authority.py"), "--control-dir", control],
                            capture_output=True, text=True)
    if hashes.returncode != 0:
        detail = (hashes.stderr.strip().splitlines() or ["无输出"])[-1]
        return (f"error mission {m.name} 的冻结文件和签名时的哈希不一致（{detail}）。"
                "go 之后的设计、计划、DAG 不能改；不要继续执行，把这条消息告诉用户。")
    problem = verify_frozen_checks(m)
    if problem:
        return (f"error mission {m.name} 的冻结验收测试校验失败（{problem}）。"
                "go 之后验收测试不能改；不要继续执行，把这条消息告诉用户。")
    return None


def h_terminal(m: Mission):
    if m.state == "failed":
        last = [e for e in m.events() if e.get("kind") == "state"][-1]
        return f"error mission {m.name} 已失败：{last.get('reason', '原因见 events.jsonl')}。不要手动续跑，把原因告诉用户。", False
    return f"error mission {m.name} 已完成清理，没有可做的步骤。新任务用 orc step --new。", False


# ---------------------------------------------------------------- 执行（阶段 4，STATE.md「执行」）

EXEC_CONFIG = Path(os.environ.get("ORC_EXEC_CONFIG", ORC_ROOT / "config" / "orc.toml"))
EXEC_KEYS = ("max_parallel", "session_timeout_seconds", "crash_retries")
RESULT_REPAIRS = 2              # 执行会话的结果格式不对时，发回同一个会话修的次数
STREAK_FRESH, STREAK_BLOCK = 2, 3   # 连续被拒第 2 次：撤回改动、新开会话；第 3 次：节点 blocked
REVIEW_TIMEOUT = 1800           # 一次对齐评审最多等多久（秒）；超时按「评审服务出错」处理，不放行
NODE_EVENTS = {"node-start", "job-start", "job-exit", "node-blocked", "node-unblocked", "node-reopen",
               "node-parked", "node-unparked", "node-withdrawn"}
ORC_GIT = ["-c", "core.hooksPath=/dev/null", "-c", "user.name=orc", "-c", "user.email=orc@localhost"]


def exec_config(path: Path = EXEC_CONFIG) -> Dict[str, int]:
    if not path.is_file():
        raise OrcError(f"找不到执行配置 {path}。把 orc/config/orc.toml 放回原位再运行。")
    try:
        data = parse_toml(path.read_text(encoding="utf-8"))
    except OrcError:
        raise
    except Exception as error:
        raise OrcError(f"orc.toml 解析失败：{error}。按文件里的注释修正格式。") from error
    section = data.get("execution")
    if not isinstance(section, dict):
        raise OrcError("orc.toml 缺少 [execution] 段。照模板补上。")
    out = {}
    for key in EXEC_KEYS:
        value = str(section.get(key, ""))
        if not value.isdigit():
            raise OrcError(f"orc.toml 的 [execution] {key} 必须是非负整数（写成带引号的字符串），现在是「{value}」。")
        out[key] = int(value)
    if out["max_parallel"] < 1 or out["session_timeout_seconds"] < 1:
        raise OrcError("orc.toml 的 max_parallel 和 session_timeout_seconds 至少是 1。")
    return out


def northstar_root() -> Path:
    return Path(os.environ.get("ORC_NORTHSTAR_ROOT", "/opt/northstar"))


def run_git(cwd, *args, env: Optional[dict] = None, check: bool = True) -> str:
    r = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        raise OrcError(f"git {' '.join(args)}（在 {cwd}）失败：{(r.stderr or r.stdout).strip()}")
    return r.stdout.strip()


def read1(path: Path) -> str:
    return path.read_text(encoding="utf-8").strip() if path.is_file() else ""


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def exec_dir(m: Mission) -> Path:
    return worktrees_root() / m.name


def parent_worktree(m: Mission) -> Path:
    return exec_dir(m) / "integration"


def jobs_dir(m: Mission) -> Path:
    return exec_dir(m) / ".jobs"


def job_file(m: Mission, job: str, ext: str) -> Path:
    return jobs_dir(m) / f"{job}.{ext}"


def mission_branch(m: Mission) -> str:
    return f"orc/{m.name}"


def node_branch(m: Mission, node: str) -> str:
    return f"orc-task/{m.name}/{node}"


def node_ctl(m: Mission, node: str) -> Path:
    return m.control / "tasks" / node


def node_work(m: Mission, node: str) -> Path:
    return m.dir / "nodes" / node


def approved_tasks(m: Mission) -> Dict[str, dict]:
    tasks = json.loads((m.control / "approved-task-dag.json").read_text(encoding="utf-8"))["tasks"]
    return {t["id"]: t for t in tasks}


def approved_checks(m: Mission) -> dict:
    return json.loads((m.control / "approved-checks.json").read_text(encoding="utf-8"))


def node_checks(m: Mission, node: str) -> List[dict]:
    return [c for c in approved_checks(m)["checks"] if c["node"] == node]


def exec_setup(m: Mission) -> Optional[dict]:
    return next((e for e in reversed(m.events()) if e.get("kind") == "exec-setup"), None)


def node_events(m: Mission, node: str) -> List[dict]:
    return [e for e in m.events() if e.get("node") == node and e.get("kind") in NODE_EVENTS]


def job_starts(m: Mission, node: Optional[str] = None, type_: Optional[str] = None) -> List[dict]:
    return [e for e in m.events() if e.get("kind") == "job-start"
            and (node is None or e.get("node") == node) and (type_ is None or e.get("type") == type_)]


def job_exits(m: Mission, node: Optional[str] = None, type_: Optional[str] = None) -> List[dict]:
    return [e for e in m.events() if e.get("kind") == "job-exit"
            and (node is None or e.get("node") == node) and (type_ is None or e.get("type") == type_)]


def running_jobs(m: Mission) -> List[dict]:
    done = {e["job"] for e in job_exits(m)}
    return [s for s in job_starts(m) if s["job"] not in done]


def changed_paths(wt: Path) -> List[str]:
    """worktree 里实际改动的文件（含新建、删除；忽略的文件不算），按仓库相对路径排序。"""
    out = subprocess.run(["git", "-C", str(wt), "status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames"],
                         capture_output=True)
    if out.returncode != 0:
        raise OrcError(f"读不出 {wt} 的改动（{out.stderr.decode(errors='replace').strip()}）。")
    return sorted({item[3:].decode("utf-8") for item in out.stdout.split(b"\0") if len(item) > 3})


def diff_sha256(root: Path, paths: List[str]) -> str:
    """和 commit-broker.sh 的 compute_diff_sha256 同一个算法：broker 据此核对提交的正是评审过的字节。"""
    payload = bytearray()
    for rel in sorted(paths):
        target = root / rel
        if target.is_file() and not target.is_symlink():
            state, mode = b"file", (b"100755" if os.lstat(target).st_mode & 0o111 else b"100644")
            digest = hashlib.sha256(target.read_bytes()).hexdigest().encode("ascii")
        elif not os.path.lexists(target):
            state, mode, digest = b"deleted", b"000000", b""
        else:
            raise OrcError(f"{rel} 不是普通文件，不能提交。")
        payload.extend(rel.encode("utf-8") + b"\0" + state + b"\0" + mode + b"\0" + digest + b"\n")
    return hashlib.sha256(payload).hexdigest()


def pending_diff(wt: Path, paths: List[str]) -> str:
    """这次要提交的改动（含新建文件）。用临时 index 算，不碰 worktree 自己的 index。"""
    import tempfile
    if not paths:
        return ""
    with tempfile.TemporaryDirectory() as tmp:
        env = dict(os.environ, GIT_INDEX_FILE=os.path.join(tmp, "index"))
        run_git(wt, "read-tree", "HEAD", env=env)
        run_git(wt, "add", "-A", "--", *paths, env=env)
        r = subprocess.run(["git", "-C", str(wt), "diff", "--cached", "--no-color", "--no-renames", "HEAD", "--", *paths],
                           capture_output=True, text=True, env=env)
        return r.stdout


def copy_worktree(wt: Path, dest: Path) -> None:
    """把 worktree 当前的内容做成检查用的副本：worktree 的 HEAD 做 git_copy，再盖上没提交的改动
    （已跟踪和未忽略的新文件照 worktree 复制；worktree 里删掉的已跟踪文件，副本里也删掉）。"""
    head = subprocess.run(["git", "-C", str(wt), "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    git_copy(wt, head, dest)
    out = subprocess.run(["git", "-C", str(wt), "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, check=True).stdout
    present = set()
    for rel in {p.decode("utf-8") for p in out.split(b"\0") if p}:
        src = wt / rel
        if src.is_file() and not src.is_symlink():
            (dest / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest / rel)
            present.add(rel)
        elif src.is_symlink():
            present.add(rel)                  # 链接留着 clone 里的那份
    tracked = subprocess.run(["git", "-C", str(dest), "ls-files", "-z"], capture_output=True, check=True).stdout
    for rel in {p.decode("utf-8") for p in tracked.split(b"\0") if p} - present:
        (dest / rel).unlink(missing_ok=True)


def last_json_object(text: str) -> Optional[dict]:
    """取文本里最后一个 JSON 对象（允许外面包着代码块）。"""
    decoder = json.JSONDecoder()
    for i in range(len(text) - 1, -1, -1):
        if text[i] != "{":
            continue
        try:
            obj, end = decoder.raw_decode(text[i:])
        except ValueError:
            continue
        if isinstance(obj, dict) and not text[i + end:].strip().strip("`").strip():
            return obj
    return None


def claude_result(path: Path) -> Tuple[Optional[str], Optional[str]]:
    """读 claude -p --output-format json 的输出：返回 (最后一条消息, 错误)。"""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        return None, f"输出不是 claude --output-format json 的格式（{error}）"
    if not isinstance(data, dict):
        return None, "输出不是 JSON 对象"
    if data.get("is_error"):
        return None, f"claude 报错：{str(data.get('result'))[:300]}"
    return str(data.get("result") or ""), None


# -- 进入 executing：mission 分支、冻结的测试

def setup_execution(m: Mission) -> dict:
    cfg = exec_config()
    repo = m.repo()
    if not (repo / ".northstar" / "NORTHSTAR.md").is_file():
        raise OrcError(f"产品仓库 {repo} 没有 .northstar/NORTHSTAR.md：每次提交前的对齐评审（northstar-review）要对照它。"
                       "先让用户在产品仓库 northstar init 并签好 NORTHSTAR，再运行 orc step。")
    problem = northstar_unsigned(repo)
    if problem:
        raise OrcError(problem)
    approved = approved_checks(m)
    base, branch, parent = approved["base"], mission_branch(m), parent_worktree(m)
    exists = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"],
                            capture_output=True).returncode == 0
    if not exists:
        if parent.exists():
            raise OrcError(f"{parent} 已经存在，但分支 {branch} 不存在：不是 orc 留下的。让用户确认后移走它，再运行 orc step。")
        parent.parent.mkdir(parents=True, exist_ok=True)
        run_git(repo, "worktree", "add", "-q", "-b", branch, str(parent), base)
    elif not parent.is_dir() or run_git(parent, "symbolic-ref", "--short", "HEAD", check=False) != branch:
        raise OrcError(f"分支 {branch} 已经存在，但父 worktree {parent} 不在这个分支上：不是 orc 留下的状态。把这条消息告诉用户。")
    tip = run_git(parent, "rev-parse", "HEAD")
    if tip == base:
        for rel in approved["test_files"]:
            dst = parent / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(m.control / "approved-tests" / rel, dst)
        run_git(parent, "add", "--", *approved["test_files"])
        clauses = sorted({c for t in approved_tasks(m).values() for c in t.get("clauses", [])}, key=lambda c: int(c[1:]))
        prefix = f"[{','.join(clauses)}]" if clauses else "[orc]"
        run_git(parent, *ORC_GIT, "commit", "-q", "-m", f"{prefix} orc：冻结 mission {m.name} 的验收测试")
        tip = run_git(parent, "rev-parse", "HEAD")
    elif run_git(parent, "rev-parse", "HEAD^", check=False) != base:
        raise OrcError(f"mission 分支 {branch} 上有 orc 不认识的提交（{tip[:12]}）。把这条消息告诉用户。")
    for rel, digest in approved["test_files"].items():
        if sha256_file(parent / rel) != digest:
            raise OrcError(f"mission 分支上的验收测试 {rel} 和签名时的哈希不一致。把这条消息告诉用户。")
    return m.append("exec-setup", "orc step", base=base, branch=branch, parent_worktree=os.path.realpath(parent),
                    tests_commit=tip, config=cfg)


def h_approved(m: Mission):
    if exec_setup(m) is None:
        setup_execution(m)
    m.transition("executing", "orc step", reason="签名有效，开始调度节点")
    print(f"mission {m.name}：approved → executing")
    return None, True


# -- 后台任务

def launch_job(m: Mission, type_: str, node: str, argv: List[str], cwd, stdin_text: str = "",
               env_extra: Optional[dict] = None, **fields) -> str:
    jobs_dir(m).mkdir(parents=True, exist_ok=True)
    job = f"{node}.{type_}.{len(job_starts(m, node, type_)) + 1}"
    write_atomic(job_file(m, job, "in"), stdin_text)
    wrapper = ('"$@" < "$ORC_RUN_IN" > "$ORC_RUN_OUT" 2> "$ORC_RUN_ERR"; '
               'echo $? > "$ORC_RUN_RC.tmp" && mv "$ORC_RUN_RC.tmp" "$ORC_RUN_RC"')
    env = dict(os.environ, ORC_MISSION=m.name, ORC_RUN_IN=str(job_file(m, job, "in")),
               ORC_RUN_OUT=str(job_file(m, job, "out")), ORC_RUN_ERR=str(job_file(m, job, "err")),
               ORC_RUN_RC=str(job_file(m, job, "rc")))
    env.update(env_extra or {})
    proc = subprocess.Popen(["sh", "-c", wrapper, f"orc-job-{m.name}-{job}", *argv], cwd=str(cwd), env=env,
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)
    m.append("job-start", "orc step", job=job, type=type_, node=node, pid=proc.pid, **fields)
    return job


def job_status(m: Mission, start: dict) -> Tuple[str, Optional[int]]:
    """(running | done | lost, 退出码)。拿不准就当它还在运行（REUSE.md）。"""
    rc_file = job_file(m, start["job"], "rc")
    if rc_file.is_file():
        text = rc_file.read_text().strip()
        return "done", int(text) if text.lstrip("-").isdigit() else None
    if process_alive(start["pid"], f"orc-job-{m.name}-{start['job']}"):
        return "running", None
    return "lost", None


def job_age_seconds(start: dict) -> float:
    started = _dt.datetime.fromisoformat(start["ts"])
    return (_dt.datetime.now().astimezone() - started).total_seconds()


def session_overdue(start: dict, cfg: dict) -> bool:
    """模型会话（执行会话的一轮、判断测试对错）超过 session_timeout_seconds 就算超时。"""
    return start["type"] in ("executor", "dispute", "notes") and job_age_seconds(start) > cfg["session_timeout_seconds"]


def kill_job(start: dict) -> None:
    import signal
    try:
        os.killpg(start["pid"], signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass


def orc_self(*args: str) -> List[str]:
    return [sys.executable, str(Path(__file__).resolve()), *args]


# -- 节点的准备和执行会话

def start_node(m: Mission, node: str) -> None:
    """开分支和 worktree，按复用脚本的约定写控制文件。可以重复运行（中断后接上）。"""
    repo, parent, wt = m.repo(), parent_worktree(m), m.worktree(node)
    ctl, work = node_ctl(m, node), node_work(m, node)
    branch = node_branch(m, node)
    if not wt.exists():
        base = run_git(parent, "rev-parse", "HEAD")
        if subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"],
                          capture_output=True).returncode == 0:
            raise OrcError(f"分支 {branch} 已经存在，但节点 worktree {wt} 不存在：不是 orc 留下的状态。把这条消息告诉用户。")
        wt.parent.mkdir(parents=True, exist_ok=True)
        run_git(repo, "worktree", "add", "-q", "-b", branch, str(wt), base)
    else:
        if run_git(wt, "symbolic-ref", "--short", "HEAD", check=False) != branch:
            raise OrcError(f"{wt} 已经存在，但不在分支 {branch} 上：不是 orc 留下的。把这条消息告诉用户。")
        manifest = read1(ctl / "worktrees.txt")
        base = manifest.split("\t")[2] if manifest.count("\t") == 3 else run_git(wt, "merge-base", "HEAD", mission_branch(m))
    wtr = os.path.realpath(wt)
    ctl.mkdir(parents=True, exist_ok=True)
    work.mkdir(parents=True, exist_ok=True)
    row = f"{wtr}\t{branch}\t{base}\t{os.path.realpath(repo)}\n"
    for d in (ctl, work):
        write_atomic(d / "worktrees.txt", row)
    write_atomic(ctl / "task-state-dir", os.path.realpath(work) + "\n")
    if not (ctl / "generation").is_file():
        write_atomic(ctl / "generation", "1\n")
        write_atomic(ctl / "accepted-thread-id", str(__import__("uuid").uuid4()) + "\n")
        write_atomic(ctl / "outcome-nonce", __import__("uuid").uuid4().hex + "\n")
    for d in (ctl, work):
        if not (d / "state").is_file():
            write_atomic(d / "state", "ready\n")
    write_atomic(work / "entry.json", json.dumps(approved_tasks(m)[node], ensure_ascii=False, indent=2) + "\n")
    m.append("node-start", "orc step", node=node, base=base, branch=branch, worktree=wtr)
    print(f"节点 {node}：已开出 {branch}（{wtr}）")


def repo_git_dir(m: Mission) -> str:
    common = Path(run_git(m.repo(), "rev-parse", "--git-common-dir"))
    return os.path.realpath(common if common.is_absolute() else m.repo() / common)


DONE_OUTCOMES = ("committed", "satisfied")     # satisfied：验收标准已被之前的提交满足，检查确认过，没有新提交


def done_acceptance(m: Mission, node: str) -> List[int]:
    done = set()
    for e in job_exits(m, node, "gate"):
        if e.get("outcome") in DONE_OUTCOMES:
            done.update(e.get("acceptance", []))
    return sorted(done)


def remaining_acceptance(m: Mission, node: str) -> List[int]:
    n = len(approved_tasks(m)[node].get("acceptance", []))
    return [i for i in range(1, n + 1) if i not in done_acceptance(m, node)]


def acceptance_lines(m: Mission, node: str, which: Optional[List[int]] = None) -> str:
    items = approved_tasks(m)[node].get("acceptance", [])
    which = which if which is not None else list(range(1, len(items) + 1))
    return "\n".join(f"{i}. {items[i - 1]}" for i in which if 1 <= i <= len(items))


def executor_prompt(m: Mission, node: str, extra: Optional[str]) -> str:
    task = approved_tasks(m)[node]
    done = done_acceptance(m, node)
    bullets = lambda xs: "\n".join(f"  - `{x}`" for x in xs) or "  - （无）"
    acceptance = "\n".join(f"  {i}. {a}" + ("（已提交）" if i in done else "")
                           for i, a in enumerate(task.get("acceptance", []), 1))
    checks = "\n".join(f"  - `{c['id']}`（验收标准 {', '.join(map(str, c['acceptance']))}）：`{c['command']}`"
                       for c in node_checks(m, node)) or "  - （无）"
    values = {"{{MISSION}}": m.name, "{{NODE}}": node, "{{WORKTREE}}": os.path.realpath(m.worktree(node)),
              "{{BRIEF_EXEC}}": (m.control / "brief-exec.md").read_text(encoding="utf-8").strip(),
              "{{FILES}}": bullets(task.get("files", [])), "{{CONTRACTS}}": bullets(task.get("contracts", [])),
              "{{CLAUSES}}": "、".join(task.get("clauses", [])) or "（无）", "{{ACCEPTANCE}}": acceptance,
              "{{CHECKS}}": checks, "{{DESIGN}}": (m.control / "approved-design.md").read_text(encoding="utf-8").strip()}
    text = (ORC_ROOT / "templates" / "executor-brief.md").read_text(encoding="utf-8")
    for key, value in values.items():
        text = text.replace(key, value)
    return text + (f"\n\n---\n\n{extra}" if extra else "")


def launch_executor(m: Mission, node: str, message: Optional[str], fresh: bool = False) -> None:
    """后台启动执行会话的一轮。第一次和 fresh 时新开会话（fresh 时 generation 加 1），否则 --resume 同一个会话。"""
    if shutil.which("claude") is None:
        raise OrcError("PATH 里找不到 claude，启动不了执行会话 → 安装 Claude Code 后再运行 orc step。")
    cfg, ctl = m.roles()["implement"], node_ctl(m, node)
    if fresh:
        write_atomic(ctl / "generation", f"{int(read1(ctl / 'generation')) + 1}\n")
        write_atomic(ctl / "accepted-thread-id", str(__import__("uuid").uuid4()) + "\n")
        write_atomic(ctl / "outcome-nonce", __import__("uuid").uuid4().hex + "\n")
    session, generation = read1(ctl / "accepted-thread-id"), int(read1(ctl / "generation"))
    used = any(s.get("session") == session for s in job_starts(m, node, "executor"))
    mode = "resume" if used else "new"
    prompt = message if used else executor_prompt(m, node, message)
    wt = os.path.realpath(m.worktree(node))
    # 实测（proposals/2026-11-07-stop-gate-implement.md）：沙箱里 Bash 写不了 worktree 以外（临时目录除外）、不能联网；
    # 主仓库 .git denyWrite 后 git 只读，提交只能走提交关口和 broker；Write / Edit 用权限规则限制在 worktree 里
    settings = {"sandbox": {"enabled": True, "failIfUnavailable": True, "allowUnsandboxedCommands": False,
                            "filesystem": {"denyWrite": [repo_git_dir(m)]}}}
    tools = ["Read", "Glob", "Grep", "Bash"] + [f"{t}(/{wt}/**)" for t in ("Write", "Edit", "MultiEdit")]
    argv = ["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
            "--permission-mode", "default", f"--settings={json.dumps(settings)}", f"--allowedTools={','.join(tools)}"]
    argv += ["--session-id", session] if mode == "new" else ["--resume", session]
    # ORC_ROLE=implement：信任层的 Stop hook 据此放行未提交的改动（提交由 orc 做）；不写字节码和 pytest 缓存，免得弄脏 worktree
    # ORC_MISSION_CONTROL：信任层的 northstar-scope 验过这个目录的签名后，从冻结的 brief-exec.md 读 scope 和 forbid
    env = {"ORC_ROLE": "implement", "ORC_NODE": node, "PYTHONDONTWRITEBYTECODE": "1", "PYTEST_ADDOPTS": "-p no:cacheprovider",
           "ORC_MISSION_CONTROL": os.path.realpath(m.control)}
    launch_job(m, "executor", node, argv, wt, prompt, env, session=session, mode=mode, generation=generation)
    print(f"节点 {node}：已启动执行会话（{mode}，第 {generation} 代，模型 {cfg['model']}）")


def validate_executor_result(m: Mission, node: str, obj: Optional[dict]) -> List[str]:
    if obj is None:
        return ["最后一条消息里没有 JSON 对象。结束一轮时最后只输出一个 JSON 对象（见 brief 的「怎么工作」）"]
    status = obj.get("status")
    task = approved_tasks(m)[node]
    if status == "commit":
        problems = []
        acc, files, message = obj.get("acceptance"), obj.get("files"), obj.get("message")
        n = len(task.get("acceptance", []))
        if not isinstance(acc, list) or not all(isinstance(a, int) and not isinstance(a, bool) and 1 <= a <= n for a in acc):
            problems.append(f"acceptance 必须是 1 到 {n} 之间的编号列表")
        elif not acc and not (node_ctl(m, node) / "unresolved-rework").exists():
            problems.append("acceptance 不能为空：写这次完成的验收标准编号（只有整体评审打回后的 rework 提交可以为空）")
        if not isinstance(message, str) or not message.strip() or "\0" in message:
            problems.append("message 必须是一句非空的提交说明")
        if not isinstance(obj.get("notes", ""), str):
            problems.append("notes（遗留问题）必须是字符串，没有就写空字符串")
        actual = changed_paths(m.worktree(node))
        if not actual and isinstance(files, list) and files:
            problems.append("worktree 里没有任何改动，但 files 不是空的")
        if not actual and not acc:
            problems.append("worktree 里没有任何改动，也没有写已经满足的验收标准：没有可提交、可确认的东西")
        if not isinstance(files, list) or not all(isinstance(f, str) for f in files):
            problems.append("files 必须是文件路径列表")
        elif set(files) != set(actual):
            problems.append(f"files 和 worktree 里实际改动的文件不一致：你写的是 {sorted(set(files))}，实际是 {actual}。"
                            "把多出来的文件删掉，或者把它们写进 files")
        return problems
    if status == "question":
        q = obj.get("question")
        return [] if isinstance(q, str) and q.strip() else ["question 必须是一个非空的问题"]
    if status == "test-wrong":
        ids = {c["id"] for c in node_checks(m, node)}
        problems = []
        if obj.get("check") not in ids:
            problems.append(f"check 必须是你这个节点的冻结检查 id 之一：{sorted(ids)}")
        if not isinstance(obj.get("reason"), str) or not obj["reason"].strip():
            problems.append("reason 必须写明为什么认为测试本身有错")
        return problems
    if status == "outside":
        if not isinstance(obj.get("reason"), str) or not obj["reason"].strip():
            return ["reason 必须写明问题在哪、为什么不在你的文件里"]
        return []
    return [f"status 只能是 commit、question、test-wrong 或 outside，不是「{status}」"]


# -- 提交关口和整体评审：后台任务，不拿生命周期锁（broker 和 integrate-task 自己拿）

def write_card(m: Mission, node: str, category: str, detail: str, which: Optional[List[int]]) -> Path:
    work = node_work(m, node)
    k = len(list(work.glob("correction-*.md"))) + 1
    labels = {"scope": "文件范围", "tests": "冻结的验收测试被改动", "checks": "冻结的检查没有通过", "drift": "对齐评审判定偏离（DRIFT）",
              "too-large": "改动超过评审上限", "broker": "commit broker 拒绝", "worktree": "worktree 不干净",
              "cheat": "修复里有判断「是不是在跑测试」的写法", "repair-review": "修复评审没通过"}
    text = (f"# 纠偏单：节点 {node}，第 {k} 张\n\n## 被拒的原因：{labels.get(category, category)}\n\n{detail.strip()}\n\n"
            f"## 相关验收标准（原文）\n\n{acceptance_lines(m, node, which or None) or '（无）'}\n\n"
            "按这张纠偏单改。不要改测试或检查来让它通过；认为冻结的测试本身有错时，用 test-wrong 结束这一轮。\n")
    path = work / f"correction-{k}.md"
    write_atomic(path, text)
    return path


def call_review(m: Mission, node: str, wt: Path, diff: str, role: str, checks_text: str,
                prev: Optional[str]) -> Tuple[str, str]:
    """调用信任层的 northstar-review（和提交前 hook 同一个入口）。返回 (aligned | drift | too-large | unavailable, 原文)。"""
    import tempfile
    review = northstar_root() / "bin" / "northstar-review"
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False, encoding="utf-8") as f:
        f.write(checks_text)
        checks_file = f.name
    argv = [str(review), "--entry", str(node_work(m, node) / "entry.json"),
            "--design", str(m.control / "approved-design.md"), "--checks", checks_file, "--role", role]
    if prev:
        argv += ["--prev", prev]
    try:
        run = subprocess.run(argv, input=diff, cwd=str(wt), capture_output=True, text=True, timeout=REVIEW_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        return "unavailable", f"northstar-review 没能运行（{error}）"
    finally:
        os.unlink(checks_file)
    if run.returncode == 0:
        return "aligned", run.stdout.strip()
    if run.returncode == 1:
        return "drift", run.stdout.strip()
    if "超过评审上限" in run.stderr:
        return "too-large", run.stderr.strip()
    return "unavailable", (run.stderr or run.stdout).strip() or f"northstar-review 退出码 {run.returncode}"


def prior_drift(m: Mission, node: str) -> Optional[str]:
    """上一次评审被判 DRIFT（之后还没有 ALIGNED）时，返回它的原因：复审要用 review 模型并确认已经消除。"""
    for e in reversed([e for e in m.events() if e.get("kind") == "review" and e.get("node") == node]):
        return e.get("reason") if e.get("verdict") == "DRIFT" else None
    return None


def passed_checks(m: Mission, node: str) -> List[str]:
    ids: List[str] = []
    for e in job_exits(m, node, "gate"):
        if e.get("outcome") in DONE_OUTCOMES:
            ids += [cid for cid, ok in e.get("checks", {}).items() if ok and cid not in ids]
    return ids


def run_node_checks(m: Mission, wt: Path, ids: List[str], where: Path) -> Tuple[Dict[str, bool], List[dict], str]:
    checks = [c for c in approved_checks(m)["checks"] if c["id"] in ids]
    copy_worktree(wt, where)
    try:
        results = run_check_commands(where, checks)
    finally:
        shutil.rmtree(where, ignore_errors=True)
    verdict = lambda r: "通过" if r["rc"] == 0 else f"没通过，退出码 {r['rc']}"
    text = "\n".join(f"- {r['id']}（{r['command']}）：{verdict(r)}" for r in results)
    return {r["id"]: r["rc"] == 0 for r in results}, results, text


def failed_detail(results: List[dict]) -> str:
    return "\n\n".join(f"检查 `{r['id']}`（`{r['command']}`）没通过，退出码 {r['rc']}。输出最后几行：\n\n```\n"
                       + "\n".join(r["tail"]) + "\n```" for r in results if r["rc"] != 0)


IMPORT_ERROR_RE = re.compile(r"no module named|cannot import|importerror|modulenotfounderror|failed to import|could not import",
                             re.I)


def gate_dag_crossing(m: Mission, node: str, wt: Path, results: List[dict]) -> Optional[str]:
    """提交关口的兜底：失败的检查输出里有导入错误，错误里的模块是别的节点新建、而那个节点不是本节点的前置节点
    （所以节点工作区里没有这个文件）。这是冻结的测试越过了依赖，执行会话怎么改都过不了。"""
    tasks = approved_tasks(m)
    allowed = node_ancestors(tasks, node) | {node}
    base = read1(node_ctl(m, node) / "worktrees.txt").split("\t")[2]
    at_base = set(run_git(m.repo(), "ls-tree", "-r", "--name-only", base).splitlines())
    foreign = {}
    for tid, t in tasks.items():
        if tid in allowed:
            continue
        for f in t.get("files", []):
            if f not in at_base and not (wt / f).exists():
                foreign.setdefault(f, []).append(tid)
    found = []
    test_files = list(approved_checks(m)["test_files"])
    for r in results:
        if r["rc"] == 0:
            continue
        # 只认冻结的测试自己写着这个模块的：实现代码去导入别的节点的文件，是执行会话的错，照常退回
        mentioned = " ".join((wt / t).read_text(encoding="utf-8", errors="replace")
                             for t in check_test_files(r["command"], test_files) if (wt / t).is_file())
        for line in r.get("tail", []):
            if not IMPORT_ERROR_RE.search(line):
                continue
            text = line
            pair = re.search(r"cannot import name '(\w+)' from '([\w.]+)'", line)
            if pair:
                text += f" {pair.group(2)}.{pair.group(1)}"
            for path, who in foreign.items():
                names = [n for n in module_names(path) if n in mentioned]
                if any(re.search(rf"(?<![\w.]){re.escape(n)}(?!\w)", text) for n in names) \
                        and (r["id"], path) not in [(c, p) for c, p, _, _ in found]:
                    found.append((r["id"], path, who, line.strip()))
    if not found:
        return None
    before = "、".join(sorted(allowed - {node})) or "无"
    return "\n".join(f"检查 `{cid}` 失败在导入 {path} 上（`{line[:200]}`）：这个文件由节点 {'、'.join(who)} 新建，"
                     f"那个节点不是 {node} 的前置节点（{node} 的前置节点：{before}）。" for cid, path, who, line in found)


def repair_gate(m: Mission, node: str, wt: Path, job: str, repair: dict,
                actual: List[str]) -> Tuple[Optional[Tuple[str, str]], dict]:
    """修复关口（修复闭环）：在普通提交关口之外，证明修好了、证明是这处修复修好的、不许判断是否在跑测试、评审核对改动和诊断一致。
    返回 (问题, 记录)：问题是 (纠偏类别, 说明)，或 ("unavailable", 原因)；没问题是 None。"""
    record: dict = {"job": repair.get("job")}
    checks = [c for c in (check_command(m, cid) for cid in repair.get("checks", [])) if c]
    rp = repair.get("repro")
    if rp:                       # 诊断写的复现：和失败的检查一样，修复后要通过、撤掉修复要失败
        checks.append({"id": "repro", "command": rp["command"], "repro": {"file": rp["file"], "path": rp["path"]}})
    run = lambda where, cs: [run_repro(where, c) if c.get("repro") else run_check_commands(where, [c])[0] for c in cs]
    copy = jobs_dir(m) / f"{job}.repair"
    if not checks:
        record["runs"] = "没有可重跑的失败检查（问题来自停下的节点或 CI），最终审查会把全部检查各跑 3 次"
    elif not repair.get("solo"):
        record["runs"] = "这次修复涉及几个节点，单个节点上证明不了；最终审查会把全部检查各跑 3 次"
    else:
        copy_worktree(wt, copy)
        try:
            after, tails = {c["id"]: 0 for c in checks}, {}
            for _ in range(DIAG_RUNS):
                for r in run(copy, checks):
                    if r["rc"] != 0:
                        after[r["id"]] += 1
                        tails[r["id"]] = r["tail"]
        finally:
            shutil.rmtree(copy, ignore_errors=True)
        record["after"] = {cid: {"fails": n, "runs": DIAG_RUNS} for cid, n in after.items()}
        bad = {cid: n for cid, n in after.items() if n}
        if bad:
            return ("checks", "修复之后，诊断时失败的检查连跑 " + str(DIAG_RUNS) + " 次还会失败："
                    + "；".join(f"`{cid}` 失败 {n} 次，最后一次输出：\n```\n" + "\n".join(tails[cid]) + "\n```"
                               for cid, n in bad.items())), record
        base = read1(node_ctl(m, node) / "worktrees.txt").split("\t")[2]
        if base == repair["tip"] and repair.get("fails", 0) > 0:
            # 节点的基线就是诊断时的提交：撤掉这处修复就是那个提交，诊断时已经在上面测到过失败
            record["revert"] = {"base": base, "fails": repair["fails"], "runs": repair["runs"], "measured": "诊断时在同一个提交上"}
        else:
            git_copy(m.repo(), base, copy)
            try:
                fails = runs = 0
                while runs < REVERT_MAX_RUNS and not fails:
                    runs += 1
                    fails += any(r["rc"] != 0 for r in run(copy, checks))
            finally:
                shutil.rmtree(copy, ignore_errors=True)
            record["revert"] = {"base": base, "fails": fails, "runs": runs, "measured": "撤掉修复后重跑"}
            if not fails:
                return ("unavailable", f"撤掉修复（回到 {base[:12]}）后，诊断时失败的检查连跑 {runs} 次都通过了，证明不了是这处修复修好的。"
                        "可能是环境变了或者失败极少出现；排除后回答「重试」。"), record
    tests = set(approved_checks(m)["test_files"])
    stems = {Path(t).stem for t in tests}
    test_like = lambda f: f in tests or Path(f).name == "conftest.py" or any(p.startswith("test") for p in Path(f).parts)
    code = [f for f in actual if not test_like(f)]
    added = [line[1:] for line in pending_diff(wt, code).splitlines() if line.startswith("+") and not line.startswith("+++")]
    hits = [line.strip() for line in added if TEST_DETECT_RE.search(line) or any(st in line for st in stems)]
    if hits:
        return ("cheat", "修复改动的非测试代码里出现了和测试有关的写法（判断是不是在跑测试、引用测试文件），修复不能针对测试：\n"
                + "\n".join(f"- `{h[:200]}`" for h in hits[:10])), record
    verdict, reason = repair_review(m, repair, pending_diff(wt, actual))
    record["review"] = {"verdict": verdict, "reason": reason[:1500]}
    if verdict == "reject":
        return ("repair-review", reason), record
    if verdict == "unavailable":
        return ("unavailable", f"修复评审没能完成（{reason}）。评审出错时不放行；排除问题后回答「重试」。"), record
    return None, record


def repair_review(m: Mission, repair: dict, diff: str) -> Tuple[str, str]:
    """review 模型核对修复：改动是不是诊断说的那件事、有没有别的改动、有没有改变别的节点承诺过的行为。返回 (ok | reject | unavailable, 理由)。"""
    import tempfile
    values = {"{{MISSION}}": m.name, "{{CAUSE}}": repair.get("cause", ""), "{{CHANGE}}": repair.get("change", ""),
              "{{FILES}}": "、".join(repair.get("files", [])),
              "{{DESIGN}}": (m.control / "approved-design.md").read_text(encoding="utf-8").strip(),
              "{{DAG}}": json.dumps(list(approved_tasks(m).values()), ensure_ascii=False, indent=2),
              "{{DIFF}}": f"```diff\n{diff}\n```"}
    prompt = (ORC_ROOT / "templates" / "repair-review-brief.md").read_text(encoding="utf-8")
    for key, value in values.items():
        prompt = prompt.replace(key, value)
    cfg = m.roles()["review"]
    cwd = Path(tempfile.mkdtemp(prefix="orc-repair-review."))
    try:
        run = subprocess.run(["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
                              "--tools", ""], input=prompt, cwd=str(cwd), capture_output=True, text=True,
                             timeout=REVIEW_TIMEOUT, env=dict(os.environ, ORC_ROLE="repair-review"))
        write_atomic(cwd / "out.json", run.stdout)
        text, error = claude_result(cwd / "out.json") if run.returncode == 0 else (None, f"退出码 {run.returncode}")
    except subprocess.TimeoutExpired:
        text, error = None, f"超过 {REVIEW_TIMEOUT} 秒没有结束"
    finally:
        shutil.rmtree(cwd, ignore_errors=True)
    obj = last_json_object(text) if text is not None else None
    if error or not obj or obj.get("verdict") not in ("ok", "reject"):
        return "unavailable", error or "没有按格式给出 verdict"
    return obj["verdict"], str(obj.get("reason", ""))


def run_gate(m: Mission, node: str, job: str, result: dict) -> dict:
    """提交关口（STATE.md）：文件范围 → 测试哈希 → 检查 → 对齐评审 → 写提交请求、运行 broker。"""
    task, approved = approved_tasks(m)[node], approved_checks(m)
    wt = Path(os.path.realpath(m.worktree(node)))
    work, ctl = node_work(m, node), node_ctl(m, node)
    declared = result.get("acceptance", [])
    out: dict = {"acceptance": declared, "checks": {}}

    def reject(category: str, detail: str) -> dict:
        card = write_card(m, node, category, detail, declared)
        return {**out, "outcome": "rejected", "category": category, "reason": detail.strip().splitlines()[0][:300],
                "card": str(card)}

    actual = changed_paths(wt)
    tests = set(approved["test_files"])
    touched = sorted(set(actual) & tests)
    if touched:
        return reject("tests", "改动了冻结的验收测试（只能读，不能改、删、移动）：" + "、".join(touched))
    outside = sorted(set(actual) - set(task.get("files", [])))
    if outside:
        return reject("scope", "改动了声明文件以外的文件：" + "、".join(outside) + "。只能改：" + "、".join(task.get("files", [])))
    repair = json.loads(read1(ctl / "repair.json") or "null")
    if repair:                   # 修复闭环：只放行诊断指定的文件
        extra = sorted(set(actual) - set(repair["files"]))
        if extra:
            return reject("scope", f"这是按诊断做的修复，只能改诊断指定的文件：{'、'.join(repair['files'])}。多改了："
                          + "、".join(extra) + "。认为要改别的文件，用 outside 结束这一轮并说明。")
    for rel, digest in approved["test_files"].items():
        p = wt / rel
        if p.is_symlink() or not p.is_file() or sha256_file(p) != digest:
            return reject("tests", f"冻结的验收测试 {rel} 和签名时的哈希不一致")
    if declared:
        ids = [c["id"] for c in node_checks(m, node) if set(c["acceptance"]) & set(declared)]
    else:
        ids = [c["id"] for c in node_checks(m, node)]          # rework 提交：本节点全部检查
    ids += [cid for cid in passed_checks(m, node) if cid not in ids]   # 此前通过的检查一起跑，防回退
    out["checks"], results, checks_text = run_node_checks(m, wt, ids, jobs_dir(m) / f"{job}.copy")
    if not all(out["checks"].values()):
        crossing = gate_dag_crossing(m, node, wt, results)
        if crossing:             # 冻结的测试越过了依赖：执行会话改不了，不退回给它
            return {**out, "outcome": "test-crosses-dag", "reason": crossing}
        return reject("checks", failed_detail(results))
    if not actual and repair:
        # 修复必须有改动：没有改动就绕过了修复关口，集成时也没有东西可合（子提交和父提交相同，集成脚本会卡住）
        return reject("scope", f"这是按诊断做的修复，但没有任何改动。诊断要改的文件：{'、'.join(repair['files'])}。"
                      "认为问题不在这些文件里，用 outside 结束这一轮并说明。")
    if not actual:
        # 这条验收标准已经被之前的提交满足：冻结的检查确认过，没有 diff 可评审，也没有东西可提交
        return {**out, "outcome": "satisfied"}
    if repair:
        problem, out["repair"] = repair_gate(m, node, wt, job, repair, actual)
        if problem and problem[0] == "unavailable":
            return {**out, "outcome": "unavailable", "reason": problem[1][:500]}
        if problem:
            return reject(*problem)
    diff = pending_diff(wt, actual)
    prev = prior_drift(m, node)
    verdict, text = call_review(m, node, wt, diff, "auto", checks_text, prev)
    out["review"] = {"verdict": verdict, "text": text[:2000], "prev": bool(prev)}
    if verdict == "drift":
        return reject("drift", text)
    if verdict == "too-large":
        return reject("too-large", text + "\n\n评审不截断：按验收标准拆成更小的提交。")
    if verdict == "unavailable":
        return {**out, "outcome": "unavailable", "reason": text[:500]}
    # 评审通过：写提交请求交给复用的 broker。diff_sha256 把提交绑定到评审过的字节
    base = read1(ctl / "worktrees.txt").split("\t")[2]
    clauses = task.get("clauses", [])
    # 执行会话常按仓库的提交约定自己带上 [N#]（实测 2026-11-08）；条款标签由 orc 统一加，去掉它带的，免得重复
    # 节点名也一样：实测（2026-11-08，mission calc-ops）执行会话写了「multiply：…」，orc 再加一次就成了「multiply：multiply：…」
    text_ = re.sub(r"^\[[^\]]*\]\s*", "", result["message"].strip())
    text_ = re.sub(rf"^{re.escape(node)}\s*[:：]\s*", "", text_)
    message = f"[{','.join(clauses)}] {node}：{text_}" if clauses else f"[orc] {node}：{text_}"
    digest = hashlib.sha256(json.dumps({"job": job, "result": result}, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
    numbers = [int(p.stem.rsplit("-", 1)[1]) for p in work.glob("COMMIT-*-*.json") if p.stem.rsplit("-", 1)[1].isdigit()]
    n = max(numbers, default=0) + 1
    request = {"accepted_thread_id": read1(ctl / "accepted-thread-id"), "base_sha": base,
               "diff_sha256": diff_sha256(wt, actual), "generation": int(read1(ctl / "generation")),
               "message": message, "outcome_digest": digest, "outcome_nonce": read1(ctl / "outcome-nonce"),
               "paths": actual, "protocol_version": 1, "task_id": node, "worktree": str(wt)}
    write_atomic(ctl / "latest-outcome", digest + "\n")
    for d in (ctl, work):
        write_atomic(d / "state", "ready_for_commit\n")
    write_atomic(work / f"COMMIT-REQUEST-{n}.json", json.dumps(request, ensure_ascii=False) + "\n")
    try:
        broker = subprocess.run(["bash", str(SCRIPTS / "commit-broker.sh"), "--mission-dir", os.path.realpath(work),
                                 "--control-dir", os.path.realpath(ctl), "--once"],
                                capture_output=True, text=True, timeout=600)
        broker_err = (broker.stderr or broker.stdout).strip()
    except subprocess.TimeoutExpired:
        broker_err = "commit broker 超过 600 秒没有结束"
    finally:
        for d in (ctl, work):
            write_atomic(d / "state", "ready\n")
        (work / f"COMMIT-REQUEST-{n}.json").rename(work / f"processed-COMMIT-REQUEST-{n}.json")
    done, rejected = work / f"COMMIT-DONE-{n}.json", work / f"COMMIT-REJECTED-{n}.json"
    if done.is_file():
        return {**out, "outcome": "committed", "sha": json.loads(done.read_text())["hash"], "files": actual,
                "message": message}
    if rejected.is_file():
        return reject("broker", json.loads(rejected.read_text()).get("reason", "commit broker 拒绝了提交"))
    return {**out, "outcome": "unavailable", "reason": f"commit broker 没有给出结论：{broker_err[-500:]}"}


def run_submit(m: Mission, node: str, job: str) -> dict:
    """整体评审（STATE.md）：节点最新提交上跑全部冻结检查，再用 review 模型对照签名的设计评审累计 diff。"""
    wt = Path(os.path.realpath(m.worktree(node)))
    base = read1(node_ctl(m, node) / "worktrees.txt").split("\t")[2]
    head = run_git(wt, "rev-parse", "HEAD")
    out: dict = {"head": head, "checks": {}}

    def rework(category: str, detail: str) -> dict:
        card = write_card(m, node, category, detail, None)
        return {**out, "outcome": "rework", "category": category, "reason": detail.strip().splitlines()[0][:300],
                "card": str(card)}

    dirty = changed_paths(wt)
    if dirty:
        return rework("worktree", "worktree 里还有没提交的文件：" + "、".join(dirty) + "。删掉多余的文件，或者把它们作为一次提交交上来")
    ids = [c["id"] for c in node_checks(m, node)]
    out["checks"], results, checks_text = run_node_checks(m, wt, ids, jobs_dir(m) / f"{job}.copy")
    if not all(out["checks"].values()):
        return rework("checks", failed_detail(results))
    diff = run_git(wt, "diff", "--no-color", "--no-renames", f"{base}..{head}")
    verdict, text = call_review(m, node, wt, diff, "review", checks_text, None)
    out["review"] = {"verdict": verdict, "text": text[:2000]}
    if verdict == "aligned":
        return {**out, "outcome": "aligned"}
    if verdict == "drift":
        return rework("drift", text)
    return {**out, "outcome": "unavailable", "reason": text[:500]}


def cmd_gate(args) -> int:
    m = Mission(args.mission)
    data = json.loads(sys.stdin.read())
    if args.kind == "gate":
        outcome = run_gate(m, data["node"], args.job, data["result"])
    elif args.kind == "submit":
        outcome = run_submit(m, data["node"], args.job)
    elif args.kind == "final":
        outcome = run_final(m, args.job, data["tip"])
    elif args.kind == "cross":
        outcome = run_cross(m, args.job, data["tip"])
    elif args.kind == "diagnose":
        try:
            outcome = run_diagnose(m, args.job, data)
        except Exception as error:   # 出错也要留下结论：unavailable 会停下问用户，而不是无限重新诊断
            outcome = {"tip": data.get("tip"), "trigger": data.get("trigger"), "source": data.get("source"),
                       "failed": data.get("failed", []), "facts": [], "outcome": "unavailable",
                       "reason": f"诊断出错：{type(error).__name__}: {str(error)[:400]}"}
    else:
        outcome = run_ci(m, args.job, data["pr"], data["tip"])
    write_atomic(job_file(m, args.job, "result.json"), json.dumps(outcome, ensure_ascii=False) + "\n")
    return 0


def launch_gate(m: Mission, node: str, result: dict) -> None:
    launch_job(m, "gate", node, orc_self("gate", "--kind", "gate", "--mission", m.name, "--job",
                                         f"{node}.gate.{len(job_starts(m, node, 'gate')) + 1}"),
               exec_dir(m), json.dumps({"node": node, "result": result}, ensure_ascii=False),
               acceptance=result.get("acceptance", []))
    print(f"节点 {node}：提交关口开始（验收标准 {result.get('acceptance', [])}）")


def launch_submit(m: Mission, node: str) -> None:
    launch_job(m, "submit", node, orc_self("gate", "--kind", "submit", "--mission", m.name, "--job",
                                           f"{node}.submit.{len(job_starts(m, node, 'submit')) + 1}"),
               exec_dir(m), json.dumps({"node": node}))
    print(f"节点 {node}：整体评审开始")


def launch_dispute(m: Mission, node: str, check_id: str, reason: str) -> None:
    cfg = m.roles()["review"]
    check = next(c for c in node_checks(m, node) if c["id"] == check_id)
    last_gate = next((e for e in reversed(job_exits(m, node, "gate")) if check_id in e.get("checks", {})), None)
    output = "（这个检查还没有在提交关口跑过）"
    if last_gate and last_gate.get("card") and Path(last_gate["card"]).is_file():
        output = Path(last_gate["card"]).read_text(encoding="utf-8")[-3000:]
    values = {"{{MISSION}}": m.name, "{{NODE}}": node, "{{WORKTREE}}": os.path.realpath(m.worktree(node)),
              "{{DESIGN}}": (m.control / "approved-design.md").read_text(encoding="utf-8").strip(),
              "{{ENTRY}}": json.dumps(approved_tasks(m)[node], ensure_ascii=False, indent=2),
              "{{CHECK}}": check_id, "{{COMMAND}}": check["command"],
              "{{TEST_FILES}}": "、".join(f"`{p}`" for p in approved_checks(m)["test_files"]),
              "{{OUTPUT}}": output, "{{REASON}}": reason}
    prompt = (ORC_ROOT / "templates" / "dispute-brief.md").read_text(encoding="utf-8")
    for key, value in values.items():
        prompt = prompt.replace(key, value)
    argv = ["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
            "--permission-mode", "default", "--allowedTools=Read", "--session-id", str(__import__("uuid").uuid4())]
    launch_job(m, "dispute", node, argv, os.path.realpath(m.worktree(node)), prompt, {"ORC_ROLE": "dispute"},
               check=check_id)
    print(f"节点 {node}：执行会话认为检查 {check_id} 有错，交给 review 模型判断")


def launch_integrate(m: Mission, node: str) -> None:
    """整体评审通过后：写复用脚本要的核验文件，后台运行 integrate-task.sh。"""
    ctl, work, parent = node_ctl(m, node), node_work(m, node), parent_worktree(m)
    head = run_git(m.worktree(node), "rev-parse", "HEAD")
    tip = run_git(parent, "rev-parse", "HEAD")
    if head == tip:
        # 没有新提交：integrate-task.sh 的 commit-tree -p T -p T 只留一个父提交，会先移动 mission 分支再失败，之后永远对不上。
        # 被打回的节点就撤回这次打回；其他情况停下来，不碰 mission 分支
        if withdraw_reopen(m, node):
            return
        raise OrcError(f"节点 {node} 没有新提交（HEAD 就是 mission 分支的 tip {tip[:12]}），没有东西可集成。这是 orc 的 bug；"
                       "把 events.jsonl 给用户看。")
    review = next(e for e in reversed(job_exits(m, node, "submit")) if e.get("outcome") == "aligned")
    write_atomic(work / "verification.sha", head + "\n")
    write_atomic(ctl / "coordinator-verification.sha", head + "\n")
    write_atomic(ctl / "coordinator-verification.md",
                 f"# 节点 {node} 的整体评审\n\n提交 `{head}` 上全部冻结检查通过，对齐评审 ALIGNED（任务 {review['job']}）。\n")
    write_atomic(ctl / "parent-verification.sha", tip + "\n")
    # integrate-task.sh 的 --control-dir 是控制根目录（它自己拼 tasks/<node>），broker 的是节点的控制目录
    argv = ["bash", str(SCRIPTS / "integrate-task.sh"), "--control-dir", os.path.realpath(m.control),
            "--task-dir", os.path.realpath(work), "--mission", m.name, "--task-id", node,
            "--parent-worktree", os.path.realpath(parent), "--expected-parent-tip", tip]
    # 合并提交也带 [N#]：产品仓库 CI 的「commit 必须带 [N#]」检查每个提交（proposals/2026-11-08-phase5-open-points.md 第 2 条）
    clauses = approved_tasks(m)[node].get("clauses", [])
    argv += ["--message", f"[{','.join(clauses)}] Integrate {node}" if clauses else f"[orc] Integrate {node}"]
    launch_job(m, "integrate", node, argv, os.path.realpath(parent), "", head=head, parent_tip=tip)
    print(f"节点 {node}：开始集成到 {mission_branch(m)}")


# -- 后台任务结束后的处理

def finish_job(m: Mission, start: dict, status: str, rc: Optional[int], timed_out: bool = False) -> None:
    node, type_, job = start["node"], start["type"], start["job"]
    fields: dict = {"job": job, "type": type_, "node": node, "rc": rc}
    if type_ == "executor":
        if timed_out or status == "lost" or rc != 0:
            why = "超时被结束" if timed_out else ("进程不见了，没有留下退出码" if status == "lost" else f"退出码 {rc}")
            fields.update(outcome="failed", reason=why)
        else:
            text, error = claude_result(job_file(m, job, "out"))
            obj = last_json_object(text) if text is not None else None
            problems = [error] if error else validate_executor_result(m, node, obj)
            if problems:
                fields.update(outcome="invalid", problems=problems)
            else:
                fields.update(outcome=obj["status"], result=obj)
    elif type_ in ("gate", "submit"):
        path = job_file(m, job, "result.json")
        if path.is_file():
            result = json.loads(path.read_text(encoding="utf-8"))
            fields.update(result)
        else:
            why = "超时被结束" if timed_out else f"异常结束（退出码 {rc}）"
            err = read1(job_file(m, job, "err"))[-500:]
            fields.update(outcome="unavailable", reason=f"{'提交关口' if type_ == 'gate' else '整体评审'}{why}：{err}")
    elif type_ == "dispute":
        text, error = (claude_result(job_file(m, job, "out")) if status == "done" and rc == 0
                       else (None, "超时被结束" if timed_out else f"异常结束（退出码 {rc}）"))
        obj = last_json_object(text) if text is not None else None
        if error or not obj or obj.get("verdict") not in ("test-ok", "test-wrong"):
            fields.update(outcome="unavailable", reason=error or "评审没有按格式给出 verdict")
        else:
            fields.update(outcome=obj["verdict"], reason=str(obj.get("reason", "")), check=start.get("check"))
    elif type_ == "integrate":
        if rc == 0 and read1(node_ctl(m, node) / "state") in INTEGRATED_SCRIPT_STATES:
            fields.update(outcome="integrated", sha=read1(node_ctl(m, node) / "integrated_sha"))
            for name in ("repair.json", "reopen-prev"):
                (node_ctl(m, node) / name).unlink(missing_ok=True)
        else:
            fields.update(outcome="failed", reason=read1(job_file(m, job, "err"))[-800:] or f"退出码 {rc}")
    m.append("job-exit", "orc step", **fields)
    # 给状态页和排查用的摘要事件（STATE.md 的 commit / review / correction / check）
    if type_ in ("gate", "submit"):
        for cid, ok in fields.get("checks", {}).items():
            m.append("check", "orc step", node=node, id=cid, passed=ok, log=job)
        review = fields.get("review")
        if review and review.get("verdict") in ("aligned", "drift"):
            m.append("review", "orc step", node=node, verdict="ALIGNED" if review["verdict"] == "aligned" else "DRIFT",
                     reason=review.get("text", "")[:1000], stage="commit" if type_ == "gate" else "node")
        if fields.get("outcome") == "committed":
            m.append("commit", "orc step", node=node, sha=fields["sha"], files=fields.get("files", []))
        if fields.get("card"):
            m.append("correction", "orc step", node=node, count=gate_streak(m, node) if type_ == "gate" else 1,
                     card=fields["card"])
    print(f"节点 {node}：{type_} 结束（{fields.get('outcome')}）")


def consecutive(exits: List[dict], bad: set, stop: Optional[set] = None) -> int:
    count = 0
    for e in reversed(exits):
        if e.get("outcome") in bad:
            count += 1
        elif stop is None or e.get("outcome") in stop:
            break
    return count


def gate_streak(m: Mission, node: str) -> int:
    """连续被拒的次数：提交成功一次清零；评审服务出错不算。"""
    return consecutive(job_exits(m, node, "gate"), {"rejected"}, set(DONE_OUTCOMES))


def block_node(m: Mission, node: str, reason: str, question: str, qtype: str, resume: str) -> None:
    q = m.ask(question, qtype, "orc step")
    write_atomic(node_ctl(m, node) / "blocked", reason + "\n")
    m.append("node-blocked", "orc step", node=node, question=q.stem, qtype=qtype, reason=reason, resume=resume)
    print(f"节点 {node}：blocked（{reason}）")


def discard_changes(m: Mission, node: str) -> Path:
    """连续第 2 次被拒：未提交的改动存成补丁，worktree 回到上一次提交通过的状态。"""
    wt, work = m.worktree(node), node_work(m, node)
    patch = work / f"discarded-{len(list(work.glob('discarded-*.patch'))) + 1}.patch"
    write_atomic(patch, pending_diff(wt, changed_paths(wt)))
    run_git(wt, "reset", "-q", "--hard", "HEAD")
    run_git(wt, "clean", "-fdq")
    return patch


def card_text(path: Optional[str]) -> str:
    return Path(path).read_text(encoding="utf-8").strip() if path and Path(path).is_file() else "（没有纠偏单）"


def enter_submitted(m: Mission, node: str) -> None:
    work = node_work(m, node)
    commits = [e for e in m.events() if e.get("kind") == "commit" and e.get("node") == node]
    notes = [e["result"].get("notes", "").strip() for e in job_exits(m, node, "executor")
             if e.get("outcome") == "commit" and e["result"].get("notes", "").strip()]
    report = (f"# 节点 {node}\n\n全部验收标准都已提交：\n\n{acceptance_lines(m, node)}\n\n## 提交\n\n"
              + "".join(f"- `{c['sha'][:12]}` {', '.join(c.get('files', []))}\n" for c in commits)
              + "\n## 执行会话报告的遗留问题\n\n" + ("".join(f"- {n}\n" for n in notes) or "（无）\n"))
    write_atomic(work / "report.md", report)
    write_atomic(work / "state", "completed\n")
    launch_submit(m, node)


def decide(m: Mission, node: str, last: dict, cfg: dict) -> None:
    """节点最近一件事已经结束（或刚开始、刚解除 blocked）：决定下一步，启动一个后台任务或让节点 blocked。"""
    kind = last["kind"]
    if kind == "node-start":
        launch_executor(m, node, None)
        return
    if kind == "node-reopen":
        why = ("诊断认为问题在你这个节点的文件里" if last.get("stage") == "修复"
               else f"mission 的{last.get('stage', '最终审查')}没通过")
        launch_executor(m, node, f"{why}，节点 {node} 被重新打开。纠偏单：\n\n{card_text(last.get('card'))}\n\n"
                                 "修好后按 commit 格式结束这一轮；acceptance 写这次修的验收标准编号，没有对应的就写 []。"
                                 "问题其实不在你的文件里时，用 outside 结束这一轮。")
        return
    if kind == "node-unparked":
        launch_executor(m, node, last["message"])
        return
    if kind == "node-unblocked":
        answer = Path(last["answer"]).read_text(encoding="utf-8").strip()
        resume = last.get("resume")
        if resume == "gate":
            result = next(e for e in reversed(job_exits(m, node, "executor")) if e.get("outcome") == "commit")["result"]
            launch_gate(m, node, result)
        elif resume == "submit":
            launch_submit(m, node)
        elif resume == "integrate":
            pass                                   # 由集成调度重新尝试
        elif resume == "fresh":
            # 熔断后从上一次通过的提交重来：被拒的改动先存成补丁撤回，再新开会话
            patch = discard_changes(m, node) if changed_paths(m.worktree(node)) else None
            undo = f"上一个会话被拒的改动已撤回（存成 {patch}）。" if patch else ""
            launch_executor(m, node, f"{undo}从上一次通过的提交重新开始。用户（或 coordinator）的裁决：\n\n{answer}\n\n"
                                     "据此继续；做完一条验收标准就按格式结束这一轮。", fresh=True)
        else:
            launch_executor(m, node, f"用户（或 coordinator）的回答：\n\n{answer}\n\n据此继续；做完一条验收标准就按格式结束这一轮。")
        return
    type_, outcome = last["type"], last.get("outcome")
    if type_ == "executor":
        if outcome == "commit":
            launch_gate(m, node, last["result"])
        elif outcome == "question":
            block_node(m, node, "执行会话提问", f"节点 {node} 的执行会话问：{last['result']['question']}", "ask-user", "executor")
        elif outcome == "test-wrong":
            launch_dispute(m, node, last["result"]["check"], last["result"]["reason"])
        elif outcome == "outside":
            park_node(m, node, last["result"]["reason"], last["job"])
        elif outcome == "invalid":
            n = consecutive(job_exits(m, node, "executor"), {"invalid"})
            if n <= RESULT_REPAIRS:
                launch_executor(m, node, "orc 没能接受你这一轮的结果：\n" + "\n".join(f"- {p}" for p in last["problems"])
                                + "\n\n修正后，最后只输出一个 JSON 对象结束这一轮。")
            else:
                block_node(m, node, "执行会话的结果连续不合格",
                           f"节点 {node} 的执行会话连续 {n} 次没有按格式交结果：\n" + "\n".join(f"- {p}" for p in last["problems"])
                           + "\n\n回答会原样发给执行会话。", "mediate", "executor")
        elif outcome == "failed":
            n = consecutive(job_exits(m, node, "executor"), {"failed"})
            if n <= cfg["crash_retries"]:
                launch_executor(m, node, f"上一轮异常结束（{last['reason']}）。先看一下 worktree 现在的状态，"
                                         "继续当前这条验收标准；做完按格式结束这一轮。")
            else:
                block_node(m, node, "执行会话反复崩溃",
                           f"节点 {node} 的执行会话连续 {n} 次异常结束（最近一次：{last['reason']}）。"
                           "检查登录、代理和额度后回答「继续」，orc 会重试。", "ask-user", "executor")
        return
    if type_ == "gate":
        if outcome in DONE_OUTCOMES:
            ctl = node_ctl(m, node)
            if (ctl / "unresolved-rework").exists():
                (ctl / "unresolved-rework").unlink()
            left = remaining_acceptance(m, node)
            if not left:
                enter_submitted(m, node)
            else:
                done = (f"提交成功：`{last['sha'][:12]}`" if outcome == "committed"
                        else "冻结的检查确认它已经被之前的提交满足（没有改动，不提交）")
                launch_executor(m, node, f"{done}（验收标准 {last.get('acceptance')}）。"
                                         f"还没提交的验收标准：\n\n{acceptance_lines(m, node, left)}\n\n"
                                         "继续做下一条；做完一条就按格式结束这一轮。")
        elif outcome == "rejected":
            streak = gate_streak(m, node)
            card = card_text(last.get("card"))
            if streak >= STREAK_BLOCK:
                block_node(m, node, f"连续 {streak} 次被拒，熔断",
                           f"节点 {node} 连续 {streak} 次提交被拒，已熔断。最近一张纠偏单：\n\n{card}\n\n"
                           "涉及目标或范围的，请升级给用户。回答会连同完整 brief 发给一个新的执行会话。", "mediate", "fresh")
            elif streak >= STREAK_FRESH:
                patch = discard_changes(m, node)
                launch_executor(m, node, f"上一个执行会话连续 {streak} 次提交被拒，它的改动已撤回（存成 {patch}）。"
                                         f"从上一次通过的提交重新开始。最近一张纠偏单：\n\n{card}", fresh=True)
            else:
                launch_executor(m, node, f"这次提交被拒了。纠偏单：\n\n{card}\n\n按纠偏单改，改完按格式结束这一轮。")
        elif outcome == "test-crosses-dag":       # 冻结的测试越过了依赖：执行会话改不了，停下等诊断
            park_node(m, node, f"冻结的验收测试用到了不是本节点前置节点的节点新建的文件：\n{last.get('reason')}", last["job"])
        else:
            block_node(m, node, "提交关口没能完成评审",
                       f"节点 {node} 的提交关口没能完成，评审不降级、出错时不放行；排除问题后回答「重试」。\n\n"
                       f"原因：{last.get('reason')}\n\n例如检查 review 模型的登录、代理和额度。回答「重试」后 orc 会重新跑提交关口。",
                       "ask-user", "gate")
        return
    if type_ == "submit":
        if outcome == "aligned":
            return                                 # 等集成调度
        if outcome == "rework":
            ctl, work = node_ctl(m, node), node_work(m, node)
            write_atomic(ctl / "unresolved-rework", last["card"] + "\n")
            write_atomic(work / "state", "ready\n")
            launch_executor(m, node, f"整体评审没通过，节点回到 rework。纠偏单：\n\n{card_text(last.get('card'))}\n\n"
                                     "修好后按 commit 格式结束这一轮；acceptance 写这次修的验收标准编号，没有对应的就写 []。")
        else:
            block_node(m, node, "整体评审没能完成",
                       f"节点 {node} 的整体评审没能完成，评审不降级、出错时不放行；排除问题后回答「重试」。\n\n"
                       f"原因：{last.get('reason')}", "ask-user", "submit")
        return
    if type_ == "dispute":
        if outcome == "test-ok":
            launch_executor(m, node, f"独立评审认为冻结的检查 `{last.get('check')}` 没有错：{last.get('reason')}\n\n"
                                     "继续修实现；做完按格式结束这一轮。")
        elif outcome == "test-wrong":            # 修复闭环：停下这个节点，等诊断写好测试的修正、用户签名
            park_node(m, node, f"执行会话认为冻结的检查 `{last.get('check')}` 有错，review 模型也这样认为：{last.get('reason')}",
                      last["job"])
        else:
            block_node(m, node, "判断测试对错的评审没能完成",
                       f"节点 {node} 的执行会话认为检查 `{last.get('check')}` 有错，但 review 模型没能给出判断："
                       f"{last.get('reason')}\n\n回答会原样发给执行会话。", "ask-user", "executor")
        return
    if type_ == "integrate" and outcome != "integrated":
        block_node(m, node, "集成失败", f"节点 {node} 集成到 {mission_branch(m)} 失败：\n\n{last.get('reason')}\n\n"
                   "排除问题后回答「重试」，orc 会重新集成。", "mediate", "integrate")


def schedulable(tasks: Dict[str, dict], states: Dict[str, str], max_parallel: int) -> List[str]:
    """这次可以启动的节点（STATE.md「调度」）：pending、前置都 integrated、声明文件不和已启动未集成的节点重叠、没到并发上限。"""
    active = [n for n, s in states.items() if s not in ("pending", "integrated")]
    claimed = {f for n in active for f in tasks[n].get("files", [])}
    picked: List[str] = []
    for node, task in tasks.items():
        if states.get(node) != "pending" or len(active) + len(picked) >= max_parallel:
            continue
        if any(states.get(d) != "integrated" for d in task.get("depends_on", [])):
            continue
        if claimed & set(task.get("files", [])):
            continue
        picked.append(node)
        claimed |= set(task.get("files", []))
    return picked


def record_node_states(m: Mission) -> None:
    last: Dict[str, str] = {}
    for e in m.events():
        if e.get("kind") == "node-state":
            last[e["node"]] = e["to"]
    for node, state in m.node_states().items():
        before = last.get(node, "pending")
        if state != before:
            m.append("node-state", "orc step", node=node, **{"from": before, "to": state})


def recheck_integrated(m: Mission) -> Optional[str]:
    """进入 reviewing 之前不只信日志：从协议文件重新算，每个节点都 integrated，且集成提交确实在 mission 分支上。"""
    parent = parent_worktree(m)
    if run_git(parent, "symbolic-ref", "--short", "HEAD", check=False) != mission_branch(m):
        return f"父 worktree {parent} 不在 {mission_branch(m)} 上"
    tip = run_git(parent, "rev-parse", "HEAD")
    logged = {e["node"] for e in job_exits(m, type_="integrate") if e.get("outcome") == "integrated"}
    for node in approved_tasks(m):
        ctl = node_ctl(m, node)
        if read1(ctl / "state") not in INTEGRATED_SCRIPT_STATES:
            return f"节点 {node} 的控制文件不是 integrated"
        sha = read1(ctl / "integrated_sha")
        if not sha or subprocess.run(["git", "-C", str(parent), "merge-base", "--is-ancestor", sha, tip]).returncode != 0:
            return f"节点 {node} 记录的集成提交 {sha[:12] or '（空）'} 不在 {mission_branch(m)} 上"
        if node not in logged:
            return f"节点 {node} 的协议文件是 integrated，但日志里没有它的集成记录"
    return None


def h_executing(m: Mission):
    setup = exec_setup(m)
    if setup is None:
        return f"error mission {m.name} 在 executing，但没有 exec-setup 事件。这是 orc 的 bug；把 events.jsonl 给用户看。", False
    cfg, tasks = setup["config"], approved_tasks(m)
    # 1. 收尾结束了的后台任务（超时的会话先结束掉；提交关口、整体评审、集成内部各有超时）
    for start in running_jobs(m):
        status, rc = job_status(m, start)
        timed_out = False
        if status == "running":
            if not session_overdue(start, cfg):
                continue
            kill_job(start)
            timed_out = True
        if start["node"] == MISSION_JOBS:          # 诊断（修复闭环）
            finish_mission_job(m, start, status, rc, timed_out)
        else:
            finish_job(m, start, status, rc, timed_out)
    unpark_ready(m)
    # 2. 已回答的 blocked 节点解除 blocked
    answered = {e["id"]: e for e in m.events() if e.get("kind") == "answer"}
    for node in tasks:
        evs = node_events(m, node)
        if evs and evs[-1]["kind"] == "node-blocked" and evs[-1]["question"] in answered:
            (node_ctl(m, node) / "blocked").unlink(missing_ok=True)
            m.append("node-unblocked", "orc step", node=node, question=evs[-1]["question"],
                     answer=answered[evs[-1]["question"]]["file"], resume=evs[-1].get("resume"))
    # 3. 每个节点：最近一件事结束了就决定下一步
    busy = {s["node"] for s in running_jobs(m)}
    for node in tasks:
        evs = node_events(m, node)
        if evs and node not in busy and evs[-1]["kind"] in ("node-start", "node-unblocked", "job-exit", "node-reopen",
                                                              "node-unparked"):
            decide(m, node, evs[-1], cfg)
    record_node_states(m)
    # 4. 有没回答的问题：mission 进入 blocked（一次一个）
    for node in tasks:
        evs = node_events(m, node)
        if evs and evs[-1]["kind"] == "node-blocked" and evs[-1]["question"] not in answered:
            m.transition("blocked", "orc step", reason=f"节点 {node}：{evs[-1]['reason']}",
                         question=evs[-1]["question"], type=evs[-1]["qtype"])
            return None, True
    # 5. 集成：一次一个，按 DAG 顺序
    if not [s for s in running_jobs(m) if s["type"] == "integrate"]:
        for node in tasks:
            evs = node_events(m, node)
            if evs and evs[-1]["kind"] == "job-exit" and evs[-1]["type"] == "submit" and evs[-1].get("outcome") == "aligned" \
                    or evs and evs[-1]["kind"] == "node-unblocked" and evs[-1].get("resume") == "integrate":
                launch_integrate(m, node)
                break
    # 6. 调度新节点
    for node in schedulable(tasks, m.node_states(), cfg["max_parallel"]):
        start_node(m, node)
        decide(m, node, node_events(m, node)[-1], cfg)
    record_node_states(m)
    # 7. 全部集成：重新判定后进入 reviewing
    states = m.node_states()
    if states and all(s == "integrated" for s in states.values()):
        problem = recheck_integrated(m)
        if problem:
            return (f"error mission {m.name} 的节点都已集成，但重新核对协议文件时发现：{problem}。"
                    "日志和协议文件对不上，不要继续；把这条消息告诉用户。"), False
        m.transition("reviewing", "orc step", reason="全部节点已集成，协议文件重新核对一致")
        print(f"mission {m.name}：executing → reviewing")
        return None, True
    if running_jobs(m):
        return "wait", False
    # 8. 没有别的事可做、有停着的节点：交给诊断（修复闭环）
    if any(s == "parked" for s in states.values()):
        source, failed, parked = parked_payload(m)
        return repair_step(m, mission_tip(m), "node", source, failed, parked)
    stuck = {n: s for n, s in states.items() if s != "integrated"}
    return (f"error mission {m.name} 没有在运行的后台任务，也没有可以启动的节点（{stuck}）。"
            "这是 orc 的 bug；把 events.jsonl 给用户看。"), False


# ---------------------------------------------------------------- 验收（阶段 5，STATE.md「验收」）

MISSION_JOBS = "_mission"        # mission 级后台任务（最终审查、等 CI、状态页说明）用的节点名；DAG 节点 id 不以 _ 开头
FINAL_ROUNDS = 2                 # 最终审查的模型判不通过时最多打回几轮；连续第 3 次就 mediate
FINAL_RUNS = 3                   # 最终审查时每个检查跑几次，任何一次失败都算失败
DIAG_RUNS = 10                   # 诊断前、修复后，失败的检查各连跑几次
REVERT_MAX_RUNS = 20             # 撤掉修复后最多跑几次来重现失败（第一次失败就停）
REPAIR_ROUNDS = 3                # 修复闭环最多几轮（诊断后修代码或改测试各算一轮）；用户回答后清零
DIAG_REPAIRS = 2                 # 诊断不合格时发回重写的次数
NOTES_REPAIRS = 2                # 状态页说明不合格时发回修的次数
MAX_INLINE_DIFF = 60000          # 和 northstar-review 的上限一致：更大的 diff 不放进提示词，让评审用 Read 看代码
ACCEPT_KEYS = ("required_checks", "ci_timeout_seconds")
PROGRESS_WORDS = re.compile(r"完成|done|complete|passed|100%", re.I)
REF_RE = re.compile(r"\[(commit|check|file):([^\]]+)\]")


def accept_config(path: Path = EXEC_CONFIG) -> dict:
    """orc.toml 的 [acceptance]：进入 accepted 前 PR 上必须通过的 CI 检查（逗号分隔的名字），以及等 CI 最多多久。"""
    data = parse_toml(path.read_text(encoding="utf-8")) if path.is_file() else {}
    section = data.get("acceptance")
    if not isinstance(section, dict):
        raise OrcError(f"{path} 缺少 [acceptance] 段（required_checks、ci_timeout_seconds）。照 orc/config/orc.toml 的模板补上。")
    names = [n.strip() for n in str(section.get("required_checks", "")).split(",") if n.strip()]
    timeout = str(section.get("ci_timeout_seconds", ""))
    if not names:
        raise OrcError("orc.toml 的 [acceptance] required_checks 不能为空：至少要有 northstar 的 verify。")
    if not timeout.isdigit() or int(timeout) < 1:
        raise OrcError(f"orc.toml 的 [acceptance] ci_timeout_seconds 必须是正整数（带引号的字符串），现在是「{timeout}」。")
    # 公开的检查要写明；没写明的一律当隐藏考题（输出全部丢掉）：改名或新加检查时忘了配置，也不会把日志交出去
    public = [n.strip() for n in str(section.get("public_checks", "verify")).split(",") if n.strip()]
    hidden = [n for n in names if n not in public]
    return {"required_checks": names, "ci_timeout_seconds": int(timeout), "hidden_checks": hidden}


def event_index(m: Mission, event: dict) -> int:
    return m.events().index(event)


def answered_after(m: Mission, event: Optional[dict]) -> bool:
    """这件事之后 mission 进入过 blocked 又被回答（blocked → 原状态）：它引出的问题已经处理，结果作废、重来。"""
    if event is None:
        return False
    evs = m.events()
    i = evs.index(event)
    return any(e.get("kind") == "state" and e.get("from") == "blocked" for e in evs[i + 1:])


def mission_exit(m: Mission, type_: str, tip: str) -> Optional[dict]:
    """针对这个提交（mission 分支的 tip）最近一次结束的 mission 级任务；之后被回答过的问题作废它。"""
    exits = [e for e in job_exits(m, MISSION_JOBS, type_) if e.get("tip") == tip]
    last = exits[-1] if exits else None
    # 通过的结果一直有效（后面别的环节出问题、回答过，不用重新审查）；没通过的，回答过就重来
    if last is not None and last.get("outcome") not in ("passed", "valid") and answered_after(m, last):
        return None
    return last


def mission_running(m: Mission, type_: Optional[str] = None) -> List[dict]:
    return [s for s in running_jobs(m) if s["node"] == MISSION_JOBS and (type_ is None or s["type"] == type_)]


def mission_tip(m: Mission) -> str:
    return run_git(parent_worktree(m), "rev-parse", "HEAD")


def export_tree(m: Mission, tip: str, dest: Path, drop: Tuple[str, ...] = ()) -> None:
    """把一个提交的内容导出成没有 .git 的副本（drop 里的顶层目录不导出）。"""
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True)
    archive = subprocess.run(["git", "-C", str(m.repo()), "archive", "--format=tar", tip], capture_output=True, check=True)
    subprocess.run(["tar", "-x", "-C", str(dest)], input=archive.stdout, check=True)
    for name in drop:
        shutil.rmtree(dest / name, ignore_errors=True)


def mission_commits(m: Mission, tip: str) -> List[Tuple[str, str]]:
    """基线之后、不含合并提交的提交：(短哈希, 说明)。冻结测试的提交和每个节点的提交都在里面。"""
    base = exec_setup(m)["base"]
    out = run_git(m.repo(), "log", "--no-merges", "--reverse", "--format=%h %s", f"{base}..{tip}")
    return [tuple(line.split(" ", 1)) for line in out.splitlines() if line.strip()]  # type: ignore[misc]


RUN_ALL = {"id": "run-all", "node": None, "command": "bash .northstar/checks/run_all.sh"}


def final_checks(m: Mission, where: Path, runs: int = FINAL_RUNS) -> Tuple[Dict[str, bool], List[dict], List[dict]]:
    """合并后的代码上跑全部冻结检查，以及产品仓库自己的 .northstar/checks/run_all.sh（有的话）。
    每个检查跑 runs 次，任何一次失败都算失败（偶发失败不再靠运气通过；结果里记 fails / runs，输出取第一次失败的）。"""
    checks = list(approved_checks(m)["checks"])
    suite = [dict(RUN_ALL)] if (where / ".northstar" / "checks" / "run_all.sh").is_file() else []
    merged: List[dict] = []
    for i in range(runs):
        results = run_check_commands(where, checks + suite)
        if not merged:
            merged = [dict(r, fails=0, runs=0) for r in results]
        for acc, r in zip(merged, results):
            acc["runs"] += 1
            if r["rc"] != 0:
                if acc["fails"] == 0:
                    acc["rc"], acc["tail"] = r["rc"], r["tail"]
                acc["fails"] += 1
    for r, c in zip(merged, checks + suite):
        r["node"] = c.get("node")
    return {r["id"]: r["fails"] == 0 for r in merged}, merged, checks + suite


def run_final(m: Mission, job: str, tip: str) -> dict:
    """最终审查（STATE.md）：合并后的代码上重跑全部检查；都过了再请 review 模型对照 NORTHSTAR 和签名的设计审查整个 mission。"""
    import tempfile
    out: dict = {"tip": tip, "checks": {}}
    copy = jobs_dir(m) / f"{job}.copy"
    try:
        git_copy(m.repo(), tip, copy)        # 检查用的副本带 git 历史；给评审模型看的副本仍用 export_tree
        out["checks"], results, _ = final_checks(m, copy)
    finally:
        shutil.rmtree(copy, ignore_errors=True)
    failed = [r for r in results if r["fails"]]
    if failed:
        # 不再按检查所属的节点打回：交给诊断会话判断该谁修（修复闭环）
        return {**out, "outcome": "checks-failed",
                "failed": [{k: r[k] for k in ("id", "node", "command", "rc", "tail", "fails", "runs")} for r in failed]}
    tasks = approved_tasks(m)
    base = exec_setup(m)["base"]
    diff = run_git(m.repo(), "diff", "--no-color", "--no-renames", f"{base}..{tip}")
    if len(diff.encode()) > MAX_INLINE_DIFF:
        diff = (f"（diff 有 {len(diff.encode())} 字节，超过 {MAX_INLINE_DIFF}，不放在这里。改动的文件：\n\n"
                + run_git(m.repo(), "diff", "--stat", f"{base}..{tip}") + "\n\n用 Read 看当前目录里的这些文件。）")
    else:
        diff = f"```diff\n{diff}\n```"
    northstar = run_git(m.repo(), "show", f"{tip}:.northstar/NORTHSTAR.md", check=False) or "（没有 NORTHSTAR）"
    values = {"{{MISSION}}": m.name, "{{NORTHSTAR}}": northstar,
              "{{DESIGN}}": (m.control / "approved-design.md").read_text(encoding="utf-8").strip(),
              "{{DAG}}": json.dumps(list(tasks.values()), ensure_ascii=False, indent=2),
              "{{CHECKS}}": "\n".join(f"- {r['id']}（{r['command']}）：通过" for r in results),
              "{{BASE}}": base[:12], "{{TIP}}": tip[:12], "{{DIFF}}": diff}
    prompt = (ORC_ROOT / "templates" / "final-review-brief.md").read_text(encoding="utf-8")
    for key, value in values.items():
        prompt = prompt.replace(key, value)
    cfg = m.roles()["review"]
    argv = ["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
            "--permission-mode", "default", "--allowedTools=Read", "--session-id", str(__import__("uuid").uuid4())]
    # 评审在仓库外的临时目录里看代码副本（不带 .northstar：材料都在提示词里），Stop hook 不会因为「未提交的改动」拦它
    review_dir = Path(tempfile.mkdtemp(prefix="orc-final-review."))
    try:
        export_tree(m, tip, review_dir, drop=(".northstar", ".github"))
        run = subprocess.run(argv, input=prompt, cwd=str(review_dir), capture_output=True, text=True,
                             timeout=REVIEW_TIMEOUT, env=dict(os.environ, ORC_ROLE="final-review"))
        write_atomic(job_file(m, job, "review.json"), run.stdout)
        text, error = claude_result(job_file(m, job, "review.json")) if run.returncode == 0 else (None, f"退出码 {run.returncode}")
    except subprocess.TimeoutExpired:
        text, error = None, f"超过 {REVIEW_TIMEOUT} 秒没有结束"
    finally:
        shutil.rmtree(review_dir, ignore_errors=True)
    obj = last_json_object(text) if text is not None else None
    if error or not obj or obj.get("verdict") not in ("pass", "fail") or not isinstance(obj.get("issues", []), list):
        return {**out, "outcome": "unavailable", "reason": error or "最终审查没有按格式给出 verdict 和 issues"}
    issues = [i for i in obj.get("issues", []) if isinstance(i, dict)]
    out["review"] = {"verdict": obj["verdict"], "issues": issues}
    if obj["verdict"] == "pass":
        return {**out, "outcome": "passed"}
    bad = [str(i.get("node")) for i in issues if i.get("node") not in tasks]
    if not issues or bad:
        return {**out, "outcome": "unavailable",
                "reason": "最终审查判不通过，但" + ("没有列出问题" if not issues else f"问题落在不存在的节点上：{'、'.join(bad)}")}
    return {**out, "outcome": "rework", "issues": issues}


def gh(m: Mission, *args: str, check: bool = True) -> str:
    if shutil.which("gh") is None:
        raise OrcError("PATH 里找不到 gh（GitHub CLI），开不了 PR、查不了 CI → 安装并登录 gh 后再运行 orc step。")
    r = subprocess.run(["gh", *args], cwd=str(m.repo()), capture_output=True, text=True)
    if check and r.returncode != 0:
        raise OrcError(f"gh {' '.join(args[:2])} 失败：{(r.stderr or r.stdout).strip()[:300]}。检查网络代理和 gh 登录后再运行 orc step。")
    return r.stdout.strip()


def ensure_pr(m: Mission, tip: str) -> dict:
    """把 mission 分支推到产品仓库的 origin，开（或找到已有的）指向默认分支的 PR。合并由用户来做。"""
    repo, branch = m.repo(), mission_branch(m)
    if subprocess.run(["git", "-C", str(repo), "remote", "get-url", "origin"], capture_output=True).returncode != 0:
        raise OrcError(f"产品仓库 {repo} 没有 origin：mission 要开 PR、等 CI（northstar / verify 和隐藏考题）通过才能验收。"
                       "先让用户在 GitHub 上建好仓库并设成 origin，再运行 orc step。")
    push = subprocess.run(["git", "-C", str(repo), "push", "--quiet", "origin", f"{branch}:refs/heads/{branch}"],
                          capture_output=True, text=True)
    if push.returncode != 0:
        raise OrcError(f"推送 {branch} 到 origin 失败：{push.stderr.strip()[:300]}。检查网络代理和 token 后再运行 orc step；"
                       "远端的同名分支有别的提交时，把这条消息告诉用户。")
    found = json.loads(gh(m, "pr", "list", "--head", branch, "--state", "open", "--json", "url,number") or "[]")
    if found:
        pr = found[0]
    else:
        default = gh(m, "repo", "view", "--json", "defaultBranchRef", "--jq", ".defaultBranchRef.name")
        request = (m.dir / "request.md").read_text(encoding="utf-8").strip()
        body = (f"orc mission `{m.name}`。\n\n**请求**：{request}\n\n全部节点已集成、最终审查通过。"
                "CI（northstar / verify 和隐藏考题）通过、orc 发布状态页后，由你合并。\n\n🤖 orc")
        url = gh(m, "pr", "create", "--base", default, "--head", branch, "--title", f"orc mission {m.name}：{request[:60]}",
                 "--body", body).splitlines()[-1].strip()
        pr = {"url": url, "number": int(url.rstrip("/").rsplit("/", 1)[1])}
    event = m.append("pr", "orc step", url=pr["url"], number=pr["number"], tip=tip, branch=branch)
    print(f"mission {m.name}：PR {pr['url']}")
    return event


def current_pr(m: Mission, tip: str) -> Optional[dict]:
    prs = [e for e in m.events() if e.get("kind") == "pr" and e.get("tip") == tip]
    return prs[-1] if prs else None


def run_ci(m: Mission, job: str, pr_url: str, tip: str) -> dict:
    """等 PR 上的 CI：required_checks 里每一个都出现并结束为止，最多 ci_timeout_seconds 秒。PR 的 head 必须就是 mission 分支的 tip。"""
    import time
    cfg = accept_config()
    poll = int(os.environ.get("ORC_CI_POLL_SECONDS", "20"))
    deadline = time.monotonic() + cfg["ci_timeout_seconds"]
    out: dict = {"tip": tip, "pr": pr_url, "checks": {}}
    while True:
        head = gh(m, "pr", "view", pr_url, "--json", "headRefOid", "--jq", ".headRefOid", check=False)
        if head and head != tip:
            return {**out, "outcome": "failed", "reason": f"PR 的 head 是 {head[:12]}，不是 orc 审查过的 {tip[:12]}：有别人推送了这个分支"}
        raw = gh(m, "pr", "checks", pr_url, "--json", "name,bucket,link", check=False)
        try:
            rows = json.loads(raw) if raw else []
        except ValueError:
            rows = []
        states = {r["name"]: r["bucket"] for r in rows if isinstance(r, dict) and r.get("name")}
        links = {r["name"]: r.get("link") or "" for r in rows if isinstance(r, dict) and r.get("name")}
        out["checks"] = states
        done = all(states.get(n) in ("pass", "fail", "cancel", "skipping") for n in cfg["required_checks"])
        if done:
            bad = {n: states[n] for n in cfg["required_checks"] if states[n] != "pass"}
            if bad:
                return {**out, "outcome": "failed", "reason": "CI 没通过：" + "、".join(f"{n}（{s}）" for n, s in bad.items()),
                        "details": ci_failure_details(m, bad, links, cfg["hidden_checks"])}
            return {**out, "outcome": "passed"}
        if time.monotonic() > deadline:
            missing = [n for n in cfg["required_checks"] if n not in states]
            return {**out, "outcome": "timeout", "reason": f"等了 {cfg['ci_timeout_seconds']} 秒 CI 还没结束"
                    + (f"；PR 上没有这些检查：{'、'.join(missing)}（workflow 没推、或名字不对）" if missing else "")}
        time.sleep(poll)


EXAM_CLAUSE_RE = re.compile(r"NORTHSTAR-EXAM (N[0-9]+) fail\b")
CI_LOG_LINES = 150


def ci_failure_details(m: Mission, bad: Dict[str, str], links: Dict[str, str], hidden: List[str]) -> Dict[str, dict]:
    """没通过的 CI 检查交给诊断的材料。公开的检查（verify）：失败步骤日志的最后 CI_LOG_LINES 行。
    隐藏考题：输出全部丢掉，只取 workflow 过滤后的「NORTHSTAR-EXAM N# fail」行（哪条条款的考题没过），别的一行都不拿。
    条款编号只认签名的 DAG 里有的：被测的产品代码也能往日志里写这种行，任意数字就成了把考题内容带出去的通道。
    有不认识的编号就整个不采用（不记下来），当作缺材料问用户。"""
    known = {c for t in approved_tasks(m).values() for c in t.get("clauses", [])}
    details: Dict[str, dict] = {}
    for name in bad:
        job = re.search(r"/job/([0-9]+)", links.get(name, ""))
        log = gh(m, "run", "view", "--job", job.group(1), "--log-failed", check=False) if job else ""
        if name in hidden:
            found = set(EXAM_CLAUSE_RE.findall(log))
            unknown = len(found - known)
            details[name] = ({"hidden": True, "clauses": [], "unknown": unknown} if unknown else
                             {"hidden": True, "clauses": sorted(found, key=lambda c: int(c[1:]))})
        else:
            details[name] = {"hidden": False, "log": log.splitlines()[-CI_LOG_LINES:]}
    return details


def ci_failed_payload(ci: dict) -> Tuple[List[dict], List[str]]:
    """把 CI 的失败变成诊断的输入。返回 (失败列表, 缺材料的检查)：缺材料（日志取不到、考题没报条款）的要用户给提示。"""
    failed, missing = [], []
    for name, d in ci.get("details", {}).items():
        if d.get("hidden") and d.get("clauses"):
            failed.append({"id": f"ci:{name}", "node": None, "command": f"CI 上的隐藏考题 {name}", "ci": True,
                           "clauses": d["clauses"], "tail": [f"条款 {c} 的考题没过" for c in d["clauses"]]})
        elif not d.get("hidden") and d.get("log"):
            failed.append({"id": f"ci:{name}", "node": None, "command": f"CI 上的检查 {name}", "ci": True, "tail": d["log"]})
        else:
            missing.append(name)
    if not ci.get("details"):
        missing.append("（CI 结果里没有失败详情）")
    return failed, missing


def notes_problems(m: Mission, tip: str, text: str) -> List[str]:
    """状态页说明的核对（沿用 northstar-status 的规则）：每行带引用、引用都存在、每个提交都被交代、不写进度判断。"""
    problems: List[str] = []
    commits = [c[0] for c in mission_commits(m, tip)]
    check_ids = {c["id"] for c in approved_checks(m)["checks"]}
    lines = [l for l in text.strip().splitlines() if l.strip()]
    if not lines:
        return ["说明是空的"]
    cited = set()
    for i, line in enumerate(lines, 1):
        if not line.lstrip().startswith(("- ", "* ")):
            problems.append(f"第 {i} 行不是列表项（每行以「- 」开头）")
            continue
        refs = REF_RE.findall(line)
        if not refs:
            problems.append(f"第 {i} 行没有引用证据")
        if PROGRESS_WORDS.search(line):
            problems.append(f"第 {i} 行含进度判断，进度只能由 orc 给出")
        for kind, value in refs:
            value = value.strip()
            if kind == "commit":
                hit = [c for c in commits if len(value) >= 7 and (c.startswith(value) or value.startswith(c))]
                if hit:
                    cited.update(hit)
                else:
                    problems.append(f"第 {i} 行：commit {value} 不是这个 mission 的提交")
            elif kind == "check" and value not in check_ids:
                problems.append(f"第 {i} 行：检查 {value} 不存在")
            elif kind == "file":
                path, _, line_no = value.partition(":")
                body = run_git(m.repo(), "show", f"{tip}:{path}", check=False) if safe_rel(path) else ""
                if not body:
                    problems.append(f"第 {i} 行：文件 {path} 在合并后的代码里不存在")
                elif line_no.isdigit() and int(line_no) > len(body.splitlines()):
                    problems.append(f"第 {i} 行：{path} 没有第 {line_no} 行")
    problems += [f"提交 {c} 没有在说明里交代" for c in commits if c not in cited]
    return problems


def launch_notes(m: Mission, tip: str, feedback: str = "") -> None:
    commits = mission_commits(m, tip)
    base = exec_setup(m)["base"]
    diff = run_git(m.repo(), "diff", "--no-color", f"{base}..{tip}")
    if len(diff.encode()) > MAX_INLINE_DIFF:
        diff = run_git(m.repo(), "diff", "--stat", f"{base}..{tip}")
    values = {"{{MISSION}}": m.name, "{{REQUEST}}": (m.dir / "request.md").read_text(encoding="utf-8").strip(),
              "{{DESIGN}}": (m.control / "approved-design.md").read_text(encoding="utf-8").strip(),
              "{{COMMITS}}": "\n".join(f"- `{h}` {s}" for h, s in commits),
              "{{CHECKS}}": "\n".join(f"- `{c['id']}`（节点 {c['node']}）：{c['command']}" for c in approved_checks(m)["checks"]),
              "{{DIFF}}": f"```diff\n{diff}\n```",
              "{{FEEDBACK}}": f"## 上一次写的没通过核对\n\n{feedback}\n" if feedback else ""}
    prompt = (ORC_ROOT / "templates" / "status-notes-brief.md").read_text(encoding="utf-8")
    for key, value in values.items():
        prompt = prompt.replace(key, value)
    cfg = m.roles()["plan"]
    import tempfile
    cwd = tempfile.mkdtemp(prefix="orc-notes.")      # 没有工具、在仓库外：只按提示词里的材料写
    argv = ["claude", "-p", "--model", cfg["model"], "--effort", "low", "--output-format", "json", "--tools", ""]
    launch_job(m, "notes", MISSION_JOBS, argv, cwd, prompt, {"ORC_ROLE": "notes"}, tip=tip)
    print(f"mission {m.name}：开始写状态页的说明")


def launch_mission_job(m: Mission, kind: str, tip: str, payload: dict) -> None:
    job = f"{MISSION_JOBS}.{kind}.{len(job_starts(m, MISSION_JOBS, kind)) + 1}"
    launch_job(m, kind, MISSION_JOBS, orc_self("gate", "--kind", kind, "--mission", m.name, "--job", job),
               exec_dir(m), json.dumps({"tip": tip, **payload}), tip=tip)
    label = {"final": "最终审查", "ci": "等 PR 的 CI", "cross": "跨 mission 评审", "diagnose": "诊断"}[kind]
    print(f"mission {m.name}：{label}开始")


def finish_mission_job(m: Mission, start: dict, status: str, rc: Optional[int], timed_out: bool) -> None:
    type_, job = start["type"], start["job"]
    fields: dict = {"job": job, "type": type_, "node": MISSION_JOBS, "rc": rc, "tip": start.get("tip")}
    if type_ == "diagnose":      # 崩溃时也要带上来源，否则 diagnose_exits 看不到这次结束，会一直重新诊断
        fields.update(trigger=start.get("trigger"), source=start.get("source"))
    if type_ in ("final", "ci", "cross", "diagnose"):
        path = job_file(m, job, "result.json")
        if path.is_file():
            fields.update(json.loads(path.read_text(encoding="utf-8")))
        else:
            fields.update(outcome="unavailable", reason=f"异常结束（退出码 {rc}）：{read1(job_file(m, job, 'err'))[-500:]}")
    else:   # notes
        text, error = (claude_result(job_file(m, job, "out")) if status == "done" and rc == 0
                       else (None, "超时被结束" if timed_out else f"异常结束（退出码 {rc}）"))
        problems = [error] if error else notes_problems(m, start["tip"], text or "")
        if problems:
            fields.update(outcome="invalid", problems=problems)
        else:
            path = exec_dir(m) / "site" / "notes.md"
            path.parent.mkdir(parents=True, exist_ok=True)
            write_atomic(path, text.strip() + "\n")
            fields.update(outcome="valid", file=str(path), sha256=sha256_file(path))
    m.append("job-exit", "orc step", **fields)
    if type_ == "cross" and fields.get("review"):
        m.append("review", "orc step", node=None, stage="cross",
                 verdict="PASS" if fields["review"]["verdict"] == "pass" else "CONFLICT",
                 reason=json.dumps(fields["review"], ensure_ascii=False)[:1500])
    if type_ == "final":
        for cid, ok in fields.get("checks", {}).items():
            m.append("check", "orc step", node=None, id=cid, passed=ok, log=job, stage="final")
        if fields.get("review"):
            m.append("review", "orc step", node=None, stage="final",
                     verdict="PASS" if fields["review"]["verdict"] == "pass" else "FAIL",
                     reason=json.dumps(fields["review"]["issues"], ensure_ascii=False)[:1000])
    print(f"mission {m.name}：{type_} 结束（{fields.get('outcome')}）")


def reopen_node(m: Mission, node: str, issues: List[dict], round_: int, label: str = "最终审查", note: str = "") -> None:
    """最终审查打回：节点从 integrated 回到 rework。节点分支快进到 mission 分支的 tip（它已经包含全部节点），
    基线也改成这个 tip，之后的提交关口和集成只看这次的修复。复用的 integrate-task.sh 对同一分支再合并一次，不用改。"""
    wt, ctl, work, tip = m.worktree(node), node_ctl(m, node), node_work(m, node), mission_tip(m)
    if changed_paths(wt):
        raise OrcError(f"节点 {node} 的 worktree 有没提交的改动，重新打开前不能覆盖。把这条消息告诉用户。")
    run_git(wt, "merge", "-q", "--ff-only", tip)
    write_atomic(ctl / "reopen-prev", json.dumps({"ctl": read1(ctl / "state") or "integrated",
                                                   "work": read1(work / "state") or "integrated"}) + "\n")
    row = read1(ctl / "worktrees.txt").split("\t")
    row[2] = tip
    for d in (ctl, work):
        write_atomic(d / "worktrees.txt", "\t".join(row) + "\n")
        write_atomic(d / "state", "ready\n")
    k = len(list(work.glob("correction-*.md"))) + 1
    detail = "\n\n".join(f"- **问题**：{i.get('problem', '')}\n  **证据**：{i.get('evidence', '')}" for i in issues)
    card = work / f"correction-{k}.md"
    why = "诊断认为问题在这个节点的文件里" if label == "修复" else f"mission 的{label}（第 {round_} 轮）没有通过"
    write_atomic(card, f"# 纠偏单：节点 {node}，第 {k} 张\n\n## 被打回的原因：{why}\n\n"
                       f"{detail}\n\n## 相关验收标准（原文）\n\n{acceptance_lines(m, node)}\n\n"
                       "worktree 已经移到 mission 分支的最新提交上（含其他节点的改动）。只改本节点的声明文件；"
                       "不要改测试或检查来让它通过。" + (f"\n\n{note}" if note else "") + "\n")
    write_atomic(ctl / "unresolved-rework", str(card) + "\n")
    m.append("node-reopen", "orc step", node=node, base=tip, card=str(card), round=round_, stage=label)
    print(f"节点 {node}：{label}打回，重新打开（基线 {tip[:12]}）")


def final_streak(m: Mission, type_: str = "final") -> int:
    """最终审查（或跨 mission 评审）连续打回的次数；用户回答过 mediate（blocked → reviewing）后清零。"""
    count = 0
    for e in m.events():
        if e.get("kind") == "state" and e.get("from") == "blocked" and e.get("to") == "reviewing":
            count = 0
        elif e.get("kind") == "job-exit" and e.get("node") == MISSION_JOBS and e.get("type") == type_ \
                and e.get("outcome") == "rework":
            count += 1
    return count


def reopen_for(m: Mission, result: dict, type_: str, label: str):
    """审查打回：按问题所属的节点重新打开，回到 executing；第 FINAL_ROUNDS + 1 次熔断（重做次数沿用熔断规则）。"""
    streak = final_streak(m, type_)
    if streak > FINAL_ROUNDS:
        m.block(f"{label}连续 {streak} 次没通过", f"mission {m.name} 的{label}连续 {streak} 次没通过，已熔断。最近一次的问题：\n\n"
                f"{issues_text(result['issues'])}\n\n回答后 orc 会重新做{label}。", "mediate", "orc step")
        return None, True
    done = {e["node"] for e in m.events()[event_index(m, result):] if e.get("kind") == "node-reopen"}
    by_node: Dict[str, List[dict]] = {}
    for issue in result["issues"]:
        by_node.setdefault(issue["node"], []).append(issue)
    states = m.node_states()
    if by_node and all(n in done and states.get(n) == "integrated" for n in by_node):
        # 打回的节点都已经处理完、回到 integrated，tip 却没变（都说已经满足、没有改动，撤回了）：
        # 在同一个提交上重做这次评审，不再拿旧结果打回（否则在 reviewing 和 executing 之间来回转）；连续不通过照常熔断。
        # 中途断掉、还有节点在返工的，照常回到 executing
        launch_mission_job(m, type_, mission_tip(m), {})
        return "wait", False
    for node, issues in by_node.items():
        if node not in done:
            reopen_node(m, node, issues, streak, label)
    m.transition("executing", "orc step", reason=f"{label}第 {streak} 轮没通过，打回节点：{'、'.join(by_node)}")
    print(f"mission {m.name}：reviewing → executing（{label}打回 {'、'.join(by_node)}）")
    return None, True


# ---------------------------------------------------------------- 修复闭环（proposals/2026-11-08-repair-loop.md）
#
# 底线（签名、冻结的测试、scope / forbid、检查和评审、broker、沙箱）写死；出了问题由诊断会话（review 模型）判断该改什么，
# orc 核对诊断，再按文件归属重新打开节点去修（broker 按签名的 DAG 核对文件，修复也只能由文件所属的节点来改），
# 修复提交另外过「修复关口」。测试本身有错时由诊断写好修正，用户签名才生效。问用户时，回答会作为提示交给诊断会话。

TEST_DETECT_RE = re.compile(r"\bpytest\b|PYTEST_|\bunittest\b|_pytest|\bconftest\b")


def check_command(m: Mission, cid: str) -> Optional[dict]:
    if cid == RUN_ALL["id"]:
        return dict(RUN_ALL)
    return next((dict(c) for c in approved_checks(m)["checks"] if c["id"] == cid), None)


def file_owners(m: Mission) -> Dict[str, List[str]]:
    owners: Dict[str, List[str]] = {}
    for tid, t in approved_tasks(m).items():
        for f in t.get("files", []):
            owners.setdefault(f, []).append(tid)
    return owners


def repair_question_answers(m: Mission, since: int = 0) -> List[str]:
    """修复问题（repair-question）的回答，按时间顺序：交给诊断会话当提示（「重试」不算提示）。"""
    evs = m.events()
    asked = {e["id"] for e in evs[since:] if e.get("kind") == "repair-question"}
    out = []
    for e in evs[since:]:
        if e.get("kind") == "answer" and e.get("id") in asked:
            text = Path(e["file"]).read_text(encoding="utf-8").strip() if Path(e["file"]).is_file() else ""
            if text and text != "重试":
                out.append(text)
    return out


def retry_requested(m: Mission, exit_event: dict) -> bool:
    """这次结果之后，用户对修复问题回答了「重试」：重新跑出错的那一步（重做最终审查、重新等 CI），
    不再拿这次结果去诊断。不然 CI 本身出故障这类临时失败永远出不去，只能放弃。测试修正的问题不算（那里回答别的都是不同意）。"""
    evs = m.events()
    after = evs[evs.index(exit_event) + 1:]
    asked = {e["id"] for e in after if e.get("kind") == "repair-question" and "test_fix" not in e}
    for e in after:
        if e.get("kind") == "answer" and e.get("id") in asked and Path(e["file"]).is_file() \
                and Path(e["file"]).read_text(encoding="utf-8").strip() == "重试":
            return True
    return False


RERUN_HINTS = {"final": "重新做一遍最终审查（例如失败是偶发的、环境已经修好）；还失败就重新诊断。",
               "ci": "重新等一遍 CI（例如 CI 本身出了故障、你已经在 GitHub 上重跑）；还失败就重新诊断。"}


def last_repair_index(m: Mission) -> int:
    """最近一次「按诊断动手」（repair / test-fix）之后的位置；之后的回答才算新的提示。"""
    evs = m.events()
    for i in range(len(evs) - 1, -1, -1):
        if evs[i].get("kind") in ("repair", "test-fix"):
            return i + 1
    return 0


def repair_rounds(m: Mission) -> int:
    """修复闭环已经动手几轮：用户回答过修复问题之后清零。"""
    count = 0
    asked = set()
    for e in m.events():
        if e.get("kind") == "repair-question":
            asked.add(e["id"])
        elif e.get("kind") == "answer" and e.get("id") in asked:
            count = 0
        elif e.get("kind") in ("repair", "test-fix"):
            count += 1
    return count


def ask_repair(m: Mission, reason: str, detail: str, job: Optional[str], retry_hint: str = "") -> None:
    """停下问用户。回答的内容会作为提示交给诊断会话重新诊断；回答「重试」只重做出错的那一步；放弃用 orc abandon。"""
    text = (f"{detail.strip()}\n\n可以这样回答（orc 都能直接执行）：\n"
            f"- 回答你对问题的判断或提示（例如「问题在 xxx，应该……」）：orc 把它交给诊断会话重新诊断，然后接着修。\n"
            + (f"- 回答「重试」：{retry_hint}\n" if retry_hint else "")
            + f"- 放弃这一轮：运行 `orc abandon --mission {m.name} \"<原因>\"`（是 phase 里的 mission 就再运行 orc phase 重跑）。")
    path = m.block(reason, text, "ask-user", "orc step")
    m.append("repair-question", "orc step", id=path.stem, job=job, reason=reason)


def launch_diagnose(m: Mission, tip: str, trigger: str, source: str, failed: List[dict], parked: List[dict],
                    feedback: str = "") -> None:
    hints = repair_question_answers(m, last_repair_index(m))
    payload = {"tip": tip, "trigger": trigger, "source": source, "failed": failed, "parked": parked,
               "hints": hints, "feedback": feedback}
    job = f"{MISSION_JOBS}.diagnose.{len(job_starts(m, MISSION_JOBS, 'diagnose')) + 1}"
    launch_job(m, "diagnose", MISSION_JOBS, orc_self("gate", "--kind", "diagnose", "--mission", m.name, "--job", job),
               exec_dir(m), json.dumps(payload, ensure_ascii=False), tip=tip, trigger=trigger, source=source)
    print(f"mission {m.name}：诊断开始（{trigger}）")


REPRO_DIR = ".orc-repro/"


def run_repro(where: Path, check: dict) -> dict:
    """在副本里放上诊断写的复现文件再运行（复现文件只在副本里，不进 mission 分支）。"""
    rp = check["repro"]
    dst = where / rp["file"]
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(rp["path"], dst)
    return run_check_commands(where, [{"id": check["id"], "command": check["command"]}])[0]


def needs_repro(m: Mission, failed: List[dict]) -> bool:
    """没有能在本地重跑的失败检查（CI 上的失败、隐藏考题、停下的节点说的问题）：诊断要先写一个能复现的检查。"""
    return not any(check_command(m, f["id"]) for f in failed if not f.get("ci"))


def diagnosis_problems(m: Mission, tip: str, obj: Optional[dict], repro_required: bool = False) -> List[str]:
    """orc 对诊断做的确定性核对。"""
    if not isinstance(obj, dict):
        return ["最后没有输出 JSON 对象"]
    kind, problems = obj.get("kind"), []
    if kind not in ("code", "test", "design"):
        return [f"kind 只能是 code、test 或 design，不是「{kind}」"]
    if not isinstance(obj.get("cause"), str) or not obj["cause"].strip():
        problems.append("cause（根因）不能为空")
    tests = set(approved_checks(m)["test_files"])
    owners = file_owners(m)
    if kind == "code":
        files = obj.get("files")
        if not isinstance(files, list) or not files or not all(isinstance(f, str) for f in files):
            return problems + ["files 必须是非空的文件路径列表"]
        for f in files:
            if not safe_rel(f):
                problems.append(f"文件路径 {f} 不合法：用仓库相对路径")
            elif f in tests:
                problems.append(f"{f} 是冻结的验收测试：认为测试有错就用 kind test，并写 test_fix")
            elif f not in owners:
                problems.append(f"{f} 不在任何节点声明的 files 里：修复只能改节点的文件。需要改动计划外的文件，说明是设计问题，用 kind design")
        if not isinstance(obj.get("change"), str) or not obj["change"].strip():
            problems.append("change（要怎么改）不能为空")
        repro = obj.get("repro")
        if repro_required or repro is not None:
            f, content, command = ((repro.get("file"), repro.get("content"), repro.get("command"))
                                   if isinstance(repro, dict) else (None, None, None))
            if not isinstance(f, str) or not f.startswith(REPRO_DIR) or not safe_rel(f):
                problems.append(f"repro 必须给出复现的检查 {{file, content, command}}，file 放在 {REPRO_DIR} 下"
                                "（没有能在本地重跑的失败检查时，先写一个在当前提交上会失败的复现）")
            elif not isinstance(content, str) or not content.strip() or not isinstance(command, str) or not command.strip():
                problems.append("repro 的 content（文件全文）和 command（运行它的命令）不能为空")
        evidence = obj.get("evidence")
        if not isinstance(evidence, list) or not evidence:
            problems.append("evidence 必须列出至少一处证据 {file, line}（mission 分支最新提交上的文件和行号）")
        else:
            for ev in evidence:
                f, line = (ev.get("file"), ev.get("line")) if isinstance(ev, dict) else (None, None)
                text = run_git(m.repo(), "show", f"{tip}:{f}", check=False) if isinstance(f, str) and safe_rel(f) else ""
                if not text:
                    problems.append(f"证据里的文件 {f} 在 {tip[:12]} 上不存在")
                elif not isinstance(line, int) or isinstance(line, bool) or not 1 <= line <= len(text.splitlines()):
                    problems.append(f"证据 {f} 的行号 {line} 不存在（文件有 {len(text.splitlines())} 行）")
    elif kind == "test":
        fixes = obj.get("test_fix")
        if not isinstance(fixes, list) or not fixes:
            return problems + ["kind 为 test 时 test_fix 必须列出要改的测试 [{file, content}]"]
        for fx in fixes:
            f, content = (fx.get("file"), fx.get("content")) if isinstance(fx, dict) else (None, None)
            if f not in tests:
                problems.append(f"test_fix 里的 {f} 不是冻结的验收测试")
                continue
            if not isinstance(content, str) or not content.strip():
                problems.append(f"test_fix 里 {f} 的 content 不能为空")
                continue
            if content == (m.control / "approved-tests" / f).read_text(encoding="utf-8"):
                problems.append(f"test_fix 里 {f} 的内容和现在一样")
            if f.endswith(".py"):
                try:
                    import ast
                    ast.parse(content)
                except SyntaxError as error:
                    problems.append(f"test_fix 里 {f} 不是合法的 Python：{error}")
    return problems


def run_diagnose(m: Mission, job: str, data: dict) -> dict:
    """诊断会话：先由 orc 在 tip 上把失败的检查各连跑 DIAG_RUNS 次（事实），再交给 review 模型判断根因和该改什么。"""
    import tempfile
    tip, failed = data["tip"], data.get("failed", [])
    out: dict = {"tip": tip, "trigger": data.get("trigger"), "source": data.get("source"), "failed": failed, "facts": []}
    copy = jobs_dir(m) / f"{job}.copy"
    if [f for f in failed if not f.get("ci")]:
        git_copy(m.repo(), tip, copy)
        try:
            for f in failed:
                if f.get("ci"):          # CI 上的失败：本地没有这个检查可重跑
                    continue
                check = check_command(m, f["id"]) or {"id": f["id"], "command": f["command"]}
                fails = sum(run_check_commands(copy, [check])[0]["rc"] != 0 for _ in range(DIAG_RUNS))
                out["facts"].append({"id": f["id"], "fails": fails + f.get("fails", 1),
                                     "runs": DIAG_RUNS + f.get("runs", 1)})
        finally:
            shutil.rmtree(copy, ignore_errors=True)
    base = exec_setup(m)["base"]
    owners = file_owners(m)
    rows = []
    for path in run_git(m.repo(), "diff", "--name-only", f"{base}..{tip}").splitlines():
        last = run_git(m.repo(), "log", "-1", "--format=%h %s", f"{base}..{tip}", "--", path, check=False)
        rows.append(f"| `{path}` | {'、'.join(owners.get(path, [])) or '（冻结的测试或不属于节点）'} | {last[:100]} |")
    test_files = list(approved_checks(m)["test_files"])
    used = []
    for f in failed:
        used += [t for t in check_test_files(f.get("command", ""), test_files) if t not in used]
    tests = "\n\n".join(f"### {t}\n\n````\n{(m.control / 'approved-tests' / t).read_text(encoding='utf-8')}\n````"
                        for t in used) or "（失败的检查没有直接跑冻结的测试文件；需要时用 Read 看）"
    diff = run_git(m.repo(), "diff", "--no-color", "--no-renames", f"{base}..{tip}")
    diff = (f"```diff\n{diff}\n```" if len(diff.encode()) <= MAX_INLINE_DIFF
            else "（diff 太大，不放在这里。用 Read 看当前目录里的文件。）\n\n" + run_git(m.repo(), "diff", "--stat", f"{base}..{tip}"))
    failures = "\n\n".join(
        f"- 检查 `{f['id']}`（节点 {f.get('node') or '—'}，`{f.get('command', '')}`）："
        + next((f"在 {x['runs']} 次里失败 {x['fails']} 次" for x in out["facts"] if x["id"] == f["id"]), "")
        + "\n\n```\n" + "\n".join(f.get("tail", [])) + "\n```" for f in failed) or "（没有失败的检查输出）"
    parked = "\n\n".join(f"- 节点 `{p['node']}` 停下来，它说：{p['reason']}" + (f"\n\n{p['card']}" if p.get("card") else "")
                         for p in data.get("parked", [])) or "（无）"
    hints = "\n".join(f"- {h}" for h in data.get("hints", [])) or "（无）"
    values = {"{{MISSION}}": m.name, "{{TRIGGER}}": data.get("trigger", ""), "{{FAILURES}}": failures,
              "{{PARKED}}": parked, "{{HINTS}}": hints, "{{OWNERS}}": "\n".join(rows) or "（没有改动）",
              "{{DESIGN}}": (m.control / "approved-design.md").read_text(encoding="utf-8").strip(),
              "{{DAG}}": json.dumps(list(approved_tasks(m).values()), ensure_ascii=False, indent=2),
              "{{TESTS}}": tests, "{{DIFF}}": diff, "{{TIP}}": tip[:12],
              "{{REPRO_RULE}}": ("**这次必须写复现**：没有能在本地重跑的失败检查（问题来自 CI、隐藏考题或停下的节点），"
                                 "没有复现就证明不了修复修好了问题。" if needs_repro(m, failed) else
                                 "失败的检查可以在本地重跑，这次可以不写复现（写了也会一起核对）。"),
              "{{FEEDBACK}}": f"## 上一次的诊断没通过 orc 的核对\n\n{data['feedback']}\n" if data.get("feedback") else ""}
    prompt = (ORC_ROOT / "templates" / "diagnose-brief.md").read_text(encoding="utf-8")
    for key, value in values.items():
        prompt = prompt.replace(key, value)
    cfg = m.roles()["review"]
    review_dir = Path(tempfile.mkdtemp(prefix="orc-diagnose."))
    try:
        export_tree(m, tip, review_dir, drop=(".northstar", ".github"))   # 和最终审查一样：避开 Stop hook
        run = subprocess.run(["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
                              "--permission-mode", "default", "--allowedTools=Read",
                              "--session-id", str(__import__("uuid").uuid4())],
                             input=prompt, cwd=str(review_dir), capture_output=True, text=True, timeout=REVIEW_TIMEOUT,
                             env=dict(os.environ, ORC_ROLE="diagnose"))
        write_atomic(job_file(m, job, "review.json"), run.stdout)
        text, error = claude_result(job_file(m, job, "review.json")) if run.returncode == 0 else (None, f"退出码 {run.returncode}")
    except subprocess.TimeoutExpired:
        text, error = None, f"超过 {REVIEW_TIMEOUT} 秒没有结束"
    finally:
        shutil.rmtree(review_dir, ignore_errors=True)
    if error:
        return {**out, "outcome": "unavailable", "reason": error}
    obj = last_json_object(text or "")
    problems = diagnosis_problems(m, tip, obj, needs_repro(m, failed) and isinstance(obj, dict) and obj.get("kind") == "code")
    if not problems and obj["kind"] == "code" and obj.get("repro"):
        # 复现必须真的在当前提交上失败：这次失败次数就是修复关口「撤掉修复会失败」的依据
        rp = obj["repro"]
        saved = jobs_dir(m) / f"{job}.repro" / rp["file"]
        saved.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(saved, rp["content"])
        check = {"id": "repro", "command": rp["command"], "repro": {"file": rp["file"], "path": str(saved)}}
        git_copy(m.repo(), tip, copy)
        try:
            fails = sum(run_repro(copy, check)["rc"] != 0 for _ in range(DIAG_RUNS))
        finally:
            shutil.rmtree(copy, ignore_errors=True)
        out["facts"].append({"id": "repro", "fails": fails, "runs": DIAG_RUNS})
        rp.pop("content")
        rp["path"] = str(saved)
        if not fails:
            problems.append(f"复现（`{rp['command']}`）在 {tip[:12]} 上连跑 {DIAG_RUNS} 次都通过了，没有复现出问题。"
                            "复现必须在当前提交上失败；找不到能复现的写法，说明根因判断可能不对")
    if problems:
        return {**out, "outcome": "invalid", "problems": problems}
    if obj["kind"] == "test":                 # 测试的新内容放在文件里，事件里只记路径
        fixdir = jobs_dir(m) / f"{job}.test-fix"
        for fx in obj["test_fix"]:
            dst = fixdir / fx["file"]
            dst.parent.mkdir(parents=True, exist_ok=True)
            write_atomic(dst, fx["content"])
            fx.pop("content")
            fx["path"] = str(dst)
    return {**out, "outcome": "diagnosed", "diagnosis": obj}


def diagnose_exits(m: Mission, source: str) -> List[dict]:
    return [e for e in job_exits(m, MISSION_JOBS, "diagnose") if e.get("source") == source]


def consumed(m: Mission, diag: dict) -> bool:
    return any(e.get("kind") in ("repair", "test-fix", "repair-question") and e.get("job") == diag["job"] for e in m.events())


def repair_step(m: Mission, tip: str, trigger: str, source: str, failed: List[dict], parked: List[dict]):
    """有问题要修：没诊断就诊断；诊断不合格发回；诊断好了就按它动手。调用前已确认没有在跑的 mission 级任务。"""
    exits = diagnose_exits(m, source)
    last = exits[-1] if exits else None
    if last is None or (consumed(m, last) and answered_after(m, last)):
        launch_diagnose(m, tip, trigger, source, failed, parked)
        return "wait", False
    outcome = last.get("outcome")
    if outcome == "invalid":
        n = consecutive(exits, {"invalid"}, {"diagnosed"})
        if n <= DIAG_REPAIRS:
            launch_diagnose(m, tip, trigger, source, failed, parked, "\n".join(f"- {p}" for p in last["problems"]))
            return "wait", False
        if answered_after(m, last):
            launch_diagnose(m, tip, trigger, source, failed, parked)
            return "wait", False
        ask_repair(m, "诊断连续不合格", f"mission {m.name} 的诊断连续 {n} 次没通过 orc 的核对：\n"
                   + "\n".join(f"- {p}" for p in last["problems"]), last["job"], RERUN_HINTS.get(trigger, "重新诊断一次。"))
        return None, True
    if outcome == "unavailable":
        if answered_after(m, last):
            launch_diagnose(m, tip, trigger, source, failed, parked)
            return "wait", False
        ask_repair(m, "诊断没能完成", f"mission {m.name} 的诊断会话没能完成（{last.get('reason')}）。"
                   "评审出错时不放行。", last["job"], RERUN_HINTS.get(trigger, "检查登录、代理和额度后重新诊断。"))
        return None, True
    if consumed(m, last) and m.state == "reviewing" and any(
            e.get("kind") == "repair" and e.get("job") == last["job"] for e in m.events()):
        # 上次写完 repair 事件、还没回到 executing 就断了：补上这一步
        m.transition("executing", "orc step", reason=f"按诊断 {last['job']} 重新打开节点修复")
        return None, True
    if consumed(m, last):
        return (f"error mission {m.name} 的诊断 {last['job']} 已经处理过，但问题还在原地。这是 orc 的 bug；"
                "把 events.jsonl 给用户看。"), False
    d = last["diagnosis"]
    summary = f"诊断（{last['job']}）：{d['cause']}"
    if d["kind"] == "design":
        ask_repair(m, "诊断认为是设计问题", f"{summary}\n\n诊断会话认为这不是实现的 bug，计划或设计本身需要改，修复闭环不能自己决定。"
                   + (f"\n\n它的说明：{d.get('change', '')}" if d.get("change") else ""), last["job"], RERUN_HINTS.get(trigger, ""))
        return None, True
    if repair_rounds(m) >= REPAIR_ROUNDS:
        ask_repair(m, f"修复闭环 {REPAIR_ROUNDS} 轮还没修好",
                   f"mission {m.name} 已经按诊断修了 {REPAIR_ROUNDS} 轮，问题还在。最新的{summary}", last["job"],
                   RERUN_HINTS.get(trigger, ""))
        return None, True
    if d["kind"] == "test":
        stage_test_fix(m, last)
        return None, True
    return repair_code(m, last)


def repair_code(m: Mission, diag: dict):
    """诊断认为是实现的 bug：按文件归属重新打开节点去修；停着的节点要么撤回打回、要么等修好后继续。"""
    d, owners_of = diag["diagnosis"], file_owners(m)
    targets: Dict[str, List[str]] = {}
    for f in d["files"]:
        targets.setdefault(owners_of[f][0], []).append(f)
    states = m.node_states()
    # 可以重入：中途断掉后再来，已经重新打开或继续过的节点跳过；repair 事件在全部动作做完后才写
    acted = {e["node"] for e in m.events()[event_index(m, diag):]
             if e.get("kind") in ("node-reopen", "node-unparked") and e.get("node") in targets}
    bad = {n: states[n] for n in targets if n not in acted and states[n] not in ("integrated", "parked")}
    if bad:
        ask_repair(m, "要修的节点还没做完", f"诊断（{diag['job']}）：{d['cause']}\n\n要改的文件属于还没做完的节点："
                   + "、".join(f"{n}（{s}）" for n, s in bad.items()) + "。修复闭环只能重新打开已经集成或停着的节点。", diag["job"],
                   RERUN_HINTS.get(diag.get("trigger", ""), ""))
        return None, True
    facts = {x["id"]: x for x in diag.get("facts", [])}
    checks = [f["id"] for f in diag.get("failed", []) if check_command(m, f["id"])]
    issue = {"problem": f"诊断：{d['cause']}", "evidence": f"要怎么改：{d['change']}\n\n证据："
             + "、".join(f"{e['file']}:{e['line']}" for e in d.get("evidence", []))}
    round_ = repair_rounds(m) + 1
    for node, files in targets.items():
        if node in acted:
            continue
        proof = (["repro"] if d.get("repro") else []) + checks
        repair = {"job": diag["job"], "files": files, "checks": checks, "tip": diag["tip"],
                  "fails": sum(facts.get(c, {}).get("fails", 0) for c in proof),
                  "runs": sum(facts.get(c, {}).get("runs", 0) for c in proof), "solo": len(targets) == 1,
                  "repro": {"file": d["repro"]["file"], "path": d["repro"]["path"], "command": d["repro"]["command"]}
                  if d.get("repro") else None, "cause": d["cause"], "change": d["change"]}
        if states[node] == "integrated" or (node_ctl(m, node) / "unresolved-rework").exists():
            # 被打回修复的节点：修复关口只放行诊断指定的文件（正常执行中停下的节点还有自己的验收标准要做，不限制）
            write_atomic(node_ctl(m, node) / "repair.json", json.dumps(repair, ensure_ascii=False, indent=2) + "\n")
        note = (f"这是修复闭环：只改诊断指定的文件 {'、'.join(f'`{f}`' for f in files)}。修好后 orc 会把失败的检查连跑 "
                f"{DIAG_RUNS} 次、撤掉修复确认失败能重现，再请评审核对改动就是诊断说的那件事、没有改变别的节点承诺过的行为。")
        if states[node] == "integrated":
            if changed_paths(m.worktree(node)):     # 集成后留下的临时文件：存成补丁，不挡重新打开
                discard_changes(m, node)
            reopen_node(m, node, [issue], round_, "修复", note)
        else:                                   # 停着的节点自己就是要修的
            unpark_node(m, node, f"诊断认为问题就在你这个节点的文件里。\n\n{issue['problem']}\n\n{issue['evidence']}\n\n{note}\n\n"
                                  "修好后按 commit 格式结束这一轮；acceptance 写这次修的验收标准编号，没有对应的就写 []。")
    for node, state in states.items():
        if state == "parked" and node not in targets:
            if not withdraw_reopen(m, node):
                info = json.loads(read1(node_ctl(m, node) / "parked") or "{}")
                info["waiting"], info["repair"] = sorted(targets), diag["job"]
                write_atomic(node_ctl(m, node) / "parked", json.dumps(info, ensure_ascii=False) + "\n")
    m.append("repair", "orc step", job=diag["job"], targets=targets, cause=d["cause"], change=d["change"])
    if m.state == "reviewing":
        m.transition("executing", "orc step", reason=f"按诊断重新打开节点修复：{'、'.join(targets)}")
    return None, True


def park_node(m: Mission, node: str, reason: str, source: str) -> None:
    write_atomic(node_ctl(m, node) / "parked", json.dumps({"reason": reason, "source": source}, ensure_ascii=False) + "\n")
    m.append("node-parked", "orc step", node=node, reason=reason, source=source)
    print(f"节点 {node}：停下，等诊断（{reason[:80]}）")


def sync_to_tip(m: Mission, node: str) -> Optional[Path]:
    """把 mission 分支的最新提交合进节点的 worktree（修复或改测试之后），基线改成合进来的 mission tip。没提交的改动先存成补丁撤回。"""
    wt, ctl, work = m.worktree(node), node_ctl(m, node), node_work(m, node)
    patch = discard_changes(m, node) if changed_paths(wt) else None
    # 不是快进时会生成合并提交，它也会进 PR：产品 CI 要求每个提交（包括合并提交）首行带 [N#]
    clauses = approved_tasks(m)[node].get("clauses", [])
    message = f"[{','.join(clauses)}] orc：{node} 合并 mission 分支的最新提交（修复闭环）" if clauses \
        else f"[orc] orc：{node} 合并 mission 分支的最新提交（修复闭环）"
    tip = mission_tip(m)
    try:
        run_git(wt, *ORC_GIT, "merge", "-q", "--no-edit", "-m", message, tip)
    except OrcError as error:
        run_git(wt, "merge", "--abort", check=False)
        raise SyncConflict(node, tip, wt, clauses, str(error)) from error
    # 基线是合进来的 mission tip，不是合并提交：集成脚本要求基线在 mission 分支上；整体评审的 diff（基线..HEAD）
    # 也因此仍然包含节点自己还没集成的提交
    row = read1(ctl / "worktrees.txt").split("\t")
    row[2] = tip
    for d in (ctl, work):
        write_atomic(d / "worktrees.txt", "\t".join(row) + "\n")
    return patch


def sync_conflict_block(m: Mission, c: SyncConflict) -> str:
    """合并冲突只会出在一个文件归多个节点的时候，orc 不替你挑哪边：停下问用户。回答后 orc 再合并一次，已经合并过就直接继续。"""
    ctx = m.replay()
    if ctx["state"] == "blocked":
        # 签名测试修正时冲突：那个问题 orc 已经记了回答，先离开它，再问这个
        if ctx["question"] not in ctx["answered"]:
            return f"error {c}。mission 停在一个没回答的问题上，这里不该合并。这是 orc 的 bug；把 events.jsonl 给用户看。"
        m.transition(ctx["blocked_from"], "orc step", reason=f"问题 {ctx['question']} 已回答")
    prefix = f"[{','.join(c.clauses)}]" if c.clauses else "[orc]"
    path = m.block("节点合并 mission 分支冲突",
                   f"{c}。只有一个文件归多个节点时才会这样，orc 不替你挑哪边。这次合并已经撤销，节点保持原样。\n\n"
                   "可以这样回答（orc 都能直接执行）：\n"
                   f"- 你来解决：在 `{c.worktree}` 里运行 `git merge {c.tip}`，解决冲突后提交，提交说明首行以 `{prefix}` 开头"
                   "（产品 CI 要求每个提交都带条款编号），然后回答「继续」。orc 会再合并一次，已经合并过就直接往下走。\n"
                   f"- 放弃这一轮：运行 `orc abandon --mission {m.name} \"<原因>\"`（是 phase 里的 mission 就再运行 orc phase 重跑）。",
                   "ask-user", "orc step")
    return f"ask-user {path.read_text(encoding='utf-8').strip()}"


def unpark_node(m: Mission, node: str, message: str) -> None:
    patch = sync_to_tip(m, node)
    (node_ctl(m, node) / "parked").unlink(missing_ok=True)
    if patch:
        message += f"\n\n（你没提交的改动已存成补丁 {patch} 并撤回；worktree 已合并 mission 分支的最新提交。需要的话从补丁里取回。）"
    m.append("node-unparked", "orc step", node=node, message=message)
    print(f"节点 {node}：继续")


def withdraw_reopen(m: Mission, node: str) -> bool:
    """最终审查打回、但问题不在它这里的节点：重新打开后没有新提交，就撤回这次打回，回到 integrated。
    没提交的改动（例如执行会话留下的临时脚本）先存成补丁再撤回，不留在 worktree 里。"""
    ctl, work, wt = node_ctl(m, node), node_work(m, node), m.worktree(node)
    # 是不是被打回过看 reopen-prev（重新打开时写，集成或撤回时才删）。unresolved-rework 不行：
    # 执行会话回「已经满足」时提交关口就删了它，之后集成永远走不到撤回
    if not (ctl / "reopen-prev").exists():
        return False
    base = read1(ctl / "worktrees.txt").split("\t")[2]
    if run_git(wt, "rev-parse", "HEAD") != base:
        return False
    if changed_paths(wt):
        discard_changes(m, node)
    prev = json.loads(read1(ctl / "reopen-prev") or '{"ctl": "integrated", "work": "integrated"}')
    write_atomic(ctl / "state", prev["ctl"] + "\n")
    write_atomic(work / "state", prev["work"] + "\n")
    for name in ("unresolved-rework", "parked", "repair.json", "reopen-prev"):
        (ctl / name).unlink(missing_ok=True)
    m.append("node-withdrawn", "orc step", node=node, reason="被打回后没有任何改动（问题不在这个节点）")
    print(f"节点 {node}：撤回打回，回到 integrated")
    return True


def unpark_ready(m: Mission) -> None:
    """等别的节点修好的停着的节点：那些节点修好、重新集成之后，合并最新提交继续。"""
    states = m.node_states()
    for node, state in states.items():
        if state != "parked":
            continue
        info = json.loads(read1(node_ctl(m, node) / "parked") or "{}")
        waiting = info.get("waiting")
        if not waiting or any(states.get(w) != "integrated" for w in waiting):
            continue
        repair = next((i for i, e in enumerate(m.events()) if e.get("kind") == "repair" and e.get("job") == info.get("repair")), None)
        if repair is None or any(not [e for e in m.events()[repair:] if e.get("kind") == "job-exit" and e.get("type") == "integrate"
                                      and e.get("node") == w and e.get("outcome") == "integrated"] for w in waiting):
            continue
        if withdraw_reopen(m, node):       # 被打回、自己没有新提交：撤回打回，不继续（继续了也没东西可集成）
            continue
        unpark_node(m, node, f"你停下来等的问题已经由节点 {'、'.join(waiting)} 修好并集成（诊断 {info.get('repair')}）。"
                             "worktree 已合并 mission 分支的最新提交。继续当前这条验收标准；做完按格式结束这一轮。")


def parked_payload(m: Mission) -> Tuple[str, List[dict], List[dict]]:
    """停着的节点交给诊断的材料：它说的原因、最近一张纠偏单；被最终审查打回的，带上那次失败的检查。"""
    parked, failed = [], []
    finals = [e for e in job_exits(m, MISSION_JOBS, "final")]
    for node, state in m.node_states().items():
        if state != "parked":
            continue
        info = json.loads(read1(node_ctl(m, node) / "parked") or "{}")
        cards = sorted(node_work(m, node).glob("correction-*.md"), key=lambda p: int(p.stem.split("-")[1]))
        parked.append({"node": node, "reason": info.get("reason", ""),
                       "card": cards[-1].read_text(encoding="utf-8")[-3000:] if cards else ""})
        if (node_ctl(m, node) / "unresolved-rework").exists() and finals:
            last = finals[-1]
            same_tip = last.get("tip") == mission_tip(m)
            if last.get("failed"):
                # 那次失败的次数只有在同一个提交上才能算进诊断的事实（修复关口会引用它证明「撤掉修复会失败」）
                failed += [f if same_tip else {**f, "fails": 0, "runs": 0}
                           for f in last["failed"] if f["id"] not in [x["id"] for x in failed]]
            else:                                # 旧格式（打回节点的最终审查）：从检查结果和问题里还原
                evidence = {i.get("node"): i.get("evidence", "") for i in last.get("issues", [])}
                for cid, ok in last.get("checks", {}).items():
                    c = check_command(m, cid)
                    if not ok and c and cid not in [x["id"] for x in failed]:
                        failed.append({"id": cid, "node": c.get("node"), "command": c["command"],
                                       "tail": str(evidence.get(c.get("node"), "")).splitlines()[-8:],
                                       "fails": 1 if same_tip else 0, "runs": 1 if same_tip else 0})
    latest = max((i for i, e in enumerate(m.events()) if e.get("kind") == "node-parked"), default=0)
    return f"parked:{latest}", failed, parked


# -- 测试本身有错：诊断写好修正 → 放进 control/（旧的留备份）→ 用户签名才生效；用户回答意见就撤回、重新诊断

def pending_test_fix(m: Mission) -> Optional[dict]:
    evs = m.events()
    fixes = [e for e in evs if e.get("kind") == "test-fix"]
    if not fixes:
        return None
    last = fixes[-1]
    done = any(e.get("kind") in ("test-fix-signed", "test-fix-withdrawn") and e.get("k") == last["k"] for e in evs)
    return None if done else last


def frozen_section(base: str, digest: str, tests: Dict[str, str]) -> str:
    rows = "".join(f"| `{rel}` | `{h}` |\n" for rel, h in sorted(tests.items()))
    return (f"\n## 冻结的验收测试\n\n"
            "下面的测试由独立的验证会话在实现之前写好，和这份文件一起签名。你可以读、可以运行，**不能改、不能删、不能移动**；"
            "改动它们的提交会被拒绝。你的节点只有在属于它的检查全部通过时才算完成。你可以另外写自己的单元测试"
            "（放在你的 `files` 里），但它们不算数。\n\n"
            f"基线提交：`{base}`\n\nchecks 清单的 sha256：`{digest}`（`approved-checks.json`）\n\n"
            f"| 测试文件 | sha256 |\n| --- | --- |\n{rows}")


FIX_BACKUP = ("approved-checks.json", "brief-exec.md", "approved.sha256", "approved.sha256.sig")


def stage_test_fix(m: Mission, diag: dict) -> None:
    """把诊断写好的测试修正放进 control/：更新测试文件、approved-checks.json、brief-exec.md 里的哈希和签名清单，删掉旧签名。
    旧的文件先备份；用户签名才生效，回答意见就恢复备份。"""
    d = diag["diagnosis"]
    k = len([e for e in m.events() if e.get("kind") == "test-fix"]) + 1
    root = m.dir / "repair" / f"test-fix-{k}"
    # 先写事件再动 control/：中途断掉时 step 开头的 test_fix_step 会看到它，从备份重新做一遍（apply_test_fix 可以重入）
    fix = m.append("test-fix", "orc step", job=diag["job"], k=k, files=[fx["file"] for fx in d["test_fix"]],
                   paths={fx["file"]: fx["path"] for fx in d["test_fix"]},
                   backup=str(root / "backup"), diff=str(root / "test.diff"), cause=d["cause"])
    apply_test_fix(m, fix)


def apply_test_fix(m: Mission, fix: dict) -> None:
    """按 test-fix 事件改 control/ 并提问。全部从备份算出来，重复执行结果相同。"""
    import difflib
    c, k, backup = m.control, fix["k"], Path(fix["backup"])
    if not (backup / ".complete").is_file():      # 备份完整之前 control/ 还没动过
        shutil.rmtree(backup, ignore_errors=True)
        backup.mkdir(parents=True)
        for name in FIX_BACKUP:
            if (c / name).is_file():
                shutil.copyfile(c / name, backup / name)
        shutil.copytree(c / "approved-tests", backup / "approved-tests")
        write_atomic(backup / ".complete", "")
    approved = json.loads((backup / "approved-checks.json").read_text(encoding="utf-8"))
    diffs = []
    for rel in fix["files"]:
        old = (backup / "approved-tests" / rel).read_text(encoding="utf-8")
        new = Path(fix["paths"][rel]).read_text(encoding="utf-8")
        diffs.append("".join(difflib.unified_diff(old.splitlines(True), new.splitlines(True), f"a/{rel}", f"b/{rel}")))
        dst = c / "approved-tests" / rel
        write_atomic(dst, new)
        approved["test_files"][rel] = hashlib.sha256(dst.read_bytes()).hexdigest()
    text = json.dumps(approved, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    write_atomic(c / "approved-checks.json", text)
    brief = (backup / "brief-exec.md").read_text(encoding="utf-8")
    start = brief.index("\n## 冻结的验收测试\n")
    nxt = brief.find("\n## ", start + 1)
    brief = brief[:start] + frozen_section(approved["base"], hashlib.sha256(text.encode()).hexdigest(), approved["test_files"]) \
        + (brief[nxt:] if nxt != -1 else "")
    write_atomic(c / "brief-exec.md", brief)
    names = [line.split("  ", 1)[1] for line in (backup / "approved.sha256").read_text(encoding="utf-8").splitlines() if "  " in line]
    write_atomic(c / "approved.sha256", "".join(f"{hashlib.sha256((c / n).read_bytes()).hexdigest()}  {n}\n" for n in names))
    (c / "approved.sha256.sig").unlink(missing_ok=True)
    diff_path = Path(fix["diff"])
    write_atomic(diff_path, "\n".join(diffs))
    if any(e.get("kind") == "repair-question" and e.get("test_fix") == k for e in m.events()):
        return
    control = os.path.realpath(c)
    q = (f"诊断（{fix['job']}）认为冻结的验收测试本身有错：{fix['cause']}\n\n修正（{diff_path}）：\n\n```diff\n"
         + "\n".join(diffs)[:6000] + "\n```\n\n"
         f"- 同意：在你自己的终端运行 `northstar approve-mission {control}`，核对后输入 SEAL 并按 Touch ID。签名后 orc 把修正提交到 "
         "mission 分支，接着往下走，已经做好的工作都保留。\n"
         "- 不同意：回答你的意见。orc 撤回这个修正（恢复签名过的旧测试），把你的意见交给诊断会话重新诊断。\n"
         f"- 放弃这一轮：运行 `orc abandon --mission {m.name} \"<原因>\"`。")
    # 和 m.block 一样，只是先记下这是哪次修正的问题，再进入 blocked：中途断掉也找得到问题
    path = m.ask(q, "ask-user", "orc step")
    m.append("repair-question", "orc step", id=path.stem, job=fix["job"], reason="测试修正", test_fix=k)
    m.transition("blocked", "orc step", reason="等用户确认测试的修正", question=path.stem, type="ask-user")
    print(f"mission {m.name}：诊断认为测试有错，修正已放进 control/，等用户签名（northstar approve-mission {control}）")


def signature_ok(m: Mission) -> bool:
    control = os.path.realpath(m.control)
    northstar = northstar_root() / "bin" / "northstar"
    if not (m.control / "approved.sha256.sig").is_file():
        return False
    if subprocess.run([str(northstar), "verify-mission", control], capture_output=True).returncode != 0:
        return False
    return subprocess.run([sys.executable, str(SCRIPTS / "verify-approved-authority.py"), "--control-dir", control],
                          capture_output=True).returncode == 0 and verify_frozen_checks(m) is None


def test_fix_step(m: Mission) -> Optional[str]:
    """step 开头：有等签名的测试修正时，签了就生效，用户回答了意见就撤回；都没有就照常停在问题上。返回 None 表示照常往下走。"""
    fix = pending_test_fix(m)
    if fix is None:
        return None
    q = next((e for e in m.events() if e.get("kind") == "repair-question" and e.get("test_fix") == fix["k"]), None)
    if q is None:                 # 改 control/ 或提问的中途断掉了：从备份重做一遍，补问
        apply_test_fix(m, fix)
        q = next(e for e in m.events() if e.get("kind") == "repair-question" and e.get("test_fix") == fix["k"])
    ctx = m.replay()
    answered = q["id"] in ctx["answered"]
    if ctx["state"] == "blocked" and ctx["question"] != q["id"] and ctx["question"] not in ctx["answered"]:
        return None       # 停在别的问题上（例如签名生效时合并冲突）：照常停在那个问题上，等它的回答
    if any(e.get("kind") == "test-fix-withdrawing" and e.get("k") == fix["k"] for e in m.events()):
        withdraw_test_fix(m, fix)     # 撤回做到一半断掉：旧签名可能已经恢复，不能当成同意，接着撤回
        return None
    if not answered and m.state != "blocked":     # 记下问题后、进入 blocked 前断掉
        m.transition("blocked", "orc step", reason="等用户确认测试的修正", question=q["id"], type="ask-user")
    if signature_ok(m):
        finalize_test_fix(m, fix, q, answered)
        return None
    if answered:
        withdraw_test_fix(m, fix)
        return None
    return f"ask-user {(m.dir / 'questions' / (q['id'] + '.md')).read_text(encoding='utf-8').strip()}"


def finalize_test_fix(m: Mission, fix: dict, q: dict, answered: bool) -> None:
    parent = parent_worktree(m)
    approved = approved_checks(m)
    for rel in fix["files"]:
        shutil.copyfile(m.control / "approved-tests" / rel, parent / rel)
    run_git(parent, "add", "--", *fix["files"])
    clauses = sorted({c for t in approved_tasks(m).values() for c in t.get("clauses", [])}, key=lambda c: int(c[1:]))
    prefix = f"[{','.join(clauses)}]" if clauses else "[orc]"
    if run_git(parent, "diff", "--cached", "--name-only"):     # 上次已经提交、还没记事件就断了：不再提交
        run_git(parent, *ORC_GIT, "commit", "-q", "-m",
                f"{prefix} orc：冻结 mission {m.name} 的验收测试（第 {fix['k']} 次修正，用户已签名）\n\n根因: {fix['cause']}")
    for rel, digest in approved["test_files"].items():
        if sha256_file(parent / rel) != digest:
            raise OrcError(f"修正后 mission 分支上的验收测试 {rel} 和签名的哈希不一致。把这条消息告诉用户。")
    tip = mission_tip(m)
    if not answered:
        answer = m.dir / "answers" / f"{q['id']}.md"
        write_atomic(answer, "已签名同意测试的修正。\n")
        m.append("answer", "orc step", id=q["id"], file=str(answer))
    # 已开工、没集成的节点要拿到新测试；停着的节点继续。可以重入：中途断掉（或合并冲突问了用户）后再来，
    # 已经合并到这个 tip 的节点跳过；test-fix-signed 最后才记，记了就不会再进来
    for node, state in m.node_states().items():
        if state in ("pending", "integrated"):
            continue
        if state == "parked" and withdraw_reopen(m, node):
            continue
        if state == "parked":
            unpark_node(m, node, f"冻结的验收测试已按诊断修正，用户签了名（{fix['diff']}）。worktree 已合并最新提交。"
                                 "继续当前这条验收标准；做完按格式结束这一轮。")
        elif read1(node_ctl(m, node) / "worktrees.txt").split("\t")[2] != tip:
            sync_to_tip(m, node)
    m.append("test-fix-signed", "orc step", k=fix["k"], tip=tip)
    print(f"mission {m.name}：测试修正已签名并提交（{tip[:12]}）")


def withdraw_test_fix(m: Mission, fix: dict) -> None:
    backup, c = Path(fix["backup"]), m.control
    if not any(e.get("kind") == "test-fix-withdrawing" and e.get("k") == fix["k"] for e in m.events()):
        m.append("test-fix-withdrawing", "orc step", k=fix["k"])   # 先记下：恢复到一半断掉也知道是在撤回
    shutil.rmtree(c / "approved-tests", ignore_errors=True)
    shutil.copytree(backup / "approved-tests", c / "approved-tests")
    for name in FIX_BACKUP:
        (c / name).unlink(missing_ok=True)
        if (backup / name).is_file():
            shutil.copyfile(backup / name, c / name)
    m.append("test-fix-withdrawn", "orc step", k=fix["k"])
    print(f"mission {m.name}：用户没有同意测试修正，已恢复签名过的测试，重新诊断")


def issues_text(issues: List[dict]) -> str:
    return "\n".join(f"- 节点 `{i.get('node') or '—'}`：{i.get('problem', '')}（证据：{str(i.get('evidence', ''))[:300]}）"
                     for i in issues)


def acceptance_problem(m: Mission, tip: str, final: dict, ci: dict) -> Optional[str]:
    """进入 accepted 之前不只信日志：重新核对协议文件、PR 的 head、最终审查和 CI 都针对同一个提交且都通过。"""
    problem = recheck_integrated(m)
    if problem:
        return problem
    if mission_tip(m) != tip:
        return f"mission 分支的 tip 变了（{mission_tip(m)[:12]}），最终审查看的是 {tip[:12]}"
    if not final.get("checks") or not all(final["checks"].values()):
        return "最终审查记录里的检查结果不是全部通过"
    expected = {c["id"] for c in approved_checks(m)["checks"]}
    if not expected <= set(final["checks"]):
        return "最终审查没有跑全部冻结检查：缺 " + "、".join(sorted(expected - set(final["checks"])))
    head = gh(m, "pr", "view", ci["pr"], "--json", "headRefOid", "--jq", ".headRefOid")
    if head != tip:
        return f"PR 的 head 是 {head[:12]}，不是审查过的 {tip[:12]}"
    required = accept_config()["required_checks"]
    if any(ci.get("checks", {}).get(n) != "pass" for n in required):
        return "CI 记录里 required_checks 不是全部通过"
    return None


def h_reviewing(m: Mission):
    for start in mission_running(m):
        status, rc = job_status(m, start)
        timed_out = False
        if status == "running":
            if not session_overdue(start, exec_setup(m)["config"]):
                continue
            kill_job(start)
            timed_out = True
        finish_mission_job(m, start, status, rc, timed_out)
    if mission_running(m):
        return "wait", False
    tip = mission_tip(m)
    # 1. 最终审查
    finals = [e for e in job_exits(m, MISSION_JOBS, "final") if e.get("tip") == tip]
    if finals and finals[-1].get("outcome") == "checks-failed" and not retry_requested(m, finals[-1]):
        # 检查没通过靠修复闭环出去（修好后 tip 会变）：回答提示不作废这次结果、不重跑最终审查，交给 repair_step 重新诊断。
        # 回答「重试」才作废它、重做最终审查（偶发失败、环境已经修好）；还失败就是新的一次，重新诊断
        last = finals[-1]
        return repair_step(m, tip, "final", last["job"], last["failed"], [])
    final = mission_exit(m, "final", tip)
    if final is None:
        launch_mission_job(m, "final", tip, {})
        return "wait", False
    outcome = final.get("outcome")
    if outcome == "rework":                  # 最终审查的模型判不通过：它已经把问题落到了节点上
        return reopen_for(m, final, "final", "最终审查")
    if outcome != "passed":
        why = final.get("reason", "")
        qtype = "mediate" if outcome == "unroutable" else "ask-user"
        m.block("最终审查没能完成" if outcome == "unavailable" else "合并后的检查落不到节点",
                f"mission {m.name} 的最终审查没能完成：{why}\n\n评审不降级、出错时不放行。排除问题后回答「重试」，orc 会重新做最终审查。",
                qtype, "orc step")
        return None, True
    # 1b. 跨 mission 评审（属于某个产品的 mission；PLAN 阶段 6）：默认以已经合并的为准，冲突就打回本 mission 的节点
    if mission_product(m) is not None:
        cross = mission_exit(m, "cross", tip)
        if cross is None:
            launch_mission_job(m, "cross", tip, {})
            return "wait", False
        if cross.get("outcome") == "rework":
            return reopen_for(m, cross, "cross", "跨 mission 评审")
        if cross.get("outcome") != "passed":
            m.block("跨 mission 评审没能完成", f"mission {m.name} 的跨 mission 评审没能完成：{cross.get('reason', '')}\n\n"
                    "评审不降级、出错时不放行。排除问题后回答「重试」，orc 会重新评审。", "ask-user", "orc step")
            return None, True
    # 2. PR 和 CI
    try:
        pr = current_pr(m, tip) or ensure_pr(m, tip)
    except OrcError as error:
        return f"error {error}", False
    ci_all = [e for e in job_exits(m, MISSION_JOBS, "ci") if e.get("tip") == tip]
    if ci_all and retry_requested(m, ci_all[-1]):
        pass                                 # 回答了「重试」：下面 mission_exit 作废这次结果，重新等 CI
    elif ci_all and ci_all[-1].get("outcome") == "failed" and ci_all[-1].get("details"):
        # CI 的检查没通过：公开检查的日志、考题报的条款都有，就直接交给修复闭环；缺材料的才要用户给提示
        last = ci_all[-1]
        failed, missing = ci_failed_payload(last)
        q = next((e for e in reversed(m.events()) if e.get("kind") == "repair-question" and e.get("job") == last["job"]), None)
        hints = repair_question_answers(m, event_index(m, q)) if q else []
        if failed and (not missing or hints):
            return repair_step(m, tip, "ci", last["job"], failed, [])
        if hints:
            return repair_step(m, tip, "ci", last["job"], [], [{"node": "CI", "reason": last.get("reason", "")}])
    elif ci_all and ci_all[-1].get("outcome") != "passed":
        q = next((e for e in reversed(m.events()) if e.get("kind") == "repair-question" and e.get("job") == ci_all[-1]["job"]), None)
        hints = repair_question_answers(m, event_index(m, q)) if q else []
        if hints:                            # 用户给了提示：进入修复闭环
            return repair_step(m, tip, "ci", ci_all[-1]["job"], [], [{"node": "CI", "reason": ci_all[-1].get("reason", "")}])
    ci = mission_exit(m, "ci", tip)
    if ci is None:
        launch_mission_job(m, "ci", tip, {"pr": pr["url"]})
        return "wait", False
    if ci.get("outcome") != "passed":
        failed, missing = ci_failed_payload(ci) if ci.get("details") else ([], [])
        if failed and not missing:
            return repair_step(m, tip, "ci", ci["job"], failed, [])
        hidden = [n for n in missing if n in accept_config()["hidden_checks"]]
        unknown = sum(ci.get("details", {}).get(n, {}).get("unknown", 0) for n in hidden)
        why = (f"隐藏考题的日志里有 {unknown} 个不属于这个 mission 的条款编号。被测的代码也能往日志里写这种行，orc 不采用这次报告"
               "（编号本身也不记下来）。你在本地跑一遍考题，把哪条条款、什么行为不对告诉 orc（不用贴考题原文）"
               if unknown else
               "隐藏考题的输出全部丢掉，CI 日志里也没有它报的条款（workflow 要输出「NORTHSTAR-EXAM N# fail」行，"
               "见 STATE.md「修复闭环」），orc 不知道是哪条没过。你在本地跑一遍考题，把哪条条款、什么行为不对告诉 orc（不用贴考题原文）"
               if hidden else "orc 取不到失败的日志" if missing and ci.get("details") else "")
        ask_repair(m, "PR 的 CI 没通过", f"mission {m.name} 的 PR {pr['url']} 的 CI 没通过：{ci.get('reason')}"
                   + (f"\n\n{why}。" if why else "") + "\n\n你的提示会交给诊断会话，它诊断并修复。",
                   ci["job"], "只重新等 CI（例如 CI 本身出了故障、已经重跑）。")
        return None, True
    # 3. 进入 accepted 前重新核对
    try:
        problem = acceptance_problem(m, tip, final, ci)
    except OrcError as error:
        return f"error {error}", False
    if problem:
        return (f"error mission {m.name} 验收前重新核对发现：{problem}。日志和实际状态对不上，不要继续；把这条消息告诉用户。"), False
    # 4. 状态页：说明由会话写、orc 核对；页面由 orc 生成、发布
    notes = mission_exit(m, "notes", tip)
    if notes is None or notes.get("outcome") != "valid":
        if notes is not None:
            n = consecutive([e for e in job_exits(m, MISSION_JOBS, "notes") if e.get("tip") == tip], {"invalid"})
            if n > NOTES_REPAIRS:
                m.block("状态页的说明连续不合格", f"mission {m.name} 状态页的说明连续 {n} 次没通过核对：\n"
                        + "\n".join(f"- {p}" for p in notes["problems"]) + "\n\n回答后 orc 会重新写一次。", "mediate", "orc step")
                return None, True
            launch_notes(m, tip, "\n".join(f"- {p}" for p in notes["problems"]))
        else:
            launch_notes(m, tip)
        return "wait", False
    try:
        url = ensure_published(m, "status", render_status(m, tip), f"orc mission {m.name} 的状态页：节点、检查、提交和 PR，全部由日志生成。")
    except OrcError as error:
        return f"error {error}", False
    m.transition("accepted", "orc step", reason=f"最终审查通过、CI 通过、状态页已发布（{url}）")
    print(f"mission {m.name}：reviewing → accepted")
    return None, True


def cleanup_items(m: Mission) -> List[Tuple[str, str, str]]:
    """要清理的东西，只来自 orc 自己记录过的：每个节点控制目录的 worktrees.txt，和 exec-setup 里的父 worktree。
    返回 (类型, 路径或分支, 说明)。mission 分支留着：PR 还没合并。"""
    items: List[Tuple[str, str, str]] = []
    for node in approved_tasks(m):
        row = read1(node_ctl(m, node) / "worktrees.txt").split("\t")
        if len(row) == 4:
            items.append(("worktree", row[0], f"节点 {node} 的 worktree"))
            items.append(("branch", row[1], f"节点 {node} 的分支"))
    items.append(("worktree", exec_setup(m)["parent_worktree"], f"mission 分支 {mission_branch(m)} 的 worktree（分支保留给 PR）"))
    return items


def h_accepted(m: Mission):
    repo = m.repo()
    listed = run_git(repo, "worktree", "list", "--porcelain")
    worktrees = {os.path.realpath(l[len("worktree "):]) for l in listed.splitlines() if l.startswith("worktree ")}
    items = cleanup_items(m)
    print(f"mission {m.name}：要清理的（只动 orc 记录过的）：")
    for kind, target, label in items:
        print(f"  - {label}：{target}")
    removed = []
    for kind, target, label in items:
        if kind == "worktree":
            if os.path.realpath(target) not in worktrees:
                continue                              # 已经清理过（中断后重跑）
            if changed_paths(Path(target)):
                return f"error {label} {target} 里有没提交的改动，orc 不删。把这条消息告诉用户。", False
            run_git(repo, "worktree", "remove", target)
        else:
            if subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/heads/{target}"],
                              capture_output=True).returncode != 0:
                continue
            if subprocess.run(["git", "-C", str(repo), "merge-base", "--is-ancestor", f"refs/heads/{target}",
                               f"refs/heads/{mission_branch(m)}"]).returncode != 0:
                return f"error {label} {target} 有没集成进 {mission_branch(m)} 的提交，orc 不删。把这条消息告诉用户。", False
            run_git(repo, "branch", "-D", target)
        removed.append(target)
    m.append("cleanup", "orc step", removed=removed, kept=[mission_branch(m)])
    m.transition("cleaned", "orc step", reason="已集成节点的 worktree 和分支已清理")
    print(f"mission {m.name}：accepted → cleaned")
    return None, True


def h_cleaned(m: Mission):
    """终态：状态页（含清理结果）是最新的才输出 report；没有状态页就不报告完成。"""
    receipts = json.loads((m.dir / "publish.json").read_text()) if (m.dir / "publish.json").is_file() else {}
    if "status" not in receipts:
        return f"error mission {m.name} 已清理，但没有状态页：不报告完成。这是 orc 的 bug；把 events.jsonl 给用户看。", False
    tip = run_git(m.repo(), "rev-parse", f"refs/heads/{mission_branch(m)}")
    try:
        url = ensure_published(m, "status", render_status(m, tip), f"orc mission {m.name} 的状态页：节点、检查、提交和 PR，全部由日志生成。")
    except OrcError as error:
        return f"error {error}", False
    return f"report {url}", False


def render_status(m: Mission, tip: str) -> str:
    """状态页（PLAN 阶段 5）：每个 DAG 节点一行；状态、检查、提交都由 orc 从 events.jsonl 和它自己跑的验证记录算出来，
    每条事实后面标着日志行号，可以回去核对。只有「说明」一节是会话写的，每条带引用，已经由 notes_problems 核对过。"""
    import html as _h
    esc = _h.escape
    events = m.events()
    line = {id(e): i for i, e in enumerate(events, 1)}            # events.jsonl 的行号
    ref = lambda e: f'<span class="ln">日志 {line[id(e)]}</span>' if e is not None else ""
    # 只读一次日志：行号按对象查，所有事件都要来自同一份列表
    job_exits = lambda _m, node, type_: [e for e in events if e.get("kind") == "job-exit" and e.get("node") == node  # noqa: E731
                                     and e.get("type") == type_]
    tasks = approved_tasks(m)
    states = m.node_states()
    state = m.replay()["state"]
    final = next((e for e in reversed(job_exits(m, MISSION_JOBS, "final")) if e.get("tip") == tip), None)
    ci = next((e for e in reversed(job_exits(m, MISSION_JOBS, "ci")) if e.get("tip") == tip), None)
    pr = next((e for e in reversed(events) if e.get("kind") == "pr" and e.get("tip") == tip), None)
    cleanup = next((e for e in reversed(events) if e.get("kind") == "cleanup"), None)
    final_checks_ = (final or {}).get("checks", {})
    rounds = [e for e in job_exits(m, MISSION_JOBS, "final")]

    # 流程条
    flow = ["planning", "verifying", "plan-review", "approved", "executing", "reviewing", "accepted", "cleaned"]
    reached = {e.get("to") for e in events if e.get("kind") == "state"}
    steps = "".join(f'<span class="step {"you" if s == state else "done" if s in reached else ""}">{s}</span>' for s in flow)

    # 组件图：按 DAG 里的 component 分组，按最终检查着色；组件之间的箭头来自节点的 depends_on
    comp_nodes: Dict[str, List[str]] = {}
    for node, t in tasks.items():
        comp_nodes.setdefault(str(t.get("component") or "—"), []).append(node)
    node_ok = {}
    for node in tasks:
        ids = [c["id"] for c in node_checks(m, node)]
        node_ok[node] = None if not ids or any(i not in final_checks_ for i in ids) else all(final_checks_[i] for i in ids)
    comp_cards, comp_edges = [], set()
    for comp, nodes in comp_nodes.items():
        oks = [node_ok[n] for n in nodes]
        cls = "bad" if False in oks else "ok" if all(o is True for o in oks) else "unk"
        label = {"ok": "检查全部通过", "bad": "有检查没通过", "unk": "还没有最终检查结果"}[cls]
        chips = "".join(f'<span class="chip {states.get(n, "pending")}">{esc(n)}</span>' for n in nodes)
        comp_cards.append(f'<div class="comp {cls}"><b>{esc(comp)}</b><div class="muted">{label}</div><div>{chips}</div></div>')
        for n in nodes:
            for d in tasks[n].get("depends_on", []):
                dc = str(tasks.get(d, {}).get("component") or "—")
                if dc != comp:
                    comp_edges.add((dc, comp))
    edges = "".join(f"<li><b>{esc(a)}</b> → <b>{esc(b)}</b></li>" for a, b in sorted(comp_edges))

    # 每个节点一行（不省略）
    rows = []
    for node, t in tasks.items():
        commits = [e for e in events if e.get("kind") == "commit" and e.get("node") == node]
        integ = [e for e in job_exits(m, node, "integrate") if e.get("outcome") == "integrated"]
        reopen = [e for e in events if e.get("kind") == "node-reopen" and e.get("node") == node]
        corrections = [e for e in events if e.get("kind") == "correction" and e.get("node") == node]
        checks = []
        for c in node_checks(m, node):
            ok = final_checks_.get(c["id"])
            cls, mark = ("ok", "✓") if ok else ("bad", "✗") if ok is False else ("unk", "?")
            checks.append(f'<span class="pill {cls}" title="{esc(c["command"])}">{mark} {esc(c["id"])}</span>')
        commit_cells = "<br>".join(f"<code>{e['sha'][:12]}</code> {ref(e)}" for e in commits) or "—"
        integ_cell = f"<code>{integ[-1]['sha'][:12]}</code> {ref(integ[-1])}" if integ else "—"
        rows.append(f"<tr><td><code>{esc(node)}</code><div class='muted'>{esc(str(t.get('component', '')))}</div></td>"
                    f"<td><span class='chip {states.get(node, 'pending')}'>{states.get(node, 'pending')}</span></td>"
                    f"<td>{len(t.get('acceptance', []))}</td><td>{''.join(checks) or '—'}</td><td>{commit_cells}</td>"
                    f"<td>{integ_cell}</td><td>{len(corrections)} 次纠偏" + (f"，最终审查打回 {len(reopen)} 次" if reopen else "")
                    + "</td></tr>")

    # 最终审查、PR、CI
    def round_line(e: dict) -> str:
        verdict = {"passed": "通过", "rework": "打回节点", "unavailable": "没能完成", "unroutable": "落不到节点",
                   "checks-failed": "检查没过，进入修复闭环"}.get(e.get("outcome"), e.get("outcome"))
        issues = "".join(f"<li>节点 <code>{esc(str(i.get('node')))}</code>：{esc(str(i.get('problem', '')))}</li>" for i in e.get("issues", []))
        return f"<li>第 {rounds.index(e) + 1} 轮（<code>{str(e.get('tip', ''))[:12]}</code>）：{verdict} {ref(e)}" + (f"<ul>{issues}</ul>" if issues else "") + "</li>"
    suite = final_checks_.get("run-all")
    ci_rows = "".join(f"<li><code>{esc(n)}</code>：{esc(s)}</li>" for n, s in sorted(((ci or {}).get("checks") or {}).items()))
    notes_exit = next((e for e in reversed(job_exits(m, MISSION_JOBS, "notes")) if e.get("tip") == tip and e.get("outcome") == "valid"), None)
    notes = Path(notes_exit["file"]).read_text(encoding="utf-8") if notes_exit and Path(notes_exit["file"]).is_file() else ""
    request = (m.dir / "request.md").read_text(encoding="utf-8").strip()
    n_checks = len(approved_checks(m)["checks"])
    n_pass = sum(1 for c in approved_checks(m)["checks"] if final_checks_.get(c["id"]))
    commits_total = len([e for e in events if e.get("kind") == "commit"])
    cleaned = ("".join(f"<li><code>{esc(x)}</code></li>" for x in cleanup["removed"]) + f"</ul><p class='muted'>保留：{esc('、'.join(cleanup['kept']))}（PR 合并后可删） {ref(cleanup)}</p>"
               if cleanup else "</ul><p class='muted'>还没清理。</p>")
    return f"""<title>{esc(m.name)} 状态</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
:root{{--bg:#fbfbfa;--fg:#1d1f22;--muted:#5f646b;--line:#dcdfe3;--code:#eef0f2;--accent:#2b5fab;--card:#ffffff;--ok:#1f7a4d;--okbg:#e3f2ea;--bad:#b3261e;--badbg:#fbe4e2;--unk:#8a6d00;--unkbg:#f6eecf}}
@media (prefers-color-scheme:dark){{:root:not([data-theme="light"]){{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;--card:#1d2024;--ok:#6fcf9b;--okbg:#1d3328;--bad:#f2a49c;--badbg:#3a1f1d;--unk:#e6c867;--unkbg:#352d12;color-scheme:dark}}}}
:root[data-theme="dark"]{{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;--card:#1d2024;--ok:#6fcf9b;--okbg:#1d3328;--bad:#f2a49c;--badbg:#3a1f1d;--unk:#e6c867;--unkbg:#352d12;color-scheme:dark}}
body{{background:var(--bg);color:var(--fg);font:16px/1.6 -apple-system,"PingFang SC",system-ui,sans-serif}}
main{{max-width:1000px;margin:0 auto;padding-block:16px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}}
h1{{font-size:1.5em;text-wrap:balance}} h2{{border-top:1px solid var(--line);padding-top:1em;text-wrap:balance}}
a{{color:var(--accent)}} code{{background:var(--code);border-radius:4px;font-family:ui-monospace,Menlo,monospace;font-size:.9em;overflow-wrap:anywhere}}
blockquote{{margin:0;padding-left:12px;border-left:3px solid var(--line);color:var(--muted)}} .muted{{color:var(--muted);font-size:14px}}
table{{border-collapse:collapse;width:100%;font-size:14px}} td,th{{border:1px solid var(--line);padding:6px;vertical-align:top;text-align:left}} .wrap{{overflow-x:auto}}
.flow{{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 12px}} .step{{padding:4px 10px;border-radius:999px;border:1px solid var(--line);font-size:14px;color:var(--muted)}}
.step.done{{background:var(--okbg);color:var(--ok);border-color:transparent}} .step.you{{background:var(--accent);color:var(--bg);border-color:transparent;font-weight:600}}
.stats{{display:flex;flex-wrap:wrap;gap:16px;color:var(--muted)}} .stats b{{color:var(--fg);font-size:1.3em}}
.comps{{display:flex;flex-wrap:wrap;gap:12px}} .comp{{border:2px solid var(--line);border-radius:10px;padding:10px 12px;min-width:200px;background:var(--card)}}
.comp.ok{{border-color:var(--ok)}} .comp.bad{{border-color:var(--bad)}} .comp.unk{{border-color:var(--unk)}}
.chip{{display:inline-block;font:12px ui-monospace,Menlo,monospace;padding:1px 6px;border-radius:999px;margin:4px 4px 0 0;background:var(--code)}}
.chip.integrated{{background:var(--okbg);color:var(--ok)}} .chip.blocked,.chip.rework{{background:var(--badbg);color:var(--bad)}}
.pill{{display:inline-block;font-size:12px;padding:1px 6px;border-radius:999px;margin:0 4px 4px 0}} .pill.ok{{background:var(--okbg);color:var(--ok)}}
.pill.bad{{background:var(--badbg);color:var(--bad)}} .pill.unk{{background:var(--unkbg);color:var(--unk)}} .ln{{font-size:11px;color:var(--muted)}}
</style>
<main>
<h1>mission 状态：{esc(m.name)}</h1>
<p class="muted">除「说明」一节外，页面上的每一项都由 orc 从 <code>events.jsonl</code> 和它自己跑的验证记录生成；「日志 N」是 <code>{esc(str(m.events_path))}</code> 的行号，可以回去核对。</p>
<div class="flow">{steps}</div>
<div class="stats"><span><b>{len(tasks)}</b> 个节点</span><span><b>{n_pass}/{n_checks}</b> 个冻结检查在合并后的代码上通过</span>
<span><b>{commits_total}</b> 次提交</span><span><b>{len(rounds)}</b> 轮最终审查</span></div>
<h2>请求（原话）</h2><blockquote>{esc(request)}</blockquote>
<h2>架构（按组件，颜色是合并后代码上的检查结果）</h2>
<div class="comps">{''.join(comp_cards)}</div>
{f'<p class="muted">组件之间的依赖：</p><ul>{edges}</ul>' if edges else ''}
<h2>节点（DAG 里的每一个）</h2>
<div class="wrap"><table><tr><th>节点</th><th>状态</th><th>验收标准</th><th>冻结检查（合并后）</th><th>提交</th><th>集成</th><th>纠偏</th></tr>
{''.join(rows)}</table></div>
<h2>最终审查</h2>
<p>合并后代码上的检查：{n_pass}/{n_checks} 通过{'；产品仓库自己的 run_all.sh：' + ('通过' if suite else '没通过') if suite is not None else ''}（提交 <code>{tip[:12]}</code>）</p>
<ul>{''.join(round_line(e) for e in rounds) or '<li>还没有</li>'}</ul>
<h2>PR 和 CI</h2>
{f'<p><a href="{esc(pr["url"])}">{esc(pr["url"])}</a> {ref(pr)}</p>' if pr else '<p class="muted">还没有 PR。</p>'}
<ul>{ci_rows or '<li>还没有 CI 结果</li>'}</ul>{ref(ci) if ci else ''}
<p class="muted">合并由你来做。</p>
<h2>清理</h2><ul>{cleaned}
<h2>说明（会话撰写，每条引用已核对）</h2>
{md_to_html(notes) if notes.strip() else '<p class="muted">还没有。</p>'}
</main>
"""


HANDLERS: Dict[str, Handler] = {
    "new": h_new,
    "planning": h_planning,
    "verifying": h_verifying,
    "plan-review": h_plan_review,
    "approved": h_approved,
    "executing": h_executing,
    "reviewing": h_reviewing,
    "accepted": h_accepted,
    "blocked": h_blocked,
    "cleaned": h_cleaned,
    "failed": h_terminal,
}


def step(mission: Mission) -> Next:
    with mission:
        for _ in range(len(MISSION_STATES) + 1):   # 一次 step 可以连过几个不需要等待的状态
            ctx = mission.replay()
            effective = ctx["blocked_from"] if ctx["state"] == "blocked" else ctx["state"]
            try:
                if effective in APPROVED_STATES:
                    waiting = test_fix_step(mission)      # 测试修正等签名：签了才生效，回答意见就撤回
                    if waiting:
                        return waiting
                    problem = verify_approval(mission)
                    if problem:
                        return problem
                nxt, cont = HANDLERS[ctx["state"]](mission)
            except SyncConflict as conflict:              # 节点合并 mission 分支冲突：停下问用户
                return sync_conflict_block(mission, conflict)
            if not cont:
                return nxt or "wait"
        return "error orc step 在一次运行里转了太多次状态。这是 orc 的 bug，把 events.jsonl 给用户看。"


# ---------------------------------------------------------------- 产品层（阶段 6，STATE.md「产品层」）
#
# 产品 = 一份产品设计文档 + phase 文档 + mission 文档 + 若干产品仓库。配置在 $ORC_HOME/products/<产品>/product.toml。
# 决定见 proposals/2026-11-08-phase6-open-points.md：phase 文档里固定格式的依赖表；`执行: 人工` 的 mission 由用户做完后
# orc done；后一个 mission 等前一个的 PR 被用户合并（orc 定时查）；scope / forbid 由信任层从签名的 control 目录读。

PRODUCT_KEYS = ("design", "phases", "missions")
DEP_LINE_RE = re.compile(r"^\s*[-*]\s*([A-Za-z0-9][A-Za-z0-9-]*)\s*[:：]\s*(.*)$")
CLAUSE_LINE_RE = re.compile(r"^\s*[-*]\s*(N[0-9]+)\s*[:：]\s*(.*)$", re.M)
MERGE_POLL_SECONDS = 120          # 等用户合并 PR 时多久查一次


class Product:
    def __init__(self, name: str):
        if not NAME_RE.match(name):
            raise OrcError(f"产品名「{name}」不合法：只能用小写字母、数字和 -。")
        self.name = name
        self.dir = orc_home() / "products" / name
        self.config_path = self.dir / "product.toml"
        self.events_path = self.dir / "events.jsonl"

    def config(self) -> dict:
        if not self.config_path.is_file():
            raise OrcError(f"没有产品「{self.name}」：先运行 orc product init {self.name} --design … --phases … --missions … --repo <名字>=<路径>。")
        data = parse_toml(self.config_path.read_text(encoding="utf-8"))
        prod, repos = data.get("product", {}), data.get("repos", {})
        missing = [k for k in PRODUCT_KEYS if not prod.get(k)]
        if missing or not repos:
            raise OrcError(f"{self.config_path} 缺少 {'、'.join(missing) or '[repos]'}。")
        return {"design": Path(prod["design"]), "phases": Path(prod["phases"]), "missions": Path(prod["missions"]),
                "repos": {k: Path(v) for k, v in repos.items()}}

    def site_dir(self) -> Path:
        return worktrees_root() / "_products" / self.name / "site"

    def events(self) -> List[dict]:
        if not self.events_path.is_file():
            return []
        return [json.loads(l) for l in self.events_path.read_text(encoding="utf-8").splitlines() if l.strip()]

    def append(self, kind: str, **fields) -> dict:
        event = {"ts": now(), "product": self.name, "kind": kind, **fields}
        self.dir.mkdir(parents=True, exist_ok=True)
        with open(self.events_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
            f.flush()
            os.fsync(f.fileno())
        return event

    def missions(self) -> List[Mission]:
        """属于这个产品的 orc mission（目录里有 product 文件）。"""
        root = orc_home() / "missions"
        out = []
        for d in sorted(root.iterdir()) if root.is_dir() else []:
            if (d / "product").is_file() and read1(d / "product") == self.name and (d / "events.jsonl").is_file():
                out.append(Mission(d.name))
        return out


def mission_product(m: Mission) -> Optional[Product]:
    return Product(read1(m.dir / "product")) if (m.dir / "product").is_file() else None


# -- phase 文档

def phase_doc(prod: Product, phase: str) -> Path:
    path = prod.config()["phases"] / f"{phase}.md"
    if not path.is_file():
        raise OrcError(f"找不到 phase 文档 {path}。")
    return path


def mission_file(prod: Product, mid: str) -> Path:
    d = prod.config()["missions"]
    hits = [p for p in sorted(d.glob("*.md")) if p.stem == mid or p.stem.startswith(mid + "-")]
    if len(hits) != 1:
        raise OrcError(f"mission {mid} 在 {d} 里{'找不到文件' if not hits else '对应多个文件：' + '、'.join(h.name for h in hits)}"
                       f"（文件名要是 {mid}.md 或 {mid}-<说明>.md）。")
    return hits[0]


def phase_plan(prod: Product, phase: str) -> Dict[str, dict]:
    """读 phase 文档的依赖表（标题含「依赖」的一节，每行 `- P1-4：依赖 P1-2、P1-3` 或 `- P1-1：无`），再读每个 mission 文件头。
    返回 mission id → {deps, file, repo, manual, text}。格式不对、文件缺失、有环，都报错停下。"""
    text = phase_doc(prod, phase).read_text(encoding="utf-8")
    section = markdown_section(text, "依赖")
    if section is None:
        raise OrcError(f"{phase}.md 没有「依赖」一节。照格式补上：每个 mission 一行，例如 `- P1-1：无`、`- P1-4：依赖 P1-2`。")
    plan: Dict[str, dict] = {}
    for line in section.splitlines():
        hit = DEP_LINE_RE.match(line)
        if not hit:
            continue
        mid, rest = hit.group(1), hit.group(2).strip()
        rest = re.sub(r"^依赖", "", rest).strip()
        deps = [] if rest in ("", "无", "-") else [d for d in re.split(r"[、,，\s]+", rest) if d]
        plan[mid] = {"deps": deps}
    if not plan:
        raise OrcError(f"{phase}.md 的「依赖」一节里没有读到任何 mission。每行写成 `- <mission>：依赖 <mission>、<mission>` 或 `- <mission>：无`。")
    repos = prod.config()["repos"]
    for mid, item in plan.items():
        unknown = [d for d in item["deps"] if d not in plan]
        if unknown:
            raise OrcError(f"{phase}.md：{mid} 依赖的 {'、'.join(unknown)} 不在这个 phase 的依赖表里。")
        path = mission_file(prod, mid)
        body = path.read_text(encoding="utf-8")
        manual = "人工" in mission_field(body, "执行")
        repo = (mission_field(body, "仓库") or [None])[0]
        if not manual and repo not in repos:
            raise OrcError(f"mission 文件 {path.name} 的「仓库:」{'没有写' if not repo else '是 ' + repo + '，不在产品配置的 [repos] 里'}。"
                           f"可以写：{'、'.join(repos)}；orc 做不完的写 `执行: 人工`。")
        item.update(file=path, repo=repo, manual=manual, text=body)
    seen: Dict[str, int] = {}

    def visit(mid: str, stack: Tuple[str, ...]) -> None:
        if mid in stack:
            raise OrcError(f"{phase}.md 的依赖有环：{' → '.join(stack + (mid,))}。")
        if seen.get(mid):
            return
        for d in plan[mid]["deps"]:
            visit(d, stack + (mid,))
        seen[mid] = 1
    for mid in plan:
        visit(mid, ())
    return plan


def scopes_overlap(a: dict, b: dict) -> bool:
    """两个 mission 的 scope（组件 id）有交集；任何一个没写 scope 就当它会改整个仓库。"""
    sa, sb = set(mission_field(a["text"], "scope")), set(mission_field(b["text"], "scope"))
    return not sa or not sb or bool(sa & sb)


def orc_mission_name(prod: Product, mid: str) -> str:
    return f"{prod.name}-{mid.lower()}"[:64]


def phase_mission(prod: Product, mid: str) -> "Mission":
    """phase 里这个编号现在对应的 mission：最近一次 mission-start 记下的那个（用户放弃后重开的，名字带 -2、-3）；
    没有记录时用默认名字。"""
    starts = [e for e in prod.events() if e.get("kind") == "mission-start" and e.get("mission_id") == mid]
    return Mission(starts[-1]["mission"] if starts else orc_mission_name(prod, mid))


def abandoned(m: "Mission") -> bool:
    return any(e.get("kind") == "abandoned" for e in m.events())


def pr_merged(m: Mission) -> Optional[str]:
    """mission 的 PR 合并了没有（gh pr view）：合并了返回合并提交，没有返回 None。"""
    prs = [e for e in m.events() if e.get("kind") == "pr"]
    if not prs:
        return None
    out = gh(m, "pr", "view", prs[-1]["url"], "--json", "state,mergeCommit", "--jq", '.state + " " + (.mergeCommit.oid // "")',
             check=False)
    state, _, sha = out.partition(" ")
    return sha.strip() or "merged" if state == "MERGED" else None


def mission_done(prod: Product, m: Mission) -> bool:
    return any(e.get("kind") == "merged" and e.get("mission") == m.name for e in prod.events())


def update_base(repo: Path) -> None:
    """新 mission 从产品仓库默认分支的最新提交开始：工作区必须干净、在默认分支上，先 fast-forward。"""
    # 只看已跟踪的文件：drafts/、proposals/ 里没提交的草稿不影响 fast-forward，也不会进 mission
    if run_git(repo, "status", "--porcelain", "--untracked-files=no", check=False):
        raise OrcError(f"产品仓库 {repo} 的工作区有没提交的改动，新 mission 不能从这里开始。把这条消息告诉用户。")
    branch = run_git(repo, "symbolic-ref", "--short", "HEAD", check=False)
    has_origin = subprocess.run(["git", "-C", str(repo), "remote", "get-url", "origin"], capture_output=True).returncode == 0
    if not has_origin:
        return
    run_git(repo, "fetch", "--quiet", "origin")
    default = run_git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False).split("/", 1)[-1]
    if not default:
        exists = subprocess.run(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}"],
                                capture_output=True).returncode == 0
        if not exists:
            return                                  # 远端还没有这个分支：没有可以跟上的
        default = branch
    if branch != default:
        raise OrcError(f"产品仓库 {repo} 现在在 {branch or '（分离的 HEAD）'}，不在默认分支 {default} 上。切回 {default} 后再运行。")
    run_git(repo, "merge", "--quiet", "--ff-only", f"origin/{default}")


def phase_status(prod: Product, phase: str) -> Tuple[Dict[str, dict], Dict[str, str]]:
    """每个 mission 的状态：done / manual-todo / blocked-deps / not-started / running / awaiting-merge。"""
    plan = phase_plan(prod, phase)
    manual_done = {e["mission_id"] for e in prod.events() if e.get("kind") == "manual-done" and e.get("phase") == phase}
    status: Dict[str, str] = {}
    for mid, item in plan.items():
        if item["manual"]:
            status[mid] = "done" if mid in manual_done else "manual-todo"
            continue
        m = phase_mission(prod, mid)
        if not m.exists() or abandoned(m):
            status[mid] = "not-started"           # 用户放弃的：用新名字重新开始
        elif mission_done(prod, m):
            status[mid] = "done"
        elif m.replay()["state"] == "cleaned":
            status[mid] = "awaiting-merge"
        else:
            status[mid] = "running"
    for mid, item in plan.items():
        if status[mid] in ("not-started", "manual-todo") and any(status[d] != "done" for d in item["deps"]):
            status[mid] = "blocked-deps"
    return plan, status


def launch_phase_mission(prod: Product, phase: str, mid: str, item: dict) -> Mission:
    repo = prod.config()["repos"][item["repo"]]
    update_base(repo)
    name, n = orc_mission_name(prod, mid), 1
    while Mission(name).exists():             # 放弃过的 mission 留着（分支、worktree 给用户看），新的一次换个名字
        n += 1
        name = f"{orc_mission_name(prod, mid)[:60]}-{n}"
    m = create_mission(item["text"], str(repo), name)
    for name, value in (("product", prod.name), ("phase", phase), ("mission-id", mid)):
        write_atomic(m.dir / name, value + "\n")
    prod.append("mission-start", phase=phase, mission_id=mid, mission=m.name, repo=item["repo"], file=str(item["file"]))
    print(f"phase {phase}：开始 mission {mid}（{m.name}，仓库 {item['repo']}）")
    return m


def phase_step(prod: Product, phase: str) -> str:
    """phase 的一步：记下合并了的 PR → 启动依赖都完成的 mission → 每个进行中的 mission 走一步 → 汇总出一行 next。"""
    plan, status = phase_status(prod, phase)
    # 1. 已经清理、等合并的 mission：查 PR 合并了没有
    for mid, st in status.items():
        if st == "awaiting-merge":
            m = phase_mission(prod, mid)
            sha = pr_merged(m)
            if sha:
                prod.append("merged", phase=phase, mission_id=mid, mission=m.name, sha=sha)
                print(f"phase {phase}：{mid} 的 PR 已合并")
    plan, status = phase_status(prod, phase)
    # 2. 依赖都完成的 mission：启动。没有依赖关系的同时启动，但同一个仓库里 scope 有重叠（或没写 scope）的一次一个：
    #    它们的 PR 都从同一个 main 开始，先合并的那个会让后一个冲突（节点层面「并行的节点文件不重叠」的同一条规则）
    active = [mid for mid, st in status.items() if st in ("running", "awaiting-merge")]
    for mid, st in status.items():
        if st != "not-started":
            continue
        clash = [o for o in active if plan[o]["repo"] == plan[mid]["repo"] and scopes_overlap(plan[o], plan[mid])]
        if clash:
            print(f"phase {phase}：{mid} 和 {'、'.join(clash)} 在同一个仓库里、scope 有重叠，等它们合并后再开始")
            continue
        launch_phase_mission(prod, phase, mid, plan[mid])
        active.append(mid)
    plan, status = phase_status(prod, phase)
    # 3. 每个进行中的 mission 走一步，收集它们的 next
    waits: List[str] = []
    actions: List[str] = []
    for mid, st in status.items():
        if st != "running":
            continue
        m = phase_mission(prod, mid)
        nxt = step(m)
        print(f"phase {phase}：{mid}（{m.name}）：next: {nxt}")
        kind, _, rest = nxt.partition(" ")
        if kind == "report":
            # mission 清理完、PR 等用户合并：report 只出现这一次（之后 mission 等合并，不再走），排在最前面交出去
            actions.insert(0, f"report [{m.name}] {rest}".rstrip())
        elif kind in ("go-gate", "sign", "ask-user", "mediate", "error"):
            actions.append(f"{kind} [{m.name}] {rest}".rstrip())     # 每个 mission 都先走一步，再交出第一个要人处理的
        else:
            waits.append(mid)
    if actions:
        return actions[0]
    plan, status = phase_status(prod, phase)
    publish_summary(prod)
    if all(st == "done" for st in status.values()):
        return phase_conclude(prod, phase, plan)
    if waits or any(st == "running" for st in status.values()):
        return "wait"
    todo = [mid for mid, st in status.items() if st == "manual-todo"]
    merges = [mid for mid, st in status.items() if st == "awaiting-merge"]
    if todo and not merges:
        files = "；".join(f"{mid}（{plan[mid]['file']}）" for mid in todo)
        return (f"ask-user phase {phase} 在等人工 mission：{files}。做完后运行 orc done --product {prod.name} --phase {phase} <mission>。")
    if merges:
        return "wait"                     # 等用户合并 PR；orc wait 定时去查
    return f"error phase {phase} 没有可以推进的 mission（{status}）。这是 orc 的 bug；把产品的 events.jsonl 给用户看。"


def phase_conclude(prod: Product, phase: str, plan: Dict[str, dict]) -> str:
    """phase 里的 mission 都完成后：对照 phase 文档的「完成标准」出结论（review 模型，只读材料），写进汇总页。"""
    done = [e for e in prod.events() if e.get("kind") == "phase-conclusion" and e.get("phase") == phase]
    if not done:
        doc = phase_doc(prod, phase).read_text(encoding="utf-8")
        criteria = markdown_section(doc, "完成标准") or "（phase 文档没有「完成标准」一节）"
        lines = []
        for mid, item in plan.items():
            if item["manual"]:
                lines.append(f"- {mid}：人工 mission，用户已确认做完")
                continue
            m = phase_mission(prod, mid)
            receipts = json.loads((m.dir / "publish.json").read_text()) if (m.dir / "publish.json").is_file() else {}
            final = next((e for e in reversed(job_exits(m, MISSION_JOBS, "final")) if e.get("outcome") == "passed"), {})
            ci = next((e for e in reversed(job_exits(m, MISSION_JOBS, "ci")) if e.get("outcome") == "passed"), {})
            lines.append(f"- {mid}（{m.name}）：最终审查通过；CI {ci.get('checks', {})}；状态页 {receipts.get('status', {}).get('url', '—')}\n"
                         f"  请求：{item['text'].strip()[:600]}")
        prompt = (f"你在给产品 {prod.name} 的 phase {phase} 写结论。下面是 phase 文档的「完成标准」和每个 mission 的结果。\n\n"
                  f"## 完成标准（原文）\n\n{criteria}\n\n## mission 结果\n\n" + "\n".join(lines) +
                  "\n\n逐条判断完成标准：orc 的记录能证明的写 met；能证明没达到的写 not-met；需要人亲手验收的（真浏览器、真设备、"
                  "部署后的站点、真实模型的效果）写 needs-human，并写清楚人要做什么。不要猜。\n\n"
                  '最后只输出一个 JSON 对象：{"items": [{"criterion": "原文", "status": "met|not-met|needs-human", '
                  '"evidence": "依据，或人要做的验收步骤"}]}')
        cfg = resolve_models()["roles"]["review"]
        import tempfile
        cwd = tempfile.mkdtemp(prefix="orc-phase.")
        try:
            run = subprocess.run(["claude", "-p", "--model", cfg["model"], "--effort", cfg["effort"], "--output-format", "json",
                                  "--tools", ""], input=prompt, cwd=cwd, capture_output=True, text=True, timeout=REVIEW_TIMEOUT,
                                 env=dict(os.environ, ORC_ROLE="phase-conclusion"))
            path = Path(cwd) / "out.json"
            write_atomic(path, run.stdout)
            text, error = claude_result(path)
        except subprocess.TimeoutExpired:
            text, error = None, "超时"
        finally:
            shutil.rmtree(cwd, ignore_errors=True)
        obj = last_json_object(text) if text else None
        items = obj.get("items") if isinstance(obj, dict) else None
        if error or not isinstance(items, list) or not all(isinstance(i, dict) and i.get("status") in ("met", "not-met", "needs-human")
                                                          for i in items):
            return f"error phase {phase} 的结论没能生成（{error or '格式不对'}）。稍后重新运行 orc phase；持续失败就告诉用户。"
        prod.append("phase-conclusion", phase=phase, items=items)
    url = publish_summary(prod)
    return f"report {url}"


def publish_summary(prod: Product) -> str:
    return publish_page(prod.name, prod.site_dir(), prod.dir / "publish.json", "summary", render_summary(prod),
                        f"orc 产品 {prod.name} 的汇总页：画布、NORTHSTAR 条款、phase 和 mission，全部由事件记录生成。",
                        resolve_models()["roles"]["plan"]["model"])[0]


# -- 画布

def canvas_problems(data, tracked: List[str]) -> List[str]:
    if not isinstance(data, dict) or not isinstance(data.get("components"), list) or not data["components"]:
        return ["画布的根必须是对象，components 是非空列表"]
    problems, ids = [], set()
    for c in data["components"]:
        if not isinstance(c, dict):
            problems.append("components 里每一项都要是对象")
            continue
        cid = c.get("id")
        if not isinstance(cid, str) or not CHECK_ID_RE.match(cid) or cid in ids:
            problems.append(f"组件 id「{cid}」不合法或重复（小写字母、数字和 -）")
        ids.add(cid)
        if not isinstance(c.get("name"), str) or not c["name"].strip():
            problems.append(f"组件 {cid} 缺少 name")
        if not isinstance(c.get("paths"), list) or not c["paths"] or not all(isinstance(p, str) and p for p in c["paths"]):
            problems.append(f"组件 {cid} 的 paths 必须是非空的 glob 列表")
    for c in data["components"]:
        bad = [d for d in c.get("depends_on", []) if d not in ids] if isinstance(c, dict) else []
        if bad:
            problems.append(f"组件 {c.get('id')} 依赖了不存在的组件：{'、'.join(map(str, bad))}")
    globs = [p for c in data["components"] if isinstance(c, dict) for p in c.get("paths", []) if isinstance(p, str)]
    skip = (".northstar/", ".github/", "drafts/", "proposals/", "status/")
    unmapped = [f for f in tracked if not f.startswith(skip) and not glob_hit(f, globs)]
    if unmapped:
        problems.append(f"这些已有文件不属于任何组件（{len(unmapped)} 个，前 10 个）：{'、'.join(unmapped[:10])}")
    return problems


def render_canvas(prod: Product, repo_id: str, data: dict) -> str:
    import html as _h
    esc = _h.escape
    cards = "".join(
        f'<div class="card"><b>{esc(c["name"])}</b> <code>{esc(c["id"])}</code>'
        f'<div class="paths">{"".join(f"<code>{esc(p)}</code>" for p in c["paths"])}</div>'
        + (f'<div class="dep">依赖：{esc("、".join(c.get("depends_on", [])))}</div>' if c.get("depends_on") else "")
        + "</div>" for c in data["components"])
    edges = "".join(f"<li><code>{esc(c['id'])}</code> → <code>{esc(d)}</code></li>"
                    for c in data["components"] for d in c.get("depends_on", []))
    return f"""<title>{esc(prod.name)} 画布</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
:root{{--bg:#fbfbfa;--fg:#1d1f22;--muted:#5f646b;--line:#dcdfe3;--code:#eef0f2;--accent:#2b5fab;--card:#fff}}
@media (prefers-color-scheme:dark){{:root:not([data-theme="light"]){{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;--card:#1d2024;color-scheme:dark}}}}
:root[data-theme="dark"]{{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;--card:#1d2024;color-scheme:dark}}
body{{background:var(--bg);color:var(--fg);font:16px/1.6 -apple-system,"PingFang SC",system-ui,sans-serif}}
main{{max-width:1000px;margin:0 auto;padding-block:16px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}}
code{{background:var(--code);border-radius:4px;font-family:ui-monospace,Menlo,monospace;font-size:.85em;overflow-wrap:anywhere}}
.cards{{display:flex;flex-wrap:wrap;gap:12px}} .card{{border:2px solid var(--accent);border-radius:10px;padding:10px 12px;min-width:220px;max-width:320px;background:var(--card)}}
.paths{{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}} .dep,.muted{{color:var(--muted);font-size:14px}}
</style>
<main>
<h1>画布草稿：{esc(prod.name)} / {esc(repo_id)}</h1>
<p class="muted">orc 根据产品设计文档起草，写在产品仓库的 <code>drafts/architecture.json</code>。看过没问题，在产品仓库运行 <code>northstar seal</code>
把它签进 <code>.northstar/architecture.json</code>；签名后 agent 改不了，规划时节点的组件只能从这里选。</p>
<div class="cards">{cards}</div>
{f'<h2>组件之间的依赖</h2><ul>{edges}</ul>' if edges else ''}
</main>
"""


def cmd_canvas(args) -> int:
    """从产品设计文档起草一个产品仓库的画布（组件、连线、每个组件的目录），写进 drafts/，发布成页面给用户看。"""
    prod = Product(args.product)
    cfg = prod.config()
    if args.repo not in cfg["repos"]:
        raise OrcError(f"产品 {prod.name} 没有仓库 {args.repo}：可选 {'、'.join(cfg['repos'])}。")
    repo = cfg["repos"][args.repo]
    tracked = run_git(repo, "ls-files").splitlines()
    tops = sorted({f.split("/", 1)[0] + ("/" if "/" in f else "") for f in tracked})
    prompt = (f"根据下面的产品设计文档，为产品仓库 `{args.repo}` 起草画布：有哪些组件、组件之间的依赖、每个组件对应仓库里的哪些路径（glob）。\n\n"
              f"## 产品设计文档\n\n{cfg['design'].read_text(encoding='utf-8')}\n\n"
              f"## 仓库现有的文件（{len(tracked)} 个，顶层：{'、'.join(tops)}）\n\n" + "\n".join(tracked[:400]) +
              ("\n…（只列前 400 个）" if len(tracked) > 400 else "") +
              "\n\n规则：组件按设计文档里的模块划分，不要按文件类型；id 用小写字母、数字和 -；每个组件的 paths 是 glob（* 能跨目录）；"
              "现有文件（.northstar/、.github/、drafts/、proposals/、status/ 以外）每个都要落在某个组件里；测试可以单独一个组件。\n\n"
              '最后只输出一个 JSON 对象：{"components": [{"id": "…", "name": "中文名", "paths": ["dir/*"], "depends_on": ["其他组件 id"]}]}')
    model = resolve_models()["roles"]["plan"]
    feedback = ""
    import tempfile
    for attempt in range(1, MAX_REPAIRS + 2):
        cwd = tempfile.mkdtemp(prefix="orc-canvas.")
        try:
            run = subprocess.run(["claude", "-p", "--model", model["model"], "--effort", model["effort"], "--output-format", "json",
                                  "--tools", ""], input=prompt + feedback, cwd=cwd, capture_output=True, text=True,
                                 timeout=REVIEW_TIMEOUT, env=dict(os.environ, ORC_ROLE="canvas"))
            write_atomic(Path(cwd) / "out.json", run.stdout)
            text, error = claude_result(Path(cwd) / "out.json")
        finally:
            shutil.rmtree(cwd, ignore_errors=True)
        data = last_json_object(text) if text else None
        problems = [error] if error else canvas_problems(data, tracked)
        if not problems:
            break
        feedback = "\n\n上一次的画布没通过校验，修正后重新输出：\n" + "\n".join(f"- {p}" for p in problems)
    else:
        raise OrcError("画布草稿连续 3 次没通过校验：\n" + "\n".join(f"- {p}" for p in problems))
    draft = repo / "drafts" / "architecture.json"
    draft.parent.mkdir(exist_ok=True)
    write_atomic(draft, json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    url, _ = publish_page(prod.name, prod.site_dir(), prod.dir / "publish.json", f"canvas-{args.repo}",
                          render_canvas(prod, args.repo, data), f"orc 产品 {prod.name} 仓库 {args.repo} 的画布草稿。",
                          model["model"])
    prod.append("canvas-draft", repo=args.repo, file=str(draft), url=url)
    print(f"画布草稿已写进 {draft}，页面：{url}")
    print(f"请用户看过页面后在 {repo} 运行 northstar seal，把它签进 .northstar/architecture.json（然后提交并合并）。")
    print(f"next: canvas {url}")
    return 0


# -- 汇总页

def northstar_clauses(text: str) -> List[Tuple[str, str]]:
    return [(n, t.strip()) for n, t in CLAUSE_LINE_RE.findall(text)]


def render_summary(prod: Product) -> str:
    """全产品一个汇总页（PLAN 阶段 6）：画布着色图、NORTHSTAR 条款表、phase 和 mission 列表。颜色和状态只来自事件记录。"""
    import html as _h
    esc = _h.escape
    cfg = prod.config()
    pevents = prod.events()
    missions = prod.missions()
    info = []
    for m in missions:
        evs = m.events()
        state = m.replay()["state"]
        done = mission_done(prod, m)
        tasks = approved_tasks(m) if m.frozen() else {}
        receipts = json.loads((m.dir / "publish.json").read_text()) if (m.dir / "publish.json").is_file() else {}
        cross = next((e for e in reversed(evs) if e.get("kind") == "job-exit" and e.get("type") == "cross"), None)
        pr = next((e for e in reversed(evs) if e.get("kind") == "pr"), None)
        info.append({"m": m, "evs": evs, "state": state, "done": done, "tasks": tasks, "receipts": receipts, "cross": cross,
                     "pr": pr, "mid": read1(m.dir / "mission-id"), "phase": read1(m.dir / "phase"),
                     "repo": next((k for k, v in cfg["repos"].items() if os.path.realpath(v) == os.path.realpath(m.repo())), "?")})
    ref = lambda x, e: f'<span class="ln">{esc(x["m"].name)} 日志 {x["evs"].index(e) + 1}</span>'
    # 1. 画布着色图：每个仓库一张，组件颜色来自 mission 提交过的文件
    canvases = []
    for repo_id, repo in cfg["repos"].items():
        comps = canvas_components(repo)
        if comps is None:
            canvases.append(f"<h3>{esc(repo_id)}</h3><p class='muted'>还没有签名的画布（运行 orc canvas --product {esc(prod.name)} --repo {esc(repo_id)} 起草）。</p>")
            continue
        cards = []
        for cid, c in comps.items():
            touches = []
            for x in info:
                if x["repo"] != repo_id:
                    continue
                commits = [e for e in x["evs"] if e.get("kind") == "commit" and any(glob_hit(f, c.get("paths", [])) for f in e.get("files", []))]
                if commits:
                    touches.append((x, commits))
            cls = ("done" if touches and all(x["done"] for x, _ in touches) else "doing" if touches else "none")
            detail = "".join(
                f"<li><b>{esc(x['mid'] or x['m'].name)}</b>（{'已合并' if x['done'] else x['state']}）："
                + "、".join(f"<code>{e['sha'][:10]}</code> 节点 {esc(e.get('node', ''))} {ref(x, e)}" for e in commits) + "</li>"
                for x, commits in touches)
            cards.append(f'<details class="comp {cls}"><summary><b>{esc(c.get("name", cid))}</b> <code>{esc(cid)}</code>'
                         f'<span class="muted">{len(touches)} 个 mission</span></summary><ul>{detail or "<li>还没有 mission 改过</li>"}</ul></details>')
        canvases.append(f"<h3>{esc(repo_id)}</h3><div class='comps'>{''.join(cards)}</div>")
    # 2. NORTHSTAR 条款表
    clauses: Dict[str, str] = {}
    for repo in cfg["repos"].values():
        ns = repo / ".northstar" / "NORTHSTAR.md"
        if ns.is_file():
            for n, t in northstar_clauses(ns.read_text(encoding="utf-8")):
                clauses.setdefault(n, t)
    rows = []
    for n, t in sorted(clauses.items(), key=lambda kv: int(kv[0][1:])):
        impl, drifts = [], 0
        for x in info:
            for node, task in x["tasks"].items():
                if n not in task.get("clauses", []):
                    continue
                commits = [e for e in x["evs"] if e.get("kind") == "commit" and e.get("node") == node]
                drifts += sum(1 for e in x["evs"] if e.get("kind") == "review" and e.get("node") == node and e.get("verdict") == "DRIFT")
                impl.append(f"{esc(x['mid'] or x['m'].name)} / {esc(node)}（{'已合并' if x['done'] else x['state']}）"
                            + "".join(f" <code>{e['sha'][:10]}</code> {ref(x, e)}" for e in commits))
        status = ("没有任何 mission 实现" if not impl else "已合并" if all("已合并" in i for i in impl) else "进行中")
        rows.append(f"<tr class='{'gap' if not impl else ''}'><td><b>{esc(n)}</b></td><td>{esc(t)}</td>"
                    f"<td>{'<br>'.join(impl) or '—'}</td><td>{drifts}</td><td>{status}</td></tr>")
    # 3. phase 和 mission
    phases = []
    phase_dir = cfg["phases"]
    for doc in sorted(phase_dir.glob("*.md")) if phase_dir.is_dir() else []:
        ph = doc.stem
        try:
            plan, status = phase_status(prod, ph)
        except OrcError as error:
            phases.append(f"<h3>{esc(ph)}</h3><p class='muted'>读不出依赖表：{esc(str(error))}</p>")
            continue
        items = []
        for mid, st in status.items():
            x = next((x for x in info if x["mid"] == mid and x["phase"] == ph), None)
            link = x["receipts"].get("status", {}).get("url") if x else None
            cross = (x["cross"] or {}).get("outcome") if x else None
            labels = {"done": "完成", "manual-todo": "人工待办", "blocked-deps": "等依赖", "not-started": "未开始",
                      "running": "进行中", "awaiting-merge": "等你合并"}
            where = "人工" if plan[mid]["manual"] else esc(plan[mid]["repo"] or "")
            page = '<a href="' + esc(link) + '">状态页</a>' if link else "—"
            verdict = esc({"passed": "通过", "rework": "冲突，已退回"}.get(cross, cross or "—"))
            prlink = '<a href="' + esc(x["pr"]["url"]) + '">PR</a>' if x and x["pr"] else "—"
            items.append(f"<tr><td><code>{esc(mid)}</code></td><td>{labels.get(st, st)}</td><td>{where}</td>"
                         f"<td>{page}</td><td>{verdict}</td><td>{prlink}</td></tr>")
        concl = next((e for e in reversed(pevents) if e.get("kind") == "phase-conclusion" and e.get("phase") == ph), None)
        concl_html = ""
        if concl:
            label = {"met": "达到", "not-met": "没达到", "needs-human": "要你亲手验收"}
            concl_html = "<ul>" + "".join(f"<li><b>{label[i['status']]}</b>：{esc(i.get('criterion', ''))}<div class='muted'>{esc(i.get('evidence', ''))}</div></li>"
                                          for i in concl["items"]) + "</ul>"
        done_n = sum(1 for st in status.values() if st == "done")
        phases.append(f"<h3>{esc(ph)}（{done_n}/{len(status)} 完成）</h3><div class='wrap'><table><tr><th>mission</th><th>状态</th><th>仓库</th>"
                      f"<th>状态页</th><th>跨 mission 评审</th><th>PR</th></tr>{''.join(items)}</table></div>"
                      + (f"<h4>结论（对照完成标准）</h4>{concl_html}" if concl_html else ""))
    return f"""<title>{esc(prod.name)} 汇总</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
:root{{--bg:#fbfbfa;--fg:#1d1f22;--muted:#5f646b;--line:#dcdfe3;--code:#eef0f2;--accent:#2b5fab;--card:#fff;--ok:#1f7a4d;--okbg:#e3f2ea;--doing:#8a6d00;--doingbg:#f6eecf;--gap:#b3261e;--gapbg:#fbe4e2}}
@media (prefers-color-scheme:dark){{:root:not([data-theme="light"]){{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;--card:#1d2024;--ok:#6fcf9b;--okbg:#1d3328;--doing:#e6c867;--doingbg:#352d12;--gap:#f2a49c;--gapbg:#3a1f1d;color-scheme:dark}}}}
:root[data-theme="dark"]{{--bg:#16181b;--fg:#e8eaed;--muted:#a0a6ad;--line:#33373c;--code:#22262a;--accent:#8db4ef;--card:#1d2024;--ok:#6fcf9b;--okbg:#1d3328;--doing:#e6c867;--doingbg:#352d12;--gap:#f2a49c;--gapbg:#3a1f1d;color-scheme:dark}}
body{{background:var(--bg);color:var(--fg);font:16px/1.6 -apple-system,"PingFang SC",system-ui,sans-serif}}
