{
  "name": "orchestrator",
  "version": "0.3.2",
  "description": "Hybrid mission-control orchestration for Claude Code — the coordinator records the ask and provisions guarded worktrees; Fable-5 brainstorms, plans, pauses for your go, and independently reviews; Codex gpt-5.6-sol executes, verifies, and performs every rework change. All state lives on disk in a .orchestrator/ hub so any fresh session can resume.",
  "repository": "https://github.com/DaoBrewAI/building-in-public",
  "license": "MIT",
  "keywords": [
    "orchestrator",
    "multi-session",
    "worker-sessions",
    "worktrees",
    "mission-control",
    "mediation",
    "daobrew"
  ],
  "skills": [
    "./claude-skills/"
  ],
  "commands": [
    "./commands/"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/self-update.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.sh"
          }
        ]
      }
    ]
  },
  "author": {
    "name": "DaoBrew AI",
    "url": "https://github.com/DaoBrewAI"
  }
}
