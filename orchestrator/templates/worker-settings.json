{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ORC_WORKTREES='{{WORKTREES}}' ORC_MISSION_DIR='{{MISSION_DIR}}' '{{GUARD_SCRIPT}}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ORC_WORKTREES='{{WORKTREES}}' ORC_MISSION_DIR='{{MISSION_DIR}}' '{{GATE_SCRIPT}}'"
          }
        ]
      }
    ]
  }
}
