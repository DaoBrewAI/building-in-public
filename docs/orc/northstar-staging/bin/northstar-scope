#!/usr/bin/env python3
# /opt/northstar/bin/northstar-scope <文件...>
# 返回 0：全部在范围内；1：越界；3：触发停止条件
import fnmatch, json, os, re, sys
root = os.popen("git rev-parse --show-toplevel").read().strip() or os.getcwd(); os.chdir(root)
NS = ".northstar"
ctl = os.environ.get("ORC_MISSION_CONTROL")
if ctl:
    # orc 的执行会话（orc 启动时设好，会话里的 agent 改不了自己进程的环境变量）：scope 和 forbid 来自
    # 用户签过名的冻结文件 brief-exec.md（northstar approve-mission）。先验签名、再验哈希，任何一项不对就停下。
    # 每个 mission 各读各的 control 目录，同一个仓库里可以并行（proposals/2026-11-08-phase6-open-points.md 第 4 条）
    import hashlib, subprocess
    m = os.path.basename(os.path.dirname(os.path.realpath(ctl)))
    signed = subprocess.run(["/opt/northstar/bin/northstar", "verify-mission", ctl], capture_output=True).returncode == 0
    try:
        want = [l.split()[0] for l in open(os.path.join(ctl, "approved.sha256")).read().splitlines()
                if l.split() and l.split()[-1] == "brief-exec.md"]
        data = open(os.path.join(ctl, "brief-exec.md"), "rb").read()
        hashed = len(want) == 1 and hashlib.sha256(data).hexdigest() == want[0]
    except OSError:
        hashed = False
    if not (signed and hashed):
        print(f"orc mission「{m}」的冻结文件签名或哈希校验失败（{ctl}），不知道这个 mission 的范围", file=sys.stderr); sys.exit(3)
    text = data.decode("utf-8")
else:
    try:
        m = open(f"{NS}/missions/ACTIVE").read().strip()
    except FileNotFoundError:
        sys.exit(0)                               # 没有进行中的 mission，不设围栏
    text = open(f"{NS}/missions/{m}.md").read()
def field(k):
    h = re.search(rf"^{k}:[ \t]*(.*)$", text, re.M)   # 不能用 \s*：值为空时会吞掉下一行
    return [s.strip() for s in h.group(1).split("#")[0].split(",") if s.strip()] if h else []
files = [os.path.relpath(os.path.abspath(p), root) for p in sys.argv[1:] if p]
stop = [f for f in files if any(fnmatch.fnmatch(f, g) for g in field("forbid"))]
if stop:
    print(f"触发停止条件：{', '.join(stop)}", file=sys.stderr); sys.exit(3)
ids = field("scope")
if not ids or not os.path.exists(f"{NS}/architecture.json"): sys.exit(0)
arch = json.load(open(f"{NS}/architecture.json"))
globs = [p for c in arch["components"] if c["id"] in ids for p in c["paths"]]
globs += ["status/narrative.md", "proposals/*", "drafts/*"]
bad = [f for f in files if not any(fnmatch.fnmatch(f, g) for g in globs)]
if bad:
    print(f"越界：{', '.join(bad)}。当前 mission「{m}」只允许改：{', '.join(ids)}", file=sys.stderr); sys.exit(1)
